#!/bin/sh
# Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# Generated by `gash __compat generate` from go-impl/compat/gash.tmpl: do
# not edit.
#
# Launcher for direct use (`~/.gash/bin/gash llm_tree`, or a link to it in
# ~/.local/bin): execs the gash binary of this checkout's VERSION, the same
# one the shell functions use (GASH_BIN when set and executable). A missing
# binary is fetched by lib/compat/bootstrap.sh.

self=$0
while [ -L "$self" ]; do
    target=$(readlink "$self") || break
    case $target in
        /*) self=$target ;;
        *) self=${self%/*}/$target ;;
    esac
done
case $self in
    */*) dir=${self%/*} ;;
    *) dir=. ;;
esac
root=$(cd "$dir/.." && pwd -P) || exit 1

if [ -n "${GASH_BIN-}" ] && [ -x "$GASH_BIN" ] && [ ! -d "$GASH_BIN" ]; then
    exec "$GASH_BIN" "$@"
fi
version=""
if [ -r "$root/VERSION" ]; then
    IFS= read -r version <"$root/VERSION" || true
fi
bin="${XDG_DATA_HOME:-$HOME/.local/share}/gash/versions/$version/gash"
if [ -n "$version" ] && [ -x "$bin" ] && [ ! -d "$bin" ]; then
    exec "$bin" "$@"
fi

# Not installed: the bootstrap fetches it, or reports why it cannot.
exec bash -c '
. "$0/lib/compat/bootstrap.sh" || exit 1
if __gash_compat_ready; then
    exec "$__GASH_BIN" "$@"
fi
__gash_missing "${1-gash}"
exit 1
' "$root" "$@"
