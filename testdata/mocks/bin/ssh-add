#!/usr/bin/env bash

# Minimal ssh-add mock.
# - `ssh-add -l`:
#   - if MOCK_SSH_AGENT=0 -> simulate no agent
#   - else -> simulate agent present, empty or holding MOCK_SSH_LOADED
# - `ssh-add [--] KEY` (Gash 3.0 types the passphrase on a terminal where
#   2.x ran expect, LEDGER SYS-37):
#   - no agent (as for -l) -> the connection error, exit 2
#   - else -> the lines the expect mock printed for a first key: "The
#     agent has no identities." while MOCK_SSH_LOADED is empty, then
#     "Enter passphrase for KEY: ", one line read without echo, and
#     "Identity added: KEY (user@example.com)". MOCK_EXPECT_STDIN, when
#     set, gets KEY and the passphrase appended as the expect mock got
#     them (one base64 line each).
# - any other args -> succeed silently

if [[ "${1:-}" == "-l" ]]; then
	agent_present=1

	# If MOCK_SSH_AGENT is set, it forces the simulated state.
	# Otherwise, infer from SSH_AUTH_SOCK (closer to real ssh-add behavior).
	if [[ -n "${MOCK_SSH_AGENT+x}" ]]; then
		if [[ "${MOCK_SSH_AGENT}" == "0" ]]; then
			agent_present=0
		fi
	else
		if [[ -z "${SSH_AUTH_SOCK-}" ]]; then
			agent_present=0
		fi
	fi

	if [[ "$agent_present" == "0" ]]; then
		echo "Could not open a connection to your authentication agent." >&2
		exit 2
	fi

	# MOCK_SSH_LOADED: space-separated fingerprints already in the agent.
	if [[ -n "${MOCK_SSH_LOADED-}" ]]; then
		for fp in $MOCK_SSH_LOADED; do
			echo "256 $fp loaded (ED25519)"
		done
		exit 0
	fi

	echo "The agent has no identities."
	exit 1
fi

key=""
if [[ "${1:-}" == "--" && $# -eq 2 ]]; then
	key="$2"
elif [[ $# -eq 1 && "${1:-}" != -* ]]; then
	key="$1"
fi
if [[ -n "$key" ]]; then
	if [[ "${MOCK_SSH_AGENT-}" == "0" || (-z "${MOCK_SSH_AGENT+x}" && -z "${SSH_AUTH_SOCK-}") ]]; then
		echo "Could not open a connection to your authentication agent." >&2
		exit 2
	fi
	[[ -n "${MOCK_SSH_LOADED-}" ]] || echo "The agent has no identities."
	stty -echo 2>/dev/null
	printf 'Enter passphrase for %s: ' "$key"
	pass=""
	IFS= read -r pass || true
	printf '\n'
	if [[ -n "${MOCK_EXPECT_STDIN-}" ]]; then
		{
			printf '%s' "$key" | base64 | tr -d '\n'
			printf '\n'
			printf '%s' "$pass" | base64 | tr -d '\n'
			printf '\n'
		} >>"$MOCK_EXPECT_STDIN"
	fi
	echo "Identity added: $key (user@example.com)"
	exit 0
fi

exit 0
