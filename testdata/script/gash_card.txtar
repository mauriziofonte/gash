# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: gash_card_spec.sh:8
# covers: gash_card_spec.sh:20
# covers: gash_card_spec.sh:28
# covers: gash_card_spec.sh:42
# covers: gash_card_spec.sh:54
#
# The pages of 3.5 (they replace the 2.x reference card), through the shim
# as 2.x drove the card. :8/:20/:28 are split rows whose internal probe (the
# help registry) is a Go unit; here the observable pages are asserted:
# `gash all` lists the commands of every namespace with no internal
# (__gash_) leak, the overview names every namespace, a namespace page shows
# its commands, their shortcuts and the shortcuts of its packs, identity
# aliases (ls->ls) dropped. :42 is the old topic words, the unknown-command
# error and --help; :54 is the plain piped output and rows that fit COLUMNS.

env GASH_HEADLESS=1 LC_ALL=C COLUMNS=200
exec bash card.sh

-- card.sh --
export GASH_HEADLESS=1 LC_ALL=C COLUMNS=200
source "$GASH_SH"
set -uo pipefail
fail() { echo "FAIL: $1" >&2; exit 1; }

# :8 every namespace contributes commands to `gash all`; nothing internal leaks.
all="$(gash all --no-color)"
for cmd in "largest" "stats" "read" "git-status" "query" "sync" "tag add" "stop-all" "detect php" "doctor"; do
  grep -qE "^  $cmd( |\$)" <<<"$all" || fail "8 missing $cmd"
done
[[ "$all" != *"__gash_"* ]] || fail "8 internal leak"

# :20 the overview names every namespace, by group.
ov="$(gash --no-color)"
for ns in files system shell git docker remote db runtime ai hte wsl win logs llm agent run; do
  grep -qE "^    $ns +[A-Z]" <<<"$ov" || fail "20 missing $ns"
done
for g in EVERYDAY PLATFORM "FOR AI AGENTS" GASH; do
  grep -q "^  $g\$" <<<"$ov" || fail "20 group $g"
done

# :28 a namespace shows its commands, their shortcuts, and its pack shortcuts.
git="$(gash git)"
grep -qE "^  tag add +TAG_NAME .* gat +Create an annotated tag" <<<"$git" || fail "28 tag add"
grep -q "SHORTCUTS" <<<"$git"                                     || fail "28 SHORTCUTS"
grep -qE "(^|  )gst +git status( |\$)" <<<"$git"                  || fail "28 gst expansion"
grep -qE "^  log all +gla" <<<"$git"                              || fail "28 log all"
# An identity alias (ls -> ls) is left out of a page.
if grep -qE "(^|  )ls +ls( |\$)" <<<"$(gash shell)"; then fail "28 identity ls present"; fi

# :42 old topic words, the unknown-command refusal, and --help.
[[ "$(gash navigation)" == *"gash shell"* ]]       || fail "42 navigation"
[[ "$(gash nav)" == *"gash shell"* ]]              || fail "42 nav"
[[ "$(gash management)" == *"doctor"* ]]          || fail "42 management"
[[ "$(gash php)" == *"detect php"* ]]              || fail "42 php"
if gash bogus >/dev/null 2>&1; then fail "42 bogus returned 0"; fi
[[ "$(gash bogus 2>&1)" == *'"error":"unknown_command"'* ]] || fail "42 unknown_command"
[[ "$(gash git tagg add 2>&1)" == *"Did you mean gash git tag add"* ]] || fail "42 suggestion"
[[ "$(gash --help)" == *"FOR AI AGENTS"* ]]        || fail "42 --help"

# :54 piped output is plain and rows fit the terminal.
if [[ "$(gash all)" == *$'\033'* ]]; then fail "54 escape bytes when piped"; fi
over=$(COLUMNS=100 gash all | awk 'length($0) > 100' | wc -l)
[[ "$over" -eq 0 ]] || fail "54 rows exceed COLUMNS"
