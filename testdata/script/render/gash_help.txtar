# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:55
# covers: output_style_render_spec.sh:56
# covers: output_style_render_spec.sh:57
# covers: output_style_render_spec.sh:58
# covers: output_style_render_spec.sh:59
# covers: output_style_render_spec.sh:60
# covers: output_style_render_spec.sh:61
# covers: output_style_render_spec.sh:62
# covers: output_style_render_spec.sh:63
# covers: output_style_render_spec.sh:64
#
# gash_help rendering (R2-R6), the 3.5 pages: overview, --list, --search
# (hit and miss), --search usage error, a command page (palette-colored
# name/headers), a shortcut lookup, self help (-h), --short, and not-found. The colored
# function page drops every ESC in plain mode (R6).

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :55 overview
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_help'
stdout 'Gash [0-9][0-9A-Za-z.-]*.* Bash for humans and AI agents'
stdout 'EVERYDAY'
stdout '^    files +Largest files'

# --- :56 list
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_help --list'
stdout '^  gash git '
stdout '^    sync +gsync '

# --- :57 search - keyword hits
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_help --search docker'
stdout 'Search results for .docker.:'
stdout '^  gash docker compose check +dcc '

# --- :58 search-none - no hits
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_help --search zzzqqq'
stdout 'No results for .zzzqqq.\.'

# --- :59 search-usage - missing keyword
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_help --search'
stderr 'Usage: gash help --search WORD'

# --- :60 function - the colored help page
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_help files_largest'
stdout 'gash files largest'
stdout 'List the largest files under a path'
stdout 'USAGE'
stdout 'EXAMPLES'
stdout 'SHORTCUT'
stdout 'FORMER NAME'

# --- :61 shortcut - resolves the shortcut then shows the page
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_help flf'
stdout 'gash files largest'
stdout 'List the largest files under a path'

# --- :62 self - gash_help -h quick usage
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_help -h'
stdout 'gash help'
stdout 'The overview: namespaces'
stdout '--search WORD'

# --- :63 short - one-line description, then an unknown name
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_help --short git_sync; gash_help --short nosuch'
stdout '^Stage everything, commit and push the current branch$'
stderr 'Error: No help found for .nosuch.\.'

# --- :64 not-found
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_help nosuch'
stderr 'Error: No help found for .nosuch.\.'
stderr 'Hint: Run: gash \(namespaces\) or gash help --search WORD'

# --- R6: the function page is plain with color off, no ESC
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; gash_help files_largest'
stdout 'List the largest files under a path'
! stdout '\x1b'
