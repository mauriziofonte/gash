# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:73
#
# gash_unload with no saved snapshot: it is a shell-side function, so the
# error ("Gash snapshot not found") is printed on stderr with no ESC.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :73 no-snapshot
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_unload'
stderr 'Gash snapshot not found\. Source gash.sh first\.'

# --- R6: plain mode, no ESC
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; gash_unload'
stderr 'Gash snapshot not found'
! stderr '\x1b'
