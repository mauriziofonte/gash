# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:116
# covers: output_style_render_spec.sh:117
# covers: output_style_render_spec.sh:118
# covers: output_style_render_spec.sh:119
# covers: output_style_render_spec.sh:120
#
# tree_stats terminal rendering (R2-R6): the grouped report (totals block,
# "By size" and "By count" share bars, "Scanned in" footer), the --top
# limit, the empty tree (no group tables), the --no-color variant, and the
# invalid_top error.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :116 stats - totals, both groupings, footer
mkdir d1
exec bash -c 'cd d1; mkdir -p d/src/deep d/empty && head -c 300000 /dev/zero >d/a.bin && printf x >d/src/b.txt && printf y >d/src/deep/c.txt && printf z >d/README; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; tree_stats d'
stdout '^  Tree statistics for .*/d$'
stdout '^  Files +4 +Total size +292\.9 KiB \(300,003 bytes\)$'
stdout '^  Empty dirs +1 +Max depth +2$'
stdout '^  By size$'
stdout '^  bin +292\.9 KiB .* 99\.9%$'
stdout '^  By count$'
stdout 'Scanned in'

# --- :117 top-1 - only the single largest extension in each group
mkdir d2
exec bash -c 'cd d2; mkdir -p d && printf x >d/a.js && printf xy >d/b.verylongextension; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; tree_stats --top 1 d'
stdout '^  verylongextension +2 B .* 66\.6%$'
! stdout '^  js '

# --- :118 empty-dir - no files, no group tables
mkdir d3
exec bash -c 'cd d3; mkdir -p d; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; tree_stats d'
stdout '^  Files +0 +Total size +0 B \(0 bytes\)$'
! stdout 'By size'

# --- :119 no-color - rich grouped report, no ESC
mkdir d4
exec bash -c 'cd d4; mkdir -p d && printf x >d/a.txt; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; tree_stats --no-color d'
stdout '^  Tree statistics for '
stdout '^  By size$'
! stdout '\x1b'

# --- :120 invalid-top
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; tree_stats --top x .'
stderr 'Error: invalid_top: x'
# 3.0: FS-49 fixed (the hint names the real range)
stderr 'Hint: Provide a non-negative integer \(at most 9 digits\)'

# --- R6: plain mode error, no ESC
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; tree_stats --top x .'
stderr '^Error: invalid_top: x'
! stderr '\x1b'
