# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:94
# covers: output_style_render_spec.sh:95
# covers: output_style_render_spec.sh:96
# covers: output_style_render_spec.sh:97
# covers: output_style_render_spec.sh:98
# covers: output_style_render_spec.sh:99
# covers: output_style_render_spec.sh:100
# covers: output_style_render_spec.sh:101
# covers: output_style_render_spec.sh:102
# covers: output_style_render_spec.sh:103
#
# files_largest terminal rendering (R2-R6): the rich ranked table (title,
# "#  SIZE  SHARE ... MODIFIED  PATH" header, share bars, "N files ..."
# footer), the --no-human and --no-color variants, the long-path ellipsis,
# the empty "No files matched." line, and the error envelopes
# (forbidden_path, path_not_found, unknown_option, invalid_limit --json).
# The share-bar column is matched with .* (box-drawing runes). Plain mode
# emits the bare "SIZE  PATH  MTIME" row and no ESC (R6).

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :94 list - ranked table with bars and footer
mkdir d1
exec bash -c 'cd d1; mkdir -p d/a/b d/c && head -c 70000 /dev/zero >d/a/b/logo.png && head -c 524288 /dev/zero >d/c/app.log && printf x >d/notes.txt; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; files_largest d'
stdout '^  Largest files in .*/d1/d$'
stdout '^  #       SIZE  SHARE +MODIFIED +PATH$'
stdout '^  1  512\.0 KiB .* c/app\.log$'
stdout '^  2   68\.3 KiB .* a/b/logo\.png$'
stdout '^  3 files .* 580\.3 KiB total .* [0-9]+m?s$'

# --- :95 no-human - raw byte sizes
mkdir d2
exec bash -c 'cd d2; mkdir -p d/a && head -c 3000 /dev/zero >d/a/x.bin && printf xy >d/y.txt; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; files_largest --no-human d'
stdout '^  1  3000 B .* a/x\.bin$'
stdout '^  2 files .* 3002 B total'

# --- :96 no-color - rich layout, no ESC
mkdir d3
exec bash -c 'cd d3; mkdir -p d && head -c 2048 /dev/zero >d/x.bin; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; files_largest --no-color d'
stdout '^  Largest files in '
stdout '^  1  2\.0 KiB .* x\.bin$'
! stdout '\x1b'

# --- :97 long-path - the middle of a deep path is elided
mkdir d4
exec bash -c 'cd d4; p=d/$(printf "very-long-directory-name-%s/" 1 2 3 4 5) && mkdir -p "$p" && head -c 4096 /dev/zero >"$p/file.bin"; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; files_largest d'
stdout '^  1  4\.0 KiB .*file\.bin$'
stdout 'very-long-directory-name-5'

# --- :98 empty - nothing over the threshold
mkdir d5
exec bash -c 'cd d5; mkdir -p d && printf x >d/x; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; files_largest --min-size 1G d'
stdout 'No files matched\.'
! stdout 'SHARE'

# --- :99 unreadable - a find stderr line does not break the table
mkdir d6
exec bash -c 'cd d6; mkdir -p d && printf x >d/x && find() { command find "$@"; printf "find: d/locked: Permission denied\n" >&2; }; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; files_largest d'
stdout '^  1   1 B .* x$'

# --- :100 forbidden - protected path error envelope on stderr
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; files_largest /proc'
stderr 'Error: forbidden_path: /proc'
stderr 'Hint: This path is protected and cannot be scanned'

# --- :101 not-found - missing path
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; files_largest ./missing'
stderr 'Error: path_not_found: Path .*missing.* does not exist'

# --- :102 unknown-option
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; files_largest --bogus'
stderr 'Error: unknown_option: --bogus'

# --- :103 json-error - the --json error envelope is one JSON line
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; files_largest --json --limit x .'
stderr '"error":"invalid_limit"'
stderr '"action":"RETRY"'

# --- R6: plain mode emits the bare row and a word-prefixed error, no ESC
mkdir d7
exec bash -c 'cd d7; mkdir -p d && head -c 2048 /dev/zero >d/x.bin; export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; files_largest d'
stdout '2\.0 KiB +.*/d/x\.bin  [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'
! stdout '\x1b'
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; files_largest /proc'
stderr '^Error: forbidden_path: /proc'
! stderr '\x1b'
