# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:554
#
# R1: every public human-facing function has a fixture. In Go mode the help
# registry lives in the binary (the bash __GASH_HELP_REGISTRY is empty), so
# the public surface is enumerated with `gash help --list` (every command, by
# namespace). This case proves the surface is complete and introspectable - a
# representative command from each namespace group (files, system, docker, wsl).
# The per-function fixture requirement itself is enforced by the covermap gate,
# which fails if any render row is left without a `# covers:` declaration.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8
env GASH__COLOR=0
env COLUMNS=100

exec gash help --list
stdout '(?m)^  gash files '
stdout '(?m)^    extract '
stdout '(?m)^  gash system '
stdout '(?m)^    disks '
stdout '(?m)^    ip '
stdout '(?m)^    kill '
stdout '(?m)^    info '
stdout '(?m)^    compose check '
stdout '(?m)^    restart '
! stdout '\x1b'
