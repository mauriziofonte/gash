# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:78
# covers: output_style_render_spec.sh:79
#
# all_colors prints the 256-color chart (R3 palette extras); path_add adds a
# directory to PATH once and here the leading PATH element is echoed.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :78 all_colors - the color chart
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; all_colors | head -n 20'
stdout 'colour0'
stdout 'colour7'

# --- :79 path_add - prepends the existing dir, skips the missing one
exec bash -c 'mkdir -p bin; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; path_add "$HOME/bin" /nonexistent; printf "%s\n" "${PATH%%:*}"'
stdout '/bin$'
