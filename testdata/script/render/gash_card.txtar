# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:48
# covers: output_style_render_spec.sh:49
# covers: output_style_render_spec.sh:50
# covers: output_style_render_spec.sh:51
#
# The gash reference card (R2-R6): the overview card (box header + topic
# table), a single topic (gash git), the full card (gash all), and the
# unknown-topic error. The box-drawing frame is matched with the stable
# inner text lines; the title line carries the version and function count.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :48 overview - framed header and the topic table
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; GASH_DIR="$GASH_STAGE" gash'
stdout 'Gash [0-9][0-9A-Za-z.-]* .* Bash for humans and AI agents'
stdout '[0-9]+ functions .* gash <topic> .* gash_help <name>'
stdout '^  TOPIC   FUNCTIONS  ALIASES  WHAT$'
stdout '^  git +[0-9]+ +[0-9]+  Sync, tags, patches'

# --- :49 topic - a single topic card
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; GASH_DIR="$GASH_STAGE" gash git'
stdout 'GIT  Sync, tags, patches, repository repair'
stdout '^  git_add_tag +gat '
stdout 'Aliases'

# --- :50 all - the whole card, every topic section
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; GASH_DIR="$GASH_STAGE" gash all'
stdout 'FILES  Largest files and folders'
stdout '^  archive_extract +axe '

# --- :51 unknown-topic - error with the topic list on stderr
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash nosuch'
stderr 'Error: Unknown topic: nosuch\. Topics: '

# --- R6: plain mode, the card still frames but with no ESC bytes
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; GASH_DIR="$GASH_STAGE" gash'
stdout 'Bash for humans and AI agents'
! stdout '\x1b'
