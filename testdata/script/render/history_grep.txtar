# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:153
# covers: output_style_render_spec.sh:154
# covers: output_style_render_spec.sh:155
#
# history_grep rendering (R2-R6). It reads the caller shell's `history`
# builtin (a function stub here), so it runs shell-side and renders plain
# under testscript: matches, the no-match empty output, and missing-arg.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :153 matches - lines whose command matches the pattern
exec bash -c 'history() { printf "%5d  %s\n" 1 "echo hello" 2 "ls -la" 3 "echo world one two"; }; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; history_grep echo'
stdout 'echo hello'
stdout 'echo world'
! stdout 'ls -la'

# --- :154 no-match - nothing printed, exit 0
exec bash -c 'history() { :; }; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; history_grep zzz'
! stdout '.'

# --- :155 missing-arg
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; history_grep'
stderr 'Error: Missing pattern\. Usage: history_grep <pattern>'

# --- R6: plain mode error, no ESC
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; history_grep'
stderr '^Error: Missing pattern'
! stderr '\x1b'
