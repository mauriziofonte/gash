# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:80
# covers: output_style_render_spec.sh:81
#
# gash_env_init rendering (R2-R6): create (✓ Created + • Edit hint, then a
# second run warns it exists) and the no-template error.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :80 create - first creates, second warns (rc 1)
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; GASH_DIR="$GASH_STAGE" gash_env_init; GASH_DIR="$GASH_STAGE" gash_env_init'
stderr 'Created .*/\.gash_env'
stderr 'Edit with your SSH keys and database credentials'
stderr 'Warning: .*\.gash_env already exists\. Use --force'

# --- :81 no-template - a clean HOME so the target does not exist yet
! exec bash -c 'export HOME="$WORK/h81"; mkdir -p "$HOME"; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; GASH_DIR="$HOME/nowhere" gash_env_init'
stderr 'Error: Template not found:'

# --- R6: plain mode, no ESC
! exec bash -c 'export HOME="$WORK/h82"; mkdir -p "$HOME"; export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; GASH_DIR="$HOME/nowhere" gash_env_init'
stderr '^Error: Template not found'
! stderr '\x1b'
