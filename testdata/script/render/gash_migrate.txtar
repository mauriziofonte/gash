# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:88
# covers: output_style_render_spec.sh:89
# covers: output_style_render_spec.sh:90
# covers: output_style_render_spec.sh:91
#
# gash_migrate in 3.0 is the decision-D-6 pointer: it does not port the
# 1.x migration and instead prints a pointer to the 2.x route on stderr
# (LEDGER SELF-08/SELF-09 rc.A: "writes nothing"). Every invocation
# (--status, the menu, --yes, --rollback) renders the same ✗ Error line,
# so these rows are covered on their R2-R6 rendering, not the 2.x flow.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :88 status
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_migrate --status'
stderr 'Gash 3 does not migrate a Gash 1.x configuration'

# --- :89 menu - interactive entry still errors immediately
! exec bash -c 'export GASH__TTY_OUT=1 GASH__TTY_IN=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_migrate'
stderr 'Gash 3 does not migrate a Gash 1.x configuration'

# --- :90 plain-yes
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100 GASH_TUI=plain; source "$GASH_SH"; gash_migrate --yes'
stderr 'check out v2.1.0'

# --- :91 rollback-none
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_migrate --rollback --yes'
stderr 'Gash 3 does not migrate a Gash 1.x configuration'

# --- R6: plain mode, no ESC
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; gash_migrate --status'
stderr 'Gash 3 does not migrate'
! stderr '\x1b'
