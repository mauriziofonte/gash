# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:65
# covers: output_style_render_spec.sh:66
# covers: output_style_render_spec.sh:67
#
# gash_inspiring_quote rendering (R2-R6): a plain quote, the --source
# variant (adds a Source line), and the unknown-option error.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :65 plain - a Quote: "..." line
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; GASH_DIR="$GASH_STAGE" gash_inspiring_quote'
stdout '^Quote: "'

# --- :66 source - adds the Source line
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; GASH_DIR="$GASH_STAGE" gash_inspiring_quote --source'
stdout '^Quote: "'
stdout 'Source: '

# --- :67 bad-option
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; gash_inspiring_quote --nope'
stderr 'Error: Unknown option: --nope \(usage: gash_inspiring_quote'

# --- R6: plain mode, no ESC
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; GASH_DIR="$GASH_STAGE" gash_inspiring_quote'
stdout '^Quote: "'
! stdout '\x1b'
