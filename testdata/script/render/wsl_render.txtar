# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:218
# covers: output_style_render_spec.sh:220
# covers: output_style_render_spec.sh:223
# covers: output_style_render_spec.sh:225
# covers: output_style_render_spec.sh:229
#
# WSL functions rendering (R2-R6), the black-box-reachable subset. The Go
# binary honours no sysroot override (requireWSL reads the real
# /proc/version), so only the paths that do NOT need a WSL host are driven
# here: the off-WSL refusal that every wsl_* hits when /proc/version is not
# Microsoft, and the two option-parsing refusals that happen before the WSL
# gate. The WSL-present rows (restart/shutdown/explorer open, taskmanager,
# compact) are the internal/system unit tests. All refusals print on stderr
# via the gash error glyph; the R6 variant proves the plain form carries no
# escape bytes.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :218 wsl_restart:not-wsl - the off-WSL refusal (reached after the
# option parse, before any cmd.exe hand-off)
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; wsl_restart -y'
stderr 'This command requires WSL \(Windows Subsystem for Linux\)\.'

# --- :220 wsl_shutdown:bad-option - unknown option refused before the WSL gate
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; wsl_shutdown --now'
stderr 'Unknown option: --now \(usage: wsl_shutdown \[-y\]\)'

# --- :223 wsl_explorer:not-wsl - the off-WSL refusal
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; wsl_explorer'
stderr 'This command requires WSL \(Windows Subsystem for Linux\)\.'

# --- :225 wsl_taskmanager:not-wsl - the off-WSL refusal
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; wsl_taskmanager'
stderr 'This command requires WSL \(Windows Subsystem for Linux\)\.'

# --- :229 wsl_compact:bad-option - unknown option refused before the WSL gate
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; wsl_compact --now'
# 3.0: SYS-45 fixed: -y is an option.
stderr 'Unknown option: --now \(usage: wsl_compact \[--status\] \[-y\]\)'

# --- R6: plain mode, the off-WSL refusal carries its word prefix and no ESC
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; wsl_restart -y'
stderr '^Error: This command requires WSL'
! stderr '\x1b'
