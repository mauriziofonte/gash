# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:280
# covers: output_style_render_spec.sh:281
# covers: output_style_render_spec.sh:282
# covers: output_style_render_spec.sh:283
# covers: output_style_render_spec.sh:284
#
# git_repair rendering (R2-R6): a clean repo (nothing to repair), the
# --dry-run plan over a planted 0-byte loose object, the no-terminal
# confirmation refusal, the -y repaired run, and the bad-option error. The
# "Empty (corrupted) object files:" line has literal parens, matched with .

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8
env GIT_CONFIG_GLOBAL=$WORK/.gitconfig

# --- :280 git_repair:clean
exec bash -c 'cd $WORK; git config --global user.name T; git config --global user.email t@e.x; git config --global color.ui false; git config --global init.defaultBranch main; mkdir r1; cd r1; git init -q --bare r.git && git init -q w && cd w && git remote add origin ../r.git && echo a >f && git add f && git commit -qm init && git push -q -u origin main 2>/dev/null; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; git_repair'
stdout 'Empty .corrupted. object files: 0'
stderr 'No empty objects and the history is connected: nothing to repair\.'

# --- :281 git_repair:dry_run
exec bash -c 'cd $WORK; mkdir r2; cd r2; git init -q --bare r.git && git init -q w && cd w && git remote add origin ../r.git && echo a >f && git add f && git commit -qm init && git push -q -u origin main 2>/dev/null; mkdir -p .git/objects/ab && : >.git/objects/ab/cdef0123456789abcdef0123456789abcdef01; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; git_repair --dry-run'
stdout 'Empty .corrupted. object files: 1'
# 3.0: GIT-08 fixed: the clone comes first, the deletion after it.
stdout '^Plan: make a fresh bare clone'

# --- :282 git_repair:declined - no terminal, so it refuses
! exec bash -c 'cd $WORK; mkdir r3; cd r3; git init -q --bare r.git && git init -q w && cd w && git remote add origin ../r.git && echo a >f && git add f && git commit -qm init && git push -q -u origin main 2>/dev/null; mkdir -p .git/objects/ab && : >.git/objects/ab/cdef0123456789abcdef0123456789abcdef01; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; git_repair'
stderr 'Error: No terminal to ask for confirmation: pass -y'

# --- :283 git_repair:repaired
exec bash -c 'cd $WORK; mkdir r4; cd r4; git init -q --bare r.git && git init -q w && cd w && git remote add origin ../r.git && echo a >f && git add f && git commit -qm init && git push -q -u origin main 2>/dev/null; mkdir -p .git/objects/ab && : >.git/objects/ab/cdef0123456789abcdef0123456789abcdef01; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; git_repair -y'
stderr 'Removing 1 corrupted \(0-byte\) loose object'
stderr 'Repo repaired and verified clean\.'

# --- :284 git_repair:bad_option
! exec bash -c 'cd $WORK; mkdir r5; cd r5; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; git_repair --bogus'
stderr 'Error: Unknown option: --bogus \(usage: git_repair'

# --- R6: plain mode, no ESC on the plan output
exec bash -c 'cd $WORK; mkdir r6; cd r6; git init -q --bare r.git && git init -q w && cd w && git remote add origin ../r.git && echo a >f && git add f && git commit -qm init && git push -q -u origin main 2>/dev/null; mkdir -p .git/objects/ab && : >.git/objects/ab/cdef0123456789abcdef0123456789abcdef01; export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; git_repair --dry-run'
stdout 'Empty .corrupted. object files: 1'
! stdout '\x1b'
