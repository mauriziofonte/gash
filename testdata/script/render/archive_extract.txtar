# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:121
# covers: output_style_render_spec.sh:122
# covers: output_style_render_spec.sh:123
# covers: output_style_render_spec.sh:124
# covers: output_style_render_spec.sh:125
#
# archive_extract rendering (R2-R6): a successful tar extraction (the files
# land in the output dir; tar's own listing is child noise), and the four
# argument/type errors (missing arg, missing file, unsupported type, and a
# .zst with no zstd on PATH).

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :121 tar - extract into out/
exec bash -c 'mkdir -p src && printf x >src/a.txt && tar czf a.tar.gz src; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; archive_extract a.tar.gz out'
exists out/src/a.txt

# --- :122 missing-arg
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; archive_extract'
stderr 'Error: Missing archive file\. Usage: archive_extract'

# --- :123 missing-file
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; archive_extract nope.zip'
stderr 'Error: File .nope.zip. does not exist\.'

# --- :124 unsupported
! exec bash -c 'printf x >file.abc; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; archive_extract file.abc'
stderr 'Error: Cannot extract .file.abc., unsupported file type\.'

# --- :125 no-zstd - zstd is not on a minimal PATH
! exec bash -c 'printf x >a.tar.zst && mkdir e; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; PATH="$PWD/e" archive_extract a.tar.zst'
# 3.4: the prerequisite report, as the envelope under GASH_HEADLESS=1 (it
# was "Error: Extracting .zst needs zstd.").
stderr '"details":"archive_extract \(\.tar\.zst\) needs zstd, which is not installed"'

# --- R6: plain mode error, no ESC
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; archive_extract'
stderr '^Error: Missing archive file'
! stderr '\x1b'
