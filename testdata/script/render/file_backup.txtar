# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:126
# covers: output_style_render_spec.sh:127
# covers: output_style_render_spec.sh:128
#
# file_backup rendering (R2-R6): a timestamped copy (cp -v reports the
# "src -> dst" mapping), and the missing-arg / missing-file errors.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :126 copy - timestamped backup made
exec bash -c 'printf x >notes.txt; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; file_backup notes.txt'
stdout 'notes.txt_backup_[0-9]+'

# --- :127 missing-arg
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; file_backup'
stderr 'Error: Missing file\. Usage: file_backup <file>'

# --- :128 missing-file
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; file_backup nope.txt'
stderr 'Error: File .nope.txt. does not exist\.'

# --- R6: plain mode error, no ESC
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; file_backup'
stderr '^Error: Missing file'
! stderr '\x1b'
