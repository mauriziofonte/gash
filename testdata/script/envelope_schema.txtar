# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: envelope_schema_spec.sh:21
# covers: envelope_schema_spec.sh:39
# covers: envelope_schema_spec.sh:54
# covers: envelope_schema_spec.sh:67
# covers: envelope_schema_spec.sh:75
# covers: envelope_schema_spec.sh:91
# covers: envelope_schema_spec.sh:106
#
# The JSON envelopes AGENTS.md documents as stable API, checked key by key
# and type by type (valid JSON alone is covered by headless_contract). Each
# helper builds the shared fixture t/{a/{x.txt,b/big.bin},empty} in $WORK and
# asserts the schema with jq. llm_ports still execs ss (MOCK-DEPENDENT run*),
# so a fake ss goes on PATH exactly as the 2.x spec did.

env GASH_HEADLESS=1

exec chmod +x ssbin/ss

# --- envelope_schema_spec.sh:21 - size-list envelope
exec bash size_list.sh

# --- envelope_schema_spec.sh:39 - empty-dirs and tree-stats envelopes
exec bash empty_tree.sh

# --- envelope_schema_spec.sh:54 - llm_tree --stats cumulative sizes/counts
exec bash tree_stats_cumulative.sh

# --- envelope_schema_spec.sh:67 - llm_tree flags a 500-entry cut
exec bash tree_capped.sh

# --- envelope_schema_spec.sh:75 - database envelope
exec bash db_envelope.sh

# --- envelope_schema_spec.sh:91 - git envelopes
exec bash git_envelope.sh

# --- envelope_schema_spec.sh:106 - system and project envelopes
exec bash sys_project.sh

-- ssbin/ss --
#!/usr/bin/env bash
echo "Netid State  Recv-Q Send-Q Local Address:Port Peer Address:Port"
echo "tcp   LISTEN 0      4096   [::]:22            [::]:*"
echo "udp   UNCONN 0      0      0.0.0.0:68         0.0.0.0:*"

-- fixture.sh --
# Sourced by the helpers: build t/{a/{x.txt,b/big.bin},empty} in $WORK/fx.
mkfixture() {
  fx="$WORK/fx"
  rm -rf "$fx"
  mkdir -p "$fx/t/a/b" "$fx/t/empty"
  head -c 70000 /dev/zero >"$fx/t/a/b/big.bin"
  printf 'hi\n' >"$fx/t/a/x.txt"
}
schema() { local in; in="$(cat)"; jq -e "$2" <<<"$in" >/dev/null || { echo "schema $1 failed on: $in" >&2; return 1; }; }

-- size_list.sh --
set -euo pipefail
source "$WORK/fixture.sh"; mkfixture
source "$GASH_SH"
common='(keys == ["count","data","errors","kind","scan_time","total_size","total_size_human"])
  and (.data | type == "array") and (.count == (.data | length))
  and (.total_size == ([.data[].size] | add // 0))
  and (.total_size_human | type == "string")
  and (.scan_time | test("^[0-9]+ms$")) and (.errors | type == "number")
  and all(.data[]; (.size | type == "number") and (.size_human | type == "string")
                   and (.path | startswith("/")))'
files_largest --json "$fx/t" | schema files "$common and .kind == \"files\" and .count == 2
  and all(.data[]; (.mtime | test(\"^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$\")))
  and .data[0].size == 70000"
dirs_largest --json "$fx/t" | schema dirs_largest "$common and .kind == \"directories\"
  and all(.data[]; has(\"mtime\") | not)"
dirs_find_large --size 1 --json "$fx/t" | schema dirs_find_large "$common and .kind == \"directories\""

-- empty_tree.sh --
set -euo pipefail
source "$WORK/fixture.sh"; mkfixture
source "$GASH_SH"
root="$(cd "$fx/t" && pwd -P)"
dirs_list_empty --json "$fx/t" | schema empty "keys == [\"count\",\"data\",\"errors\",\"path\"]
  and .data == [\"$root/empty\"] and .count == 1 and .path == \"$root\" and .errors == 0"
tree_stats --json "$fx/t" | schema tree_stats '(keys == ["data","errors","scan_time"])
  and (.data | keys == ["avg_file_size","dirs_total","empty_dirs","files_total","max_depth","path",
                        "size_total","size_total_human","top_by_count","top_by_size"])
  and .data.files_total == 2 and .data.size_total == 70003 and .data.empty_dirs == 1
  and all(.data.top_by_count[]; keys == ["count","ext","size"])
  and all(.data.top_by_size[]; keys == ["ext","size"])
  and (.scan_time | test("^[0-9]+ms$"))'

-- tree_stats_cumulative.sh --
set -euo pipefail
source "$WORK/fixture.sh"; mkfixture
source "$GASH_SH"
llm_tree --depth 2 --stats "$fx/t" | schema llm_tree '
  (keys == ["children","children_count","path","size","type"])
  and .type == "directory" and .size == 70003 and .children_count == 2
  and ((.children[] | select(.name == "a")) as $a
       | $a.size == 70003 and $a.children_count == 2
       and ($a.children[] | select(.name == "b") | .size == 70000 and .children_count == 1 and (has("children") | not)))'
llm_tree "$fx/t" | schema llm_tree_plain '(keys == ["children","path","type"])
  and all(.children[]; keys == ["name","type"])'

-- tree_capped.sh --
set -euo pipefail
source "$WORK/fixture.sh"; mkfixture
source "$GASH_SH"
mkdir "$fx/many"
(cd "$fx/many" && for i in $(seq 1 510); do : >"f$i"; done)
llm_tree --stats "$fx/many" | schema capped '.truncated == true and (.children | length) == 500 and .children_count == 510'
llm_tree "$fx/t" | schema uncapped 'has("truncated") | not'

-- db_envelope.sh --
set -euo pipefail
source "$WORK/fixture.sh"; mkfixture
source "$GASH_SH"
db="$fx/app.db"
sqlite3 "$db" 'CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT); INSERT INTO users(name) VALUES ("alice"), ("bob");'
env='((keys - ["slow_query_explain"]) == ["data","query_time","rows"]) and (.data | type == "array")
  and .rows == (.data | length) and (.query_time | test("^[0-9]+(\\.[0-9]+)?(µs|ms|s)$") and . != "0µs")'
llm_db_tables -f "$db" | schema tables "$env and .data == [\"users\"]"
llm_db_schema users -f "$db" | schema schema "$env and ([.data[].name] == [\"id\",\"name\"])"
llm_db_sample users -f "$db" --limit 1 | schema sample "$env and .data == [{id: 1, name: \"alice\"}]"
llm_db_query "SELECT id, name FROM users ORDER BY id" -f "$db" | schema query "$env and .rows == 2 and .data[1].name == \"bob\""
llm_db_explain "SELECT * FROM users" -f "$db" | schema explain "$env and .rows >= 1"

-- git_envelope.sh --
set -euo pipefail
source "$WORK/fixture.sh"; mkfixture
source "$GASH_SH"
repo="$fx/repo"; mkdir "$repo"; cd "$repo"
git init -q -b main . && git config user.email t@t && git config user.name T
echo a >a && git add a && git commit -qm 'first "quoted"'
echo b >>a && echo n >new
llm_git_status "$repo" | schema status 'keys == ["ahead","behind","branch","conflicted","modified","staged","untracked"]
  and .branch == "main" and .ahead == 0 and .behind == 0
  and .modified == ["a"] and .untracked == ["new"] and .staged == [] and .conflicted == []'
llm_git_log --limit 5 "$repo" | schema log 'length == 1
  and (.[0] | keys == ["author","date","hash","subject"]) and .[0].subject == "first \"quoted\""'

-- sys_project.sh --
set -euo pipefail
source "$WORK/fixture.sh"; mkfixture
export PATH="$WORK/ssbin:$PATH"
source "$GASH_SH"
printf '{"name":"x","dependencies":{"left-pad":"1"},"devDependencies":{"jest":"1"}}' >"$fx/package.json"
llm_project "$fx" | schema project 'keys == ["entry_point","framework","has_tests","package_manager","path","type"]
  and .type == "javascript" and .package_manager == "npm" and (.has_tests | type == "boolean")'
llm_deps "$fx" | schema deps 'keys == ["dependencies","manager"] and .dependencies == ["left-pad"]'
llm_deps "$fx" --dev | schema deps_dev 'keys == ["dev","manager","prod"] and .dev == ["jest"]'
llm_procs --name bash | schema procs 'type == "array" and all(.[]; (.pid | type == "number") and (.name | type == "string"))'
llm_ports | schema ports 'type == "array" and all(.[]; (.port | type == "number") and (.proto | type == "string"))'
