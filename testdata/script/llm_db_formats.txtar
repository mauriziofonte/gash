# Gash 3.4. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# llm_db_* output options (new in 3.4, plan D1 and D3) on an SQLite file,
# through the shim and the binary directly:
#   - --format json is the envelope, byte for byte (the query_time of a
#     frozen clock is not available here, so the two outputs are compared
#     with the timing replaced);
#   - --format tsv/jsonl/table print the rows, NULL as \N in TSV, REALs in
#     their shortest form, the metadata as one JSON line on stderr with
#     "truncated": true when the -n cap cut rows;
#   - --scalar prints the one value of a 1x1 result, not_a_scalar
#     otherwise;
#   - llm_db_tables --counts and llm_db_schema --all;
#   - the SQL guard still refuses a write first, whatever the format.
#
# covers: none (new in 3.4; no 2.x spec)

env GASH_HEADLESS=1
[!exec:sqlite3] skip 'sqlite3 is needed to create the fixture'
exec sqlite3 app.db 'CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT, score REAL, note TEXT); INSERT INTO users VALUES (1, ''alice'', 8.6, NULL), (2, ''bob'', 1.0, ''a	b''), (3, ''carol'', 0.1, ''x''); CREATE TABLE tags(id INTEGER, tag TEXT); INSERT INTO tags VALUES (1, ''t'');'

# --- --format json is the envelope
exec bash -c 'source "$GASH_SH"; llm_db_query "SELECT * FROM users" -f app.db | sed -E "s/\"query_time\":\"[^\"]*\"/T/" > default.json'
exec bash -c 'source "$GASH_SH"; llm_db_query "SELECT * FROM users" -f app.db --format json | sed -E "s/\"query_time\":\"[^\"]*\"/T/" > json.json'
cmp default.json json.json
cmp default.json envelope.golden

# --- tsv, jsonl, table
exec bash -c 'source "$GASH_SH"; llm_db_query "SELECT * FROM users" -f app.db --format tsv'
cmp stdout users.tsv
stderr '^\{"query_time":"[0-9.]+(µs|ms|s)","rows":3\}$'
exec gash llm_db_query 'SELECT id, score FROM users' -f app.db --format jsonl -n 2
cmp stdout users.jsonl
stderr '^\{"query_time":"[^"]+","rows":2,"truncated":true\}$'
exec gash llm_db_query 'SELECT id, name FROM users' -f app.db --format table
cmp stdout users.table
! exec gash llm_db_query 'SELECT 1' -f app.db --format csv
stderr '"error":"invalid_format","details":"csv","action":"RETRY"'

# --- --scalar
exec gash llm_db_query 'SELECT count(*) FROM users' -f app.db --scalar
stdout '^3$'
! stderr .
exec gash llm_db_query 'SELECT note FROM users WHERE id = 1' -f app.db --scalar
stdout '^\\N$'
! exec gash llm_db_query 'SELECT id, name FROM users' -f app.db --scalar
stderr '"error":"not_a_scalar","details":"3 rows x 2 columns","action":"RETRY"'

# --- llm_db_tables --counts, llm_db_schema --all
exec gash llm_db_tables -f app.db --counts
stdout '^\{"data":\[\{"name":"tags","rows":1\},\{"name":"users","rows":3\}\],"rows":2,'
exec bash -c 'source "$GASH_SH"; llm_db_schema --all -f app.db --format tsv'
cmp stdout schema.tsv
! exec gash llm_db_schema users --all -f app.db
stderr '"error":"unexpected_argument","details":"users"'

# --- the SQL guard runs first
! exec gash llm_db_query 'DELETE FROM users' -f app.db --format tsv
stderr '"error":"write_operation_blocked"'
! stdout .

-- envelope.golden --
{"data":[{"id":1,"name":"alice","score":8.59999999999999964,"note":null},{"id":2,"name":"bob","score":1.0,"note":"a\tb"},{"id":3,"name":"carol","score":0.100000000000000005,"note":"x"}],"rows":3,T}
-- users.tsv --
id	name	score	note
1	alice	8.6	\N
2	bob	1.0	a\tb
3	carol	0.1	x
-- users.jsonl --
{"id":1,"score":8.6}
{"id":2,"score":1.0}
-- users.table --
id  name
1   alice
2   bob
3   carol
-- schema.tsv --
table	cid	name	type	notnull	dflt_value	pk
tags	0	id	INTEGER	0	\N	0
tags	1	tag	TEXT	0	\N	0
users	0	id	INTEGER	0	\N	1
users	1	name	TEXT	0	\N	0
users	2	score	REAL	0	\N	0
users	3	note	TEXT	0	\N	0
