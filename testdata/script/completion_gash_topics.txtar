# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# ledger: SHELL-03
# covers: none (3.0 completion fix)
#
# SHELL-03 proving test, 3.5: TAB after "gash " offers the namespaces and
# Gash's own commands, every one of them a word gash accepts: each page
# (a namespace, help, version, config, all) runs with status 0. The
# commands that act (doctor, update, uninstall, unload, init, run) take
# their own arguments and are not run here.

env GASH_BANNER=0
exec bash --norc --noprofile -i drive.sh
stdout '^offered: files system shell git docker remote db runtime ai hte wsl win logs llm agent help doctor update version config uninstall unload init run all$'
! stdout 'FAILED'
stdout '^ran 19$'

-- drive.sh --
source "$GASH_SH" >/dev/null 2>&1
source "$GASH_STAGE/bash_completion"
COMP_WORDS=(gash "")
COMP_CWORD=1
__gash_complete
offered=()
for v in "${COMPREPLY[@]}"; do offered+=("${v%% *}"); done
echo "offered: ${offered[*]}"
n=0
for w in "${offered[@]}"; do
    case "$w" in doctor | update | uninstall | unload | init | run) continue ;; esac
    gash "$w" >/dev/null 2>&1 || echo "FAILED $w"
    n=$((n + 1))
done
echo "ran $n"
