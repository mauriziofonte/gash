# Gash 3.4. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# llm_db_* over ssh (new in 3.4, plan D2): a DB: connection whose scheme
# ends in +ssh runs the engine's client on a registered HOST: alias, one
# ssh invocation per query. The SQL guard runs first: a write is refused
# before the stub ssh is ever called. The ssh on PATH is a stub that logs
# each invocation and its arguments and runs the remote script with sh; the
# mysql on PATH is a stub that logs its arguments, MYSQL_PWD and stdin.
# The date stub stops the clock the host reads around the client, so a
# loaded machine never makes the query slow (no slow_query_explain).
#
# covers: none (new in 3.4; no 2.x spec)

env GASH_HEADLESS=1
env LC_ALL=C
env GASH_ENV_FILE=$WORK/hostenv
env PATH=$WORK/bin:$PATH
chmod 755 bin/ssh
chmod 755 bin/mysql
chmod 755 bin/date

# --- the guard refuses a write before anything connects
! exec gash llm_db_query 'DELETE FROM users' -c shop
stderr '"action":"FATAL"'
! exists ssh.log
! exec bash -c 'source "$GASH_SH"; llm_db_query "UPDATE users SET name = 1" -c shop'
stderr '"action":"FATAL"'
! exists ssh.log

# --- a read: one invocation, the password on stdin only, a read-only session
exec gash llm_db_query 'SELECT id, name FROM users' -c shop
stdout '^\{"data":\[\{"id":"1","name":"Alice"\},\{"id":"2","name":"NULL"\}\],"rows":2,"query_time":"[^"]+"\}$'
grep -count=1 @ ssh.log
! grep 's3cret' ssh.args
grep '^s3cret$' mysql.pw
grep 'SET SESSION TRANSACTION READ ONLY' mysql.stdin

# --- an unknown alias in the URL is refused before connecting
rm ssh.log
! exec gash llm_db_tables -c nohost
stderr '"error":"unknown_host"'
! exists ssh.log

-- hostenv --
HOST:web=deploy@web.example
DB:shop=mysql+ssh://shop:s3cret@web/shop
DB:nohost=mysql+ssh://shop@nope/shop
-- bin/ssh --
#!/bin/sh
# ssh stub: log the invocation and its arguments, run the remote script
# with sh in $WORK (the password and the SQL arrive on stdin).
printf '%s\n' "$@" >>"$WORK/ssh.args"
while [ $# -gt 0 ]; do a=$1; shift; [ "$a" = -- ] && break; done
echo "$1" >>"$WORK/ssh.log"
cd "$WORK" && HOME=$WORK exec sh -c "$2"
-- bin/mysql --
#!/bin/sh
# mysql stub: log the arguments, MYSQL_PWD and stdin; print two rows.
printf '%s\n' "$@" >"$WORK/mysql.args"
printf '%s\n' "$MYSQL_PWD" >"$WORK/mysql.pw"
cat >"$WORK/mysql.stdin"
printf 'id\tname\n1\tAlice\n2\tNULL\n'
-- bin/date --
#!/bin/sh
echo 1700000000000000000
