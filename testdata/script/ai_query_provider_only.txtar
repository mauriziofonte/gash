# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# ledger: AI-02
# covers: none (3.0 fix: a provider alone is not a question)
#
# LEDGER AI-02: `ai_query claude` takes claude as the provider and has no
# question: "Error: No query provided", rc 1, and httpsfake sees no request
# (also with piped input). `ai_query claude hi` still asks "hi".

env GASH_HEADLESS=1
exec bash provider_only.sh

-- provider_only.sh --
set -uo pipefail
fail() { echo "FAIL: $1" >&2; exit 1; }
export MOCK_CURL_LOG="$PWD/curl.log"
httpsfake -ca ca -addr addr & pid=$!
trap 'kill "$pid" 2>/dev/null' EXIT
for i in $(seq 1 100); do [ -s addr ] && break; sleep 0.05; done
read -r a <addr
printf 'AI:claude=test-key\n' >"$HOME/.gash_env"
chmod 600 "$HOME/.gash_env"
export HTTPS_PROXY="http://$a" SSL_CERT_FILE="$PWD/ca"
source "$GASH_SH"

ai_query claude </dev/null 2>err && fail "rc 0"
[ "$(cat err)" = "Error: No query provided" ] || fail "stderr: $(cat err)"
printf 'log line\n' | ai_query claude 2>err && fail "piped: rc 0"
[ "$(cat err)" = "Error: No query provided" ] || fail "piped stderr: $(cat err)"
[ ! -s curl.log ] || fail "a request was sent"

ai_query claude hi </dev/null >out 2>err || fail "claude hi: $(cat err)"
[ "$(grep -c '^body:' curl.log)" = 1 ] || fail "want one request"
grep -q 'n\\nhi"' curl.log || fail "question is not hi: $(cat curl.log)"
echo ok
