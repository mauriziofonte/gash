# Gash 3.4. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# llm_date (new in 3.4, plan V4): date arithmetic without GNU or BSD date
# and without Python, the same on Linux and macOS, through the shim and
# the binary directly: differences in calendar days, additions with
# clamped months and calendar days across DST, Unix times both ways, a
# date(1) --fmt. Unparsable input is RETRY. The current time and every
# directive are Go tests (internal/llm/date_test.go).
#
# covers: none (new in 3.4; no 2.x spec)

env GASH_HEADLESS=1
env TZ=UTC

# --- differences, through the shim and directly
exec bash -c 'source "$GASH_SH"; llm_date --diff 2026-10-25 2026-12-31'
stdout '^\{"result":"67d","days":67,"seconds":5788800\}$'
! stderr .
exec gash llm_date --diff 2026-03-28T12:00:00 2026-03-30T12:00:00 --tz Europe/Rome
stdout '^\{"result":"1d23h","days":1,"seconds":169200\}$'

# --- additions: a month clamps, a day keeps the wall time across DST
exec gash llm_date --add 2026-01-31 1mo
stdout '^\{"result":"2026-02-28","epoch":1772236800\}$'
exec gash llm_date --add 2026-03-28T12:00:00 1d --tz Europe/Rome
stdout '^\{"result":"2026-03-29T12:00:00\+02:00","epoch":1774778400\}$'
exec gash llm_date --add 2026-10-25T08:00:00Z -600s --fmt '%Y-%m-%dT%H:%M:%S'
stdout '^\{"result":"2026-10-25T07:50:00","epoch":1792914600\}$'

# --- Unix times both ways; TZ applies without --tz
exec gash llm_date --epoch 1700000000
stdout '^\{"result":"2023-11-14T22:13:20Z","epoch":1700000000\}$'
exec gash llm_date --epoch 2026-10-25T00:00:00+02:00
stdout '"epoch":1792879200\}$'

# --- now has the shape of every date result
exec gash llm_date --tz UTC
stdout '^\{"result":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z","epoch":[0-9]+\}$'

# --- errors
! exec gash llm_date --add tomorrowish 1d
stderr '"error":"invalid_date","details":"tomorrowish","action":"RETRY"'
! exec gash llm_date --add 2026-10-25 3x
stderr '"error":"invalid_duration"'
! exec gash llm_date --tz Mars/Olympus
stderr '"error":"invalid_timezone"'
! exec gash llm_date --fmt '%Q'
stderr '"error":"invalid_date_format"'

# --- help without side effects
exec gash llm_date --help
stdout 'llm_date \[--diff A B \| --add DATE DURATION \| --epoch X\]'
