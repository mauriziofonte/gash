# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: none (3.0 self-management proof)
#
# dev/port/design/upgrade.md 3.4 and 6: a 2.1.0 install upgraded by its
# 2.x gash_upgrade to 3.0.0 (which fetched its binary and ran) goes back
# with a plain `git checkout v2.1.0`: the working tree is clean at every
# step (the binary and every 3.x state live under the XDG directories),
# 2.1.0 loads and runs again with nothing to undo, and its gash_upgrade
# moves to 3.0.0 again.

[!exec:git] skip 'needs git'
[!v2tree] skip 'needs the v2.1.0 tag (a shallow checkout has no tags: the testscript CI job fetches them)'
env GASH_BIN=
env GASH_RELEASE_URL=file://$WORK/rel

gashfixture origin v2.1.0:2x v3.0.0:3x
gashrelease 3.0.0 rel
exec sh -c 'git -C origin show v2.1.0:install.sh >install2.sh'
env GASH_INSTALL_GIT_REPO=$WORK/origin
env GASH_INSTALL_REF=v2.1.0
exec bash install2.sh --assume-yes --quiet
cp home/.bashrc bashrc.before
cp home/.gashrc gashrc.before

exec bash -c 'GASH_HEADLESS=1; source "$HOME/.gashrc"; gash_upgrade'
stderr 'Upgraded Gash from v2\.1\.0 to v3\.0\.0'
exec git -C home/.gash status --porcelain
! stdout .

# 3.0.0 runs: headless and interactive.
exec bash -c 'GASH_HEADLESS=1; source "$HOME/.gashrc"; echo "v=$GASH_VERSION"; gash_username'
stdout '^v=3\.0\.0$'
exists home/.local/share/gash/versions/3.0.0/gash
exec bash -i -c 'echo "v=$GASH_VERSION"; type -t gash_doctor'
stdout '^v=3\.0\.0$'
stdout '^function$'
exec git -C home/.gash status --porcelain
! stdout .

# Rollback: a plain checkout.
exec git -C home/.gash -c advice.detachedHead=false checkout -q v2.1.0
exec git -C home/.gash status --porcelain
! stdout .
cmp home/.bashrc bashrc.before
cmp home/.gashrc gashrc.before

# 2.1.0 loads and runs again.
exec bash -c 'GASH_HEADLESS=1; source "$HOME/.gashrc"; echo "rc=$? v=$GASH_VERSION"; type -t llm_tree; gash_username'
stdout '^rc=0 v=2\.1\.0$'
stdout '^function$'
! stderr .
exec bash -i -c 'echo "v=$GASH_VERSION"; type -t gash_doctor'
stdout '^v=2\.1\.0$'
stdout '^function$'
exec git -C home/.gash status --porcelain
! stdout .

# And 2.x gash_upgrade moves to 3.0.0 again.
exec bash -c 'GASH_HEADLESS=1; source "$HOME/.gashrc"; gash_upgrade'
stderr 'Upgraded Gash from v2\.1\.0 to v3\.0\.0'
exec git -C home/.gash describe --tags --exact-match HEAD
stdout '^v3\.0\.0$'
exec git -C home/.gash status --porcelain
! stdout .
exec bash -c 'GASH_HEADLESS=1; source "$HOME/.gashrc"; echo "v=$GASH_VERSION"; gash version --json'
stdout '^v=3\.0\.0$'
stdout '"version":"3\.0\.0"'

-- home/.bashrc --
# the user's bashrc
-- home/.gitconfig --
[user]
	name = t
	email = t@t
[advice]
	detachedHead = false
