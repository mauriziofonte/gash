# covers: headless_contract_spec.sh:47
# covers: headless_contract_spec.sh:53
# covers: headless_contract_spec.sh:58
# covers: headless_contract_spec.sh:71
# covers: headless_contract_spec.sh:77
# covers: headless_contract_spec.sh:83
# covers: headless_contract_spec.sh:89
# covers: headless_contract_spec.sh:94
# covers: headless_contract_spec.sh:99
# covers: headless_contract_spec.sh:112
# covers: headless_contract_spec.sh:125
# covers: headless_contract_spec.sh:139
# covers: headless_contract_spec.sh:156
# covers: headless_contract_spec.sh:163
# covers: headless_contract_spec.sh:169
# covers: headless_contract_spec.sh:178
