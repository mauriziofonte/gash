# Gash 3.4. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# llm_tcp (new in 3.4, plan N4): TCP reachability of each HOST:PORT with the
# connect time, probed in parallel, rows in input order. The open target is
# httpsfake's local listener (started by the case itself); the closed one is
# the port of a listener the case started and stopped, so nothing leaves the
# machine. A target that does not parse is a RETRY error of the call.
#
# covers: none (new in 3.4; no 2.x spec)

env GASH_HEADLESS=1
env LC_ALL=C

# --- sourced shell: an open and a closed port, input order kept
exec bash -c 'source "$WORK/start.sh"; source "$GASH_SH"; llm_tcp "$OPEN" "$CLOSED" -j 2'
stdout '^\[\{"target":"127\.0\.0\.1:[0-9]+","open":true,"ms":[0-9.]+,"error":null\},\{"target":"127\.0\.0\.1:[0-9]+","open":false,"ms":[0-9.]+,"error":"connection_refused"\}\]$'
! stderr .

# --- direct, as TSV
exec bash -c 'source "$WORK/start.sh"; gash llm_tcp "$CLOSED" "$OPEN" --format tsv --timeout 2'
stdout '^target\topen\tms\terror$'
stdout '^127\.0\.0\.1:[0-9]+\tfalse\t[0-9.]+\tconnection_refused$'
stdout '^127\.0\.0\.1:[0-9]+\ttrue\t[0-9.]+\t\\N$'

# --- argument errors
! exec gash llm_tcp
stderr '"error":"missing_target"'
! exec gash llm_tcp db.local
stderr '"error":"invalid_target","details":"db.local"'
! exec gash llm_tcp db.local:99999
stderr '"error":"invalid_target"'
exec gash llm_tcp --help
stdout 'llm_tcp HOST:PORT\.\.\.'

-- start.sh --
# OPEN is httpsfake's listener (stopped when the calling shell exits);
# CLOSED is the port a second fake held and released.
httpsfake -ca "$WORK/ca.pem" -addr "$WORK/open.$$" & fakepid=$!
httpsfake -ca "$WORK/ca2.pem" -addr "$WORK/closed.$$" & gone=$!
trap 'kill "$fakepid" 2>/dev/null; wait "$fakepid" 2>/dev/null || true' EXIT
for i in $(seq 1 100); do [ -s "$WORK/open.$$" ] && [ -s "$WORK/closed.$$" ] && break; sleep 0.05; done
read -r OPEN <"$WORK/open.$$"
read -r CLOSED <"$WORK/closed.$$"
kill "$gone"; wait "$gone" 2>/dev/null || true
export OPEN CLOSED
