# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
# covers: none (3.0 HTE surface; no 2.x spec)
# gash localweb command-line errors: one envelope on stderr, nothing on
# stdout, exit 1, the hint naming the command's help.

! exec gash localweb install --bogus
! stdout .
stderr '^\{"error":"unknown_option","details":"unknown flag: --bogus","action":"RETRY","recoverable":true,"hint":"Run: gash localweb install --help"\}$'

! exec gash localweb site create --domain
! stdout .
stderr '^\{"error":"missing_value","details":"flag needs an argument: --domain","action":"RETRY","recoverable":true,"hint":"Run: gash localweb site create --help"\}$'

! exec gash localweb php ini set --domain a.test memory_limit
stderr '^\{"error":"missing_value","details":"accepts 2 arg\(s\), received 1",'

! exec gash localweb doctor extra
stderr '^\{"error":"unexpected_argument",.*"hint":"Run: gash localweb doctor --help"\}$'

! exec gash localweb frobnicate
stderr '^\{"error":"unexpected_argument","details":"unknown command \\"frobnicate\\" for \\"gash localweb\\"",'

! exec gash localweb help
stderr '"error":"unexpected_argument"'

# A flag pair that contradicts itself fails before anything runs.
! exec gash localweb install --restore-stage /x --no-restore
! stdout .
stderr '^\{"error":"conflicting_options","details":"--restore-stage and --no-restore contradict each other","action":"RETRY","recoverable":true,"hint":"pass one of them"\}$'

! exec gash localweb site create --domain a.test --docroot /srv --https --no-https
stderr '^\{"error":"conflicting_options","details":"--https and --no-https contradict each other",'
