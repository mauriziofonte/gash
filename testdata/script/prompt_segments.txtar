-- want_ascii_root.txt --
git_ahead_behind: \e[0;31mUSER\e[0m:\e[1;33mCWD\e[0m \e[1;34m(main\e[2m+1-2\e[0m\e[1;34m)\e[0m \e[1;35mPROMPTCHAR\e[0m |
git_ahead_behind_no_color: USER:CWD (main+1-2) PROMPTCHAR |
-- want_ascii_user.txt --
git_ahead_behind: \e[0;32mUSER\e[0m:\e[1;33mCWD\e[0m \e[1;34m(main\e[2m+1-2\e[0m\e[1;34m)\e[0m \e[1;35mPROMPTCHAR\e[0m |
git_ahead_behind_no_color: USER:CWD (main+1-2) PROMPTCHAR |
