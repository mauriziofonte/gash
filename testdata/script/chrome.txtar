# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: chrome_spec.sh:36
# covers: chrome_spec.sh:44
# covers: chrome_spec.sh:53
# covers: chrome_spec.sh:65
# covers: chrome_spec.sh:79
# covers: chrome_spec.sh:91
#
# chrome_headless_update through the shim. The Go port resolves the pinned
# build over net/http (not curl, SYS-36), so the 2.x curl mock is bypassed and
# a tiny stdlib HTTPS CONNECT proxy (chromeproxy.go, built here) serves the
# same canned npm/jsDelivr/Chrome-for-Testing answers reached via HTTPS_PROXY
# with its CA trusted through SSL_CERT_FILE. uname/unzip/ldd are PATH stubs
# (uname reports Linux + $MOCK_ARCH); unzip/ldd are never run in these cases
# since none downloads. The proxy is a child of each case's shell, killed and
# reaped before the shell returns. Resolution/plan lines print on stdout; the
# spinner tasks and refusals print on stderr.

env GASH_HEADLESS=1
exec go build -o chromeproxy .
chmod 0755 bin/uname
chmod 0755 bin/unzip
chmod 0755 bin/ldd

# --- chrome_spec.sh:36 - rejects unknown options (before any probe)
! exec bash -c 'source "$GASH_SH"; chrome_headless_update --bogus'
stderr 'Unknown option: --bogus'

# --- chrome_spec.sh:44 - refuses on a platform Chrome for Testing does not publish
! exec bash -c 'export PATH="$PWD/bin:$PATH" MOCK_ARCH=aarch64; source "$GASH_SH"; chrome_headless_update --dry-run'
stderr 'Linux x86_64 only'

# --- chrome_spec.sh:53 - --dry-run resolves the build pinned by the latest Playwright
exec bash -c './chromeproxy -ca ca1.pem -addr addr1 >fp1.out 2>&1 & pid=$!; for i in $(seq 1 100); do [ -s addr1 ] && break; sleep 0.05; done; read -r a <addr1; export PATH="$PWD/bin:$PATH" HTTPS_PROXY=http://$a HTTP_PROXY=http://$a SSL_CERT_FILE="$PWD/ca1.pem" GASH_CHROME_ROOT="$PWD/opt/chs" GASH_CHROME_LINK="$PWD/bin/chrome-headless-shell"; source "$GASH_SH"; chrome_headless_update --dry-run; rc=$?; kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; exit $rc'
stdout 'playwright-core 1\.56\.0 \(chromium-headless-shell 141\.0\.7390\.37, revision 1194\)'
stdout 'Installed:.*none'
stdout 'NEW packages will be installed'
stdout 'Need to get 100\.0 MiB.*storage\.example/141\.0\.7390\.37'
! exists opt/chs

# --- chrome_spec.sh:65 - plans an upgrade that keeps current and prunes older
mkdir opt/chs/139.0.7258.5/chrome-headless-shell-linux64
mkdir opt/chs/140.0.7339.16/chrome-headless-shell-linux64
exec touch opt/chs/140.0.7339.16/chrome-headless-shell-linux64/chrome-headless-shell
exec bash -c 'ln -s "$PWD/opt/chs/140.0.7339.16/chrome-headless-shell-linux64/chrome-headless-shell" "$PWD/bin/chrome-headless-shell"; ./chromeproxy -ca ca2.pem -addr addr2 >fp2.out 2>&1 & pid=$!; for i in $(seq 1 100); do [ -s addr2 ] && break; sleep 0.05; done; read -r a <addr2; export PATH="$PWD/bin:$PATH" HTTPS_PROXY=http://$a HTTP_PROXY=http://$a SSL_CERT_FILE="$PWD/ca2.pem" GASH_CHROME_ROOT="$PWD/opt/chs" GASH_CHROME_LINK="$PWD/bin/chrome-headless-shell"; source "$GASH_SH"; chrome_headless_update --dry-run; rc=$?; kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; exit $rc'
stdout '\(140\.0\.7339\.16 => 141\.0\.7390\.37'
stdout 'Kept for rollback:.*140\.0\.7339\.16'
stdout '(?s)REMOVED:.*139\.0\.7258\.5'

# --- chrome_spec.sh:79 - does nothing when the pinned build is installed
mkdir opt2/chs/141.0.7390.37/chrome-headless-shell-linux64
exec touch opt2/chs/141.0.7390.37/chrome-headless-shell-linux64/chrome-headless-shell
exec bash -c 'ln -s "$PWD/opt2/chs/141.0.7390.37/chrome-headless-shell-linux64/chrome-headless-shell" "$PWD/bin/chs2"; ./chromeproxy -ca ca3.pem -addr addr3 >fp3.out 2>&1 & pid=$!; for i in $(seq 1 100); do [ -s addr3 ] && break; sleep 0.05; done; read -r a <addr3; export PATH="$PWD/bin:$PATH" HTTPS_PROXY=http://$a HTTP_PROXY=http://$a SSL_CERT_FILE="$PWD/ca3.pem" GASH_CHROME_ROOT="$PWD/opt2/chs" GASH_CHROME_LINK="$PWD/bin/chs2"; source "$GASH_SH"; chrome_headless_update </dev/null; rc=$?; kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; exit $rc'
stdout 'already the newest version \(141\.0\.7390\.37\)'

# --- chrome_spec.sh:91 - fails cleanly when the npm registry is unreachable
! exec bash -c 'export MOCK_CHROME_FAIL=1; ./chromeproxy -ca ca4.pem -addr addr4 >fp4.out 2>&1 & pid=$!; for i in $(seq 1 100); do [ -s addr4 ] && break; sleep 0.05; done; read -r a <addr4; export PATH="$PWD/bin:$PATH" HTTPS_PROXY=http://$a HTTP_PROXY=http://$a SSL_CERT_FILE="$PWD/ca4.pem" GASH_CHROME_ROOT="$PWD/opt4/chs" GASH_CHROME_LINK="$PWD/bin/chs4"; source "$GASH_SH"; chrome_headless_update -y; rc=$?; kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; exit $rc'
stderr 'Nothing changed'
! exists opt4/chs

-- bin/uname --
#!/bin/sh
case "$1" in
  -m) echo "${MOCK_ARCH:-x86_64}" ;;
  *)  echo Linux ;;
esac
-- bin/unzip --
#!/bin/sh
exit 0
-- bin/ldd --
#!/bin/sh
exit 0
-- go.mod --
module chromeproxy

go 1.27
-- chromeproxy.go --
// Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
//
// Test fixture: a tiny stdlib-only HTTPS CONNECT proxy answering the npm
// registry, jsDelivr and Chrome-for-Testing requests that
// chrome_headless_update makes over net/http, plus the HEAD on the download
// url (Content-Length only). Canned bodies mirror the 2.x curl routes. With
// MOCK_CHROME_FAIL=1 every request fails (503), to prove the clean-failure
// path. It writes its CA to -ca and listen address to -addr, serves until
// killed.
package main

import (
	"bufio"
	"crypto/ecdsa"
	"crypto/elliptic"
	"crypto/rand"
	"crypto/tls"
	"crypto/x509"
	"crypto/x509/pkix"
	"encoding/pem"
	"flag"
	"fmt"
	"io"
	"math/big"
	"net"
	"net/http"
	"os"
	"strings"
	"sync"
	"time"
)

type fake struct {
	caCert *x509.Certificate
	caKey  *ecdsa.PrivateKey
	mu     sync.Mutex
	leafs  map[string]*tls.Certificate
}

func main() {
	caFile := flag.String("ca", "", "write CA PEM here")
	addrFile := flag.String("addr", "", "write listen address here")
	flag.Parse()
	key, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	tmpl := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "fake CA"},
		NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(24 * time.Hour), IsCA: true,
		KeyUsage: x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature, BasicConstraintsValid: true}
	der, _ := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
	cert, _ := x509.ParseCertificate(der)
	os.WriteFile(*caFile, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), 0o644)
	f := &fake{caCert: cert, caKey: key, leafs: map[string]*tls.Certificate{}}
	ln, err := net.Listen("tcp4", "127.0.0.1:0")
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	os.WriteFile(*addrFile, []byte(ln.Addr().String()+"\n"), 0o644)
	for {
		c, err := ln.Accept()
		if err != nil {
			return
		}
		go f.conn(c)
	}
}

func (f *fake) leaf(host string) *tls.Certificate {
	f.mu.Lock()
	defer f.mu.Unlock()
	if c, ok := f.leafs[host]; ok {
		return c
	}
	key, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	tmpl := &x509.Certificate{SerialNumber: big.NewInt(time.Now().UnixNano()), Subject: pkix.Name{CommonName: host},
		NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(24 * time.Hour),
		KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, DNSNames: []string{host}}
	der, _ := x509.CreateCertificate(rand.Reader, tmpl, f.caCert, &key.PublicKey, f.caKey)
	c := &tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key}
	f.leafs[host] = c
	return c
}

func (f *fake) conn(c net.Conn) {
	defer c.Close()
	br := bufio.NewReader(c)
	req, err := http.ReadRequest(br)
	if err != nil || req.Method != http.MethodConnect {
		return
	}
	host := req.URL.Host
	name, _, err := net.SplitHostPort(host)
	if err != nil {
		name = host
	}
	io.WriteString(c, "HTTP/1.1 200 Connection established\r\n\r\n")
	tc := tls.Server(&bufConn{Conn: c, r: br}, &tls.Config{Certificates: []tls.Certificate{*f.leaf(name)}, NextProtos: []string{"http/1.1"}})
	if tc.Handshake() != nil {
		return
	}
	tbr := bufio.NewReader(tc)
	for {
		r, err := http.ReadRequest(tbr)
		if err != nil {
			return
		}
		io.Copy(io.Discard, r.Body)
		r.Body.Close()
		url := "https://" + name + r.URL.RequestURI()
		code, body, clen := respond(url)
		resp := &http.Response{StatusCode: code, ProtoMajor: 1, ProtoMinor: 1, Header: http.Header{}, Request: r,
			Close: true, ContentLength: clen, Body: io.NopCloser(strings.NewReader(body))}
		resp.Header.Set("Content-Type", "application/json")
		if r.Method == http.MethodHead {
			resp.Body = http.NoBody
		}
		_ = resp.Write(tc)
		return
	}
}

func respond(url string) (int, string, int64) {
	if os.Getenv("MOCK_CHROME_FAIL") == "1" {
		return 503, "", 0
	}
	switch {
	case strings.Contains(url, "registry.npmjs.org/playwright-core/latest"):
		b := `{"version":"1.56.0"}`
		return 200, b, int64(len(b))
	case strings.Contains(url, "playwright-core@1.56.0/browsers.json"):
		b := `{"browsers":[{"name":"chromium","browserVersion":"1.0.0.0"},{"name":"chromium-headless-shell","revision":"1194","browserVersion":"141.0.7390.37"}]}`
		return 200, b, int64(len(b))
	case strings.Contains(url, "chrome-for-testing/141.0.7390.37.json"):
		b := `{"downloads":{"chrome-headless-shell":[{"platform":"linux64","url":"https://storage.example/141.0.7390.37/linux64/chrome-headless-shell-linux64.zip"}]}}`
		return 200, b, int64(len(b))
	case strings.Contains(url, "storage.example/141.0.7390.37/linux64/chrome-headless-shell-linux64.zip"):
		return 200, "", 104857600
	}
	return 404, "", 0
}

type bufConn struct {
	net.Conn
	r *bufio.Reader
}

func (b *bufConn) Read(p []byte) (int, error) { return b.r.Read(p) }
