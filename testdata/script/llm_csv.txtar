# Gash 3.4. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# llm_csv (new in 3.4, plan D5): the header, a sample and, with --count,
# the row count of a CSV file, through the shim and the binary directly.
# A quoted newline is part of one record (wc -l counts it as a line); the
# delimiter is sniffed; malformed records are listed by their first line;
# secret files are refused. The parser against encoding/csv, chunk
# boundaries and the sniffing are Go tests (internal/llm/csv_test.go).
#
# covers: none (new in 3.4; no 2.x spec)

env GASH_HEADLESS=1

# --- the summary, through the shim and directly
exec bash -c 'source "$GASH_SH"; llm_csv data.csv --head 1'
stdout '^\{"cols":3,"header":\["id","name","note"\],"sample":\[\["1","ann","hello, world"\]\],"delimiter":",","errors":\[\]\}$'
! stderr .
exec gash llm_csv data.csv --count --head 0
stdout '^\{"rows":4,"cols":3,"header":\["id","name","note"\],"sample":\[\],"delimiter":",","errors":\[\{"line":6,"error":"2 fields, header has 3"\}\],"error_count":1\}$'

# --- a filter, a column number, the sniffed semicolon
exec gash llm_csv data.csv --where name=bob --count --head 1
stdout '"rows":4,"matches":1,'
stdout '"sample":\[\["2","bob","two\\nlines"\]\]'
exec gash llm_csv semi.csv --where 1=x --cols
stdout '^\{"cols":2,"header":\["a","b"\],"delimiter":";","errors":\[\]\}$'

# --- rows: the sample under the header, the rest on stderr
exec gash llm_csv data.csv --head 2 --format tsv
cmp stdout sample.tsv
stderr '^\{"delimiter":","\}$'

# --- errors
! exec gash llm_csv data.csv --where nope=1
stderr '"error":"unknown_column","details":"nope","action":"RETRY"'
stderr '"hint":"Columns: id, name, note \(or a 1-based number\)"'
! exec gash llm_csv data.csv --delim ab
stderr '"error":"invalid_delimiter"'
! exec gash llm_csv .env
stderr '"error":"secret_file_blocked"'
! stdout .

# --- help without side effects
exec gash llm_csv --help
stdout 'llm_csv FILE \[--head N\]'

-- data.csv --
id,name,note
1,ann,"hello, world"
2,bob,"two
lines"
3,cy,plain
4,dee
-- semi.csv --
a;b
x;1,5
y;2
-- .env --
TOKEN=x
-- sample.tsv --
id	name	note
1	ann	hello, world
2	bob	two\nlines
