# Gash 3.4. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# agent_docker_exec (new in 3.4, plan P5 and A1): the write half of
# llm_docker_exec, same shape, any command: its words reach docker exec as
# an array, no shell runs, nothing to quote. The llm_exec dangerous-command
# blocklist and the secret-file rule still apply; --dry-run prints the
# docker argv and runs nothing. docker is a stub on PATH that records its
# arguments.
#
# covers: none (new in 3.4; no 2.x spec)

env GASH_HEADLESS=1
env LC_ALL=C
chmod 0755 stub/docker
env PATH=$WORK/stub${:}$PATH

# --- --dry-run and the refusals run nothing
exec gash agent_docker_exec app --dry-run --user www-data -- php artisan migrate --force
stdout '^\{"argv":\["docker","exec","--user=www-data","app","php","artisan","migrate","--force"\],"dry_run":true,"written":false\}$'
! exec gash agent_docker_exec app -- rm -rf /
stderr '"error":"dangerous_command_blocked","details":"Command matches dangerous pattern","action":"FATAL"'
! exec gash agent_docker_exec app -- cp /app/.env /tmp/x
stderr '"error":"secret_file_blocked","details":"/app/.env","action":"FATAL"'
! exists home/calls.log

# --- through the sourced shell: three quoting levels gone, one word with blanks
exec bash -c 'source "$GASH_SH"; agent_docker_exec app -u node -- sh -c "grep -rl \"x y\" /app | head -3"'
stdout '^\{"rc":0,"out":"exec\|--user=node\|app\|sh\|-c\|grep -rl \\"x y\\" /app \| head -3\|\\n","err":""\}$'
! stderr .

# --- directly: the command's own status is rc, gash exits 0
exec gash agent_docker_exec app -- php artisan migrate
stdout '^\{"rc":1,"out":"exec\|app\|php\|artisan\|migrate\|\\n","err":"Nothing to migrate.\\n"\}$'
grep '^exec app php artisan migrate$' home/calls.log

# --- a stopped container: CONTINUE
! exec gash agent_docker_exec db -- ls
stderr '"error":"container_not_running","details":"Error response from daemon: container db is not running","action":"CONTINUE"'

# --- usage errors and help
! exec gash agent_docker_exec app php
stderr '"error":"unexpected_argument"'
! exec gash agent_docker_exec app --
stderr '"error":"missing_command"'
exec gash agent_docker_exec app -h
stdout 'agent_docker_exec CTR'

-- stub/docker --
#!/bin/sh
# docker exec [--user=U] CTR CMD...: app prints the words it got, each
# followed by |; migrate exits 1; db is stopped.
echo "$*" >>"$HOME/calls.log"
[ "$1" = exec ] || exit 3
[ "$2" = db ] && { echo "Error response from daemon: container db is not running" >&2; exit 1; }
printf '%s|' "$@"
echo
case "$*" in *"artisan migrate") echo "Nothing to migrate." >&2; exit 1 ;; esac
exit 0
