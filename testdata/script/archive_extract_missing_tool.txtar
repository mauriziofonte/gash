# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# forced-divergence: FILE-19
# covers: none (3.0 surface)
#
# A missing extraction tool gets the dependency error line, rc 1. 3.0:
# FILE-07 and FILE-03 fixed: the tool is checked before OUTPUT_DIR or any
# output file is created. 3.4: the line is the prerequisite report, here
# its envelope (GASH_HEADLESS=1); it was "Command 'X' is not installed or
# not in PATH.".

env GASH_HEADLESS=1
env LC_ALL=C

mkdir work bin
exec bash -c 'ln -s "$(command -v bash)" bin/bash; printf x > work/a.zip; printf x > work/s.txt.gz'

! exec bash -c 'cd work; PATH=$WORK/bin; source "$GASH_SH"; archive_extract a.zip newdir'
stderr '^\{"error":"prerequisite_missing","details":"archive_extract \(\.zip\) needs unzip, which is not installed",.*"missing":"unzip"'
! exists work/newdir

! exec bash -c 'cd work; PATH=$WORK/bin; source "$GASH_SH"; archive_extract s.txt.gz'
stderr '^\{"error":"prerequisite_missing","details":"archive_extract \(\.gz\) needs gzip, which is not installed",.*"missing":"gzip"'
! exists work/s.txt
