# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: hygiene_spec.sh:120
# covers: hygiene_spec.sh:144
# covers: hygiene_spec.sh:171
#
# Shell hygiene through the shim. :120 (split) headless sourcing with a
# bogus ~/.gash_env prints nothing, keeps PS1/PROMPT_COMMAND and records no
# load errors. :144 every public function answers --help with help on stdout,
# rc 0, and starts no external program (stubbed on PATH). :171 the scanners
# leave no RETURN trap and keep the caller's EXIT trap intact.

env GASH_HEADLESS=1

# --- hygiene_spec.sh:120 - headless prints nothing, prompt untouched
exec bash headless_prompt.sh
stdout '^keep\|keep\|0$'

# --- hygiene_spec.sh:144 - every public function answers --help, no side effects
exec bash help_no_side_effects.sh
stdout '^n=[0-9]+ fails=0$'

# --- hygiene_spec.sh:171 - no RETURN trap left, caller EXIT trap kept
exec bash traps.sh
stdout '^OK$'

-- headless_prompt.sh --
set -euo pipefail
tmp="$WORK/hp"; rm -rf "$tmp"; mkdir -p "$tmp"
ln -s "$GASH_STAGE" "$tmp/.gash"
printf '%s\n' "GASH_BOGUS=1" "nonsense line" >"$tmp/.gash_env"
chmod 600 "$tmp/.gash_env"
HOME="$tmp" GASH_HEADLESS=1 bash --noprofile --norc -c '
  PS1=keep; PROMPT_COMMAND=keep
  source "$HOME/.gash/gash.sh"
  printf "%s|%s|%s" "$PS1" "$PROMPT_COMMAND" "${#__GASH_LOAD_ERRORS[@]}"
'

-- help_no_side_effects.sh --
set -uo pipefail
stubs="$(mktemp -d "$WORK/stubs.XXXXXX")"; log="$stubs/calls.log"
for b in docker git sudo rm curl wget ssh scp rsync systemctl apt apt-get npm composer \
         lsof fuser mv cp chmod chown tar crontab kill pkill php node mysql psql sqlite3 ln mkdir touch; do
  printf '#!/bin/sh\necho "%s $*" >>"%s"\n' "$b" "$log" >"$stubs/$b"
  /bin/chmod +x "$stubs/$b"
done
before="$(declare -F | cut -d' ' -f3)"
export GASH_HEADLESS=1
source "$GASH_SH"
fails=0 n=0
for f in $(declare -F | cut -d' ' -f3 | grep -v '^_'); do
  grep -qx "$f" <<<"$before" && continue
  case "$f" in needs_help | needs_confirm_prompt) continue ;; esac
  n=$((n + 1))
  : >"$log"
  out="$( (PATH="$stubs:$PATH"; "$f" --help) </dev/null 2>&1 )"; rc=$?
  if [[ $rc -ne 0 || -s "$log" || -z "$out" ]]; then
    echo "FAIL $f --help: rc=$rc calls=$(tr '\n' ';' <"$log")" >&2
    fails=$((fails + 1))
  fi
done
((n > 60)) || { echo "too few functions: n=$n"; exit 1; }
echo "n=$n fails=$fails"

-- traps.sh --
set -uo pipefail
tmp="$(mktemp -d "$WORK/traps.XXXXXX")"; mkdir -p "$tmp/d/e"; echo x >"$tmp/d/f"
before="$(trap -p EXIT)"
export GASH_HEADLESS=1
source "$GASH_SH"
for c in files_largest dirs_largest dirs_find_large dirs_list_empty tree_stats; do
  "$c" --json "$tmp/d" >/dev/null 2>&1
  [[ -z "$(trap -p RETURN)" ]] || { echo "$c left: $(trap -p RETURN)"; exit 1; }
done
[[ "$(trap -p EXIT)" == "$before" ]] || { echo "EXIT changed"; exit 1; }
echo OK
