# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: llm_exec_walk_spec.sh:8
# covers: llm_exec_walk_spec.sh:40
# covers: llm_exec_walk_spec.sh:57
# covers: llm_exec_walk_spec.sh:82
# covers: llm_exec_walk_spec.sh:135
# covers: llm_exec_walk_spec.sh:154
# covers: llm_exec_walk_spec.sh:176
# ledger: EXEC-02
#
# llm_exec recursive walks, git contents and the child environment, driven
# through the shim. Reproduces the 2.x observable contract. The split row
# :154 is covered on its runnable public half.

# llm_exec_walk_spec.sh:8 - grep -r, egrep, rg and diff -r leave secret files out
exec bash -c 'set -euo pipefail; d="$WORK/w8"; mkdir -p "$d"; export GASH_HEADLESS=1 HOME="$d"; source "$GASH_SH"; cd "$d"; mkdir -p p/sub/.ssh p/.config/gcloud empty; printf ''PASSWORD=env\n'' >p/.env; printf ''PASSWORD=local\n'' >p/sub/.ENV.local; printf ''PASSWORD=key\n'' >p/sub/.ssh/notes; printf ''PASSWORD=gcloud\n'' >p/.config/gcloud/adc.json; printf ''PASSWORD=cred\n'' >p/sub/credentials; printf ''PASSWORD=ok\n'' >p/app.txt; ln -s "$d/p/.env" p/innocent.txt; for line in "grep -r PASSWORD p" "grep -rn PASSWORD p --include=\\*" "grep -r PASSWORD -- p" "egrep -r PASS p" "fgrep -r PASS p" "diff -rN p empty"; do out="$(llm_exec "$line" 2>&1 || true)"; [[ "$out" == *ok* ]] || { echo "nothing found: $line: $out"; exit 1; }; for leak in env local key gcloud cred; do [[ "$out" != *"PASSWORD=$leak"* ]] || { echo "leak ($leak): $line: $out"; exit 1; }; done; done; if command -v rg >/dev/null 2>&1; then for line in "rg PASSWORD p" "rg -uuu PASSWORD p" "rg -uuu PASSWORD p -g *.txt -g *.local" "rg PASSWORD -- p"; do out="$(llm_exec "$line" 2>&1 || true)"; [[ "$out" == *PASSWORD=ok* && "$out" != *PASSWORD=env* && "$out" != *PASSWORD=local* && "$out" != *PASSWORD=key* ]] || { echo "rg: $line: $out"; exit 1; }; done; fi'

# llm_exec_walk_spec.sh:40 - walks that follow symlinks are refused
exec bash -c 'set -euo pipefail; d="$WORK/w40"; mkdir -p "$d"; export GASH_HEADLESS=1 HOME="$d"; source "$GASH_SH"; cd "$d"; mkdir p; v(){ llm_exec "$1" 2>&1 >/dev/null | jq -r .error; }; for line in "grep -R x p" "grep -rnR x p" "grep --dereference-recursive x p" "rg -L x p" "rg --follow x p" "find -L p" "find p -follow" "find p -files0-from list" "ls -RL p" "tree -l p" "du -L p" "fd -L x p"; do [[ "$(v "$line")" == option_not_allowed ]] || { echo "not refused: $line"; exit 1; }; done; [[ "$(llm_exec "ls -L p && echo ok")" == ok ]]'

# llm_exec_walk_spec.sh:57 - walks cannot start at / or above a protected tree
exec bash -c 'set -euo pipefail; d="$WORK/w57"; mkdir -p "$d"; export GASH_HEADLESS=1 HOME="$d"; source "$GASH_SH"; cd "$d"; mkdir -p p/d; ln -s / p/rootlink; v(){ llm_exec "$1" 2>&1 >/dev/null | jq -r .error; }; for line in "grep -r PASS /" "grep -r PASS /etc" "grep -d recurse PASS /" "rg PASS /" "rg -e PASS /etc" "find / -name x" "ls -R /" "du -sh /" "tree /" "fd x /" "fd x --search-path /" "diff -r / p" "ls -R p/rootlink" "cd / && grep -r PASS" "cd / && find . -name x" "cd / && rg PASS"; do [[ "$(v "$line")" == forbidden_path ]] || { echo "not refused: $line"; exit 1; }; done; err="$(llm_exec "find / -name x" 2>&1 >/dev/null || true)"; jq -e ''.action == "FATAL" and .details == "find /"'' <<<"$err" >/dev/null; llm_exec "find /etc -maxdepth 0" >/dev/null; llm_exec "ls / >/dev/null"; [[ "$(llm_exec "cd / && find $d/p -name d")" == "$d/p/d" ]]; [[ "$(llm_exec "grep -r -e / p || echo none")" == none ]]'

# llm_exec_walk_spec.sh:82 - git commands that print contents leave secret files out
exec bash -c 'set -euo pipefail; d="$WORK/w82"; mkdir -p "$d"; export GASH_HEADLESS=1 HOME="$d" GIT_AUTHOR_DATE=''1700000000 +0000'' GIT_COMMITTER_DATE=''1700000000 +0000''; source "$GASH_SH"; cd "$d"; git init -q r; cd r; git config user.email t@t; git config user.name t; mkdir -p sub/.ssh; printf ''PASSWORD=env\n'' >.env; printf ''PASSWORD=local\n'' >.ENV.local; printf ''PASSWORD=key\n'' >sub/.ssh/notes; printf ''PASSWORD=ok\n'' >app.txt; git add -A; git commit -qm one; printf ''PASSWORD=env2\n'' >.env; printf ''PASSWORD=ok2\n'' >app.txt; git commit -qam two; v(){ llm_exec "$1" 2>&1 >/dev/null | jq -r .error; }; for line in "git grep PASSWORD" "git grep -h PASSWORD HEAD~1" "git grep PASSWORD -- ." "git log -p" "git log --all -p --format=%s" "git show" "git show HEAD~1" "git diff HEAD~1 HEAD" "git reflog -p" "git -C $d/r log -p"; do out="$(llm_exec "$line" 2>&1 || true)"; [[ "$out" == *PASSWORD=ok* ]] || { echo "nothing found: $line: $out"; exit 1; }; [[ "$out" != *PASSWORD=env* && "$out" != *PASSWORD=local* && "$out" != *PASSWORD=key* ]] || { echo "leak: $line: $out"; exit 1; }; done; out="$(llm_exec "git whatchanged -p" 2>&1 || true)"; [[ "$out" != *PASSWORD=env* && "$out" != *PASSWORD=local* && "$out" != *PASSWORD=key* ]]; [[ "$(llm_exec "git log --oneline" | wc -l)" -eq 2 ]]; [[ "$(llm_exec "git show HEAD:app.txt")" == PASSWORD=ok2 ]]; [[ "$(v "git show HEAD:.ENV.local")" == secret_file_blocked ]]; [[ "$(v "git log -L1,1:.ENV.local")" == secret_file_blocked ]]; blob="$(git rev-parse HEAD:.env)"; for line in "git show $blob" "git cat-file -p $blob" "git cat-file blob $blob" "git diff $blob $(git rev-parse HEAD~1:.env)"; do [[ "$(v "$line")" == option_not_allowed ]] || { echo "not refused: $line"; exit 1; }; done; [[ "$(llm_exec "git cat-file -t $blob")" == blob ]]; for line in "git --literal-pathspecs log -p" "git grep --no-index PASS" "git diff --no-index . $d" "git cat-file --batch" "git stash show -p" "git stash list -p" "git remote show origin"; do [[ "$(v "$line")" == option_not_allowed ]] || { echo "not refused: $line"; exit 1; }; done'

# llm_exec_walk_spec.sh:135 - git in llm_exec takes no optional locks: status does not write the index
exec bash -c 'set -euo pipefail; d="$WORK/w135"; mkdir -p "$d"; export GASH_HEADLESS=1 HOME="$d"; source "$GASH_SH"; cd "$d"; git init -q r; cd r; git config user.email t@t; git config user.name t; printf ''a\n'' >f; git add f; touch -t 200101010000 f; before="$(cksum <.git/index)"; llm_exec "git status --short" >/dev/null; llm_git_status . >/dev/null; [[ "$(cksum <.git/index)" == "$before" ]]'

# llm_exec_walk_spec.sh:154 - the llm_exec child gets a short allowlisted environment (split: unrestricted-mode passthrough half)
exec bash -c 'set -euo pipefail; d="$WORK/w154"; mkdir -p "$d"; export GASH_HEADLESS=1 HOME="$d"; source "$GASH_SH"; cd "$d"; export MY_API_TOKEN=sekrit GH_PAT=ghp_x LC_TIME=C.UTF-8 RIPGREP_CONFIG_PATH="$d/rgrc" POSIXLY_CORRECT=1; env="$(llm_exec "jq -nc env")"; jq -e ''.MY_API_TOKEN == null and .GH_PAT == null and .RIPGREP_CONFIG_PATH == null and .POSIXLY_CORRECT == null'' <<<"$env" >/dev/null; jq -e ".HOME == \"$d\" and .PATH == \"$PATH\" and .LC_TIME == \"C.UTF-8\" and .GIT_OPTIONAL_LOCKS == \"0\"" <<<"$env" >/dev/null; [[ "$(llm_exec "jq -n env.MY_API_TOKEN")" == null ]]; [[ "$(llm_exec "ps eww" 2>&1 >/dev/null | jq -r .error)" == option_not_allowed ]]; [[ "$(llm_exec "ps auxe" 2>&1 >/dev/null | jq -r .error)" == option_not_allowed ]]; llm_exec "ps -o pid,etime -p $$" >/dev/null; printf ''GASH_LLM_EXEC=unrestricted\n'' >"$d/.gash_env"; [[ "$(llm_exec "jq -nr env.MY_API_TOKEN")" == sekrit ]]'

# llm_exec_walk_spec.sh:176 - yq load functions and split files, getent shadow are refused
exec bash -c 'set -euo pipefail; d="$WORK/w176"; mkdir -p "$d"; export GASH_HEADLESS=1 HOME="$d"; source "$GASH_SH"; cd "$d"; v(){ llm_exec "$1" 2>&1 >/dev/null | jq -r .error; }; for line in "yq -n ''load(\"x.yml\")''" "yq ''.a = load_str(\"f\")'' a.yml" "yq -s .a a.yml" "yq --split-exp .a a.yml"; do [[ "$(v "$line")" == option_not_allowed ]] || { echo "not refused: $line"; exit 1; }; done; [[ "$(v "getent shadow")" == forbidden_path ]]; [[ "$(v "getent gshadow root")" == forbidden_path ]]'
