# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: none (3.0 fix proof)
# ledger: DOCK-03
#
# Completion offers the flags the functions accept: --yes for
# docker_compose_upgrade (required headless), the confirmation flag on the
# confirmed docker and git functions, -m for git_sync, the remote_* flags.
# 3.5: the binary reads them from each command's help ("-" offers each
# option once, by its long name), for the former names and the shortcuts
# alike; an option already given is not offered again.

env GASH_HEADLESS=1

exec bash -c 'source "$GASH_SH"; source "$GASH_STAGE/bash_completion"; c() { COMP_WORDS=("$@"); COMP_CWORD=$(($# - 1)); COMPREPLY=(); __gash_complete; local v o=(); for v in "${COMPREPLY[@]}"; do o+=("${v%% *}"); done; echo "$1 ${o[*]}"; }; c docker_compose_upgrade --y; c docker_prune_all -; c docker_stop_all -; c git_repair -; c git_sync -; c git_add_tag -; c remote_push -; c remote_sync_pull --; c remote_exec --s; c dpa -y -'
stdout '^docker_compose_upgrade --yes$'
stdout '^docker_prune_all -y --dry-run --help$'
stdout '^docker_stop_all -y --help$'
stdout '^git_repair --yes --dry-run --help$'
stdout '^git_sync -m --no-push --dry-run --yes --help$'
stdout '^git_add_tag --yes --dry-run --help$'
stdout '^remote_push --recursive --preserve --no-progress --force --help$'
stdout '^remote_sync_pull --delete --exclude --dry-run --no-progress --force --help$'
stdout '^remote_exec --script$'
stdout '^dpa --dry-run --help$'
