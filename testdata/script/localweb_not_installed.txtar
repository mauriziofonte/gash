# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
# covers: none (3.0 HTE surface; no 2.x spec)
# Before install, every command that needs it fails with
# localweb_not_installed (STOP; hte_not_installed before 4.1), in text and
# JSON alike. As root they are root_not_allowed first (hte_refusals.txtar).
# gash hte, deprecated in 4.1, runs gash localweb and says so on stderr,
# except in headless mode and with GASH_LEGACY_HINTS=0.

[root] skip 'as root these commands are root_not_allowed'

! exec gash localweb site list
! stdout .
stderr '^\{"error":"localweb_not_installed","details":"'${WORK@R}'/home/\.config/gash/localweb/localweb\.toml does not exist","action":"STOP","recoverable":true,"hint":"run gash localweb install"\}$'

! exec gash localweb --json service status
! stdout .
stderr '^\{"error":"localweb_not_installed",'

! exec gash localweb apache config path
stderr '^\{"error":"localweb_not_installed",'

! exec gash localweb hosts check --json
stderr '^\{"error":"localweb_not_installed",'

! exec gash hte site list
! stdout .
stderr -count=1 '^warning: gash hte is deprecated and goes away in Gash 5\.0: use gash localweb$'
stderr '^\{"error":"localweb_not_installed",'

env GASH_HEADLESS=1
! exec gash hte site list
! stderr 'deprecated'
env GASH_HEADLESS=
env GASH_LEGACY_HINTS=0
! exec gash hte site list
! stderr 'deprecated'
env GASH_LEGACY_HINTS=

# The hidden root step refuses to run as anyone but root: its session
# answers with the error, and stderr says it. Under its 4.0 name (the root
# step of an older binary) it prints no deprecation either.
! exec gash localweb __root
stdout '^\{"id":0,"ok":false,.*"error":\{"code":"privileged_step_required"'
stderr '^privileged_step_required: the root step must run as root$'
! exec gash hte __root
! stderr 'deprecated'
