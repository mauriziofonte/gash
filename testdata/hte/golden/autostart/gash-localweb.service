# Managed by gash localweb install; gash localweb uninstall removes it.
[Unit]
Description=Gash localweb userland web stack (Apache and PHP-FPM)

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart="/home/me/.local/bin/gash" "localweb" "__unit" "start"
ExecStop="/home/me/.local/bin/gash" "localweb" "__unit" "stop"
TimeoutStartSec=120

[Install]
WantedBy=default.target
