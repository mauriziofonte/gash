#!/usr/bin/env bash

# Bash completion for Gash functions

# Ensure that Gash functions are available by checking for one core Gash function.
if ! declare -F git_add_tag >/dev/null 2>&1; then
    return
fi

((${__GASH_TIMING:-0})) && __gash_completion_t0="$EPOCHREALTIME"

# -----------------------------------------------------------------------------
# Completion Function
# -----------------------------------------------------------------------------

# Completion handler for Gash functions.
# Dispatches to per-function completion based on COMP_WORDS[0].
__gash_complete() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local cmd="${COMP_WORDS[0]}"

    # A Gash alias (gsync, chri, flf...) completes like its function.
    local expansion
    if expansion="$(alias "$cmd" 2>/dev/null)"; then
        expansion="${expansion#*=\'}"
        cmd="${expansion%%[\' ]*}"
    fi

    case "$cmd" in
        # Git tag completion
        git_add_tag | git_delete_tag | git_list_tags)
            if type -P git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
                mapfile -t COMPREPLY < <(compgen -W "$(git tag -l 2>/dev/null)" -- "$cur")
            else
                COMPREPLY=()
            fi
            ;;

        # files_largest: directories + flags
        files_largest)
            if [[ "$cur" == -* ]]; then
                mapfile -t COMPREPLY < <(compgen -W "--limit --min-size --exclude --depth --no-ignore --xdev --follow-symlinks --allow-root --json --null --human --no-human --no-color --help" -- "$cur")
            else
                mapfile -t COMPREPLY < <(compgen -d -- "$cur")
            fi
            ;;

        # dirs_largest: directories + flags
        dirs_largest)
            if [[ "$cur" == -* ]]; then
                mapfile -t COMPREPLY < <(compgen -W "--limit --depth --min-size --exclude --no-ignore --xdev --allow-root --json --null --human --no-human --no-color --help" -- "$cur")
            else
                mapfile -t COMPREPLY < <(compgen -d -- "$cur")
            fi
            ;;

        # dirs_find_large: directories + flags
        dirs_find_large)
            if [[ "$cur" == -* ]]; then
                mapfile -t COMPREPLY < <(compgen -W "--size --depth --limit --exclude --no-ignore --xdev --allow-root --with-mtime --json --null --human --no-human --no-color --help" -- "$cur")
            else
                mapfile -t COMPREPLY < <(compgen -d -- "$cur")
            fi
            ;;

        # dirs_list_empty: directories + flags
        dirs_list_empty)
            if [[ "$cur" == -* ]]; then
                mapfile -t COMPREPLY < <(compgen -W "--min-depth --depth --exclude --ignore-dotfiles --no-ignore --xdev --allow-root --null --count --json --help" -- "$cur")
            else
                mapfile -t COMPREPLY < <(compgen -d -- "$cur")
            fi
            ;;

        # tree_stats: directories + flags
        tree_stats)
            if [[ "$cur" == -* ]]; then
                mapfile -t COMPREPLY < <(compgen -W "--depth --top --exclude --no-ignore --xdev --follow-symlinks --allow-root --json --no-color --help" -- "$cur")
            else
                mapfile -t COMPREPLY < <(compgen -d -- "$cur")
            fi
            ;;

        # Directory completion (other)
        mkdir_cd)
            mapfile -t COMPREPLY < <(compgen -d -- "$cur")
            ;;

        # File completion
        archive_extract | file_backup | git_dump_revisions)
            mapfile -t COMPREPLY < <(compgen -f -- "$cur")
            ;;

        # Gash reference card topics
        gash)
            local topics="all help" entry
            for entry in "${__GASH_CARD_TOPICS[@]}"; do topics+=" ${entry%%|*}"; done
            mapfile -t COMPREPLY < <(compgen -W "$topics" -- "$cur")
            ;;

        # Upgrades with a plan and one question
        node_upgrade | chrome_headless_update)
            mapfile -t COMPREPLY < <(compgen -W "--yes --dry-run --help" -- "$cur")
            ;;

        git_sync)
            mapfile -t COMPREPLY < <(compgen -W "--message --no-push --dry-run --help" -- "$cur")
            ;;

        wsl_compact)
            mapfile -t COMPREPLY < <(compgen -W "--status --help" -- "$cur")
            ;;

        path_add)
            if [[ "$cur" == -* ]]; then
                mapfile -t COMPREPLY < <(compgen -W "--append --help" -- "$cur")
            else
                mapfile -t COMPREPLY < <(compgen -d -- "$cur")
            fi
            ;;

        # AI provider completion (first argument only)
        ai_ask | ai_query)
            if ((COMP_CWORD == 1)); then
                mapfile -t COMPREPLY < <(compgen -W "claude gemini" -- "$cur")
            else
                COMPREPLY=()
            fi
            ;;

        # AI sysinfo: provider + --raw + --no-color
        ai_sysinfo)
            mapfile -t COMPREPLY < <(compgen -W "claude gemini --raw --no-color" -- "$cur")
            ;;

        # System info sections + flags
        sysinfo)
            mapfile -t COMPREPLY < <(compgen -W "identity storage services auth network security webstack mail infra system all --llm --no-color" -- "$cur")
            ;;

        # disk_usage / ip_public — just --no-color
        disk_usage | ip_public)
            if [[ "$cur" == -* ]]; then
                mapfile -t COMPREPLY < <(compgen -W "--no-color --help" -- "$cur")
            fi
            ;;

        # Docker compose check/upgrade/scan: dirs + flags (incl. --no-color)
        docker_compose_check)
            if [[ "$cur" == -* ]]; then
                mapfile -t COMPREPLY < <(compgen -W "--json --no-color --help" -- "$cur")
            else
                mapfile -t COMPREPLY < <(compgen -d -- "$cur")
            fi
            ;;

        docker_compose_upgrade)
            if [[ "$cur" == -* ]]; then
                mapfile -t COMPREPLY < <(compgen -W "--dry-run --force --no-color --help" -- "$cur")
            else
                mapfile -t COMPREPLY < <(compgen -d -- "$cur")
            fi
            ;;

        docker_compose_scan)
            if [[ "$cur" == -* ]]; then
                mapfile -t COMPREPLY < <(compgen -W "--depth --json --no-color --help" -- "$cur")
            else
                mapfile -t COMPREPLY < <(compgen -d -- "$cur")
            fi
            ;;

        # gash_doctor: --timing, --no-color
        gash_doctor)
            if [[ "$cur" == -* ]]; then
                mapfile -t COMPREPLY < <(compgen -W "--timing --no-color --help" -- "$cur")
            fi
            ;;

        # Help system: function names, aliases, and flags
        gash_help)
            if [[ "$cur" == -* ]]; then
                mapfile -t COMPREPLY < <(compgen -W "--list --search --short --bash --no-color" -- "$cur")
            elif [[ "${COMP_WORDS[1]-}" == "--search" ]] && ((COMP_CWORD == 2)); then
                # After --search, user types keyword freely
                COMPREPLY=()
            elif ((COMP_CWORD == 1)); then
                # Build list from help registry: function names + their aliases
                local funcs=""
                if declare -p __GASH_HELP_REGISTRY &>/dev/null; then
                    funcs="${!__GASH_HELP_REGISTRY[*]}"
                    local fn
                    for fn in ${!__GASH_HELP_ALIASES[*]}; do
                        local aliases="${__GASH_HELP_ALIASES[$fn]}"
                        funcs+=" ${aliases//,/ }"
                    done
                fi
                mapfile -t COMPREPLY < <(compgen -W "$funcs --list --search --short --bash --no-color" -- "$cur")
            else
                COMPREPLY=()
            fi
            ;;

        # Everything else: empty COMPREPLY lets -o default provide file completion
        *)
            COMPREPLY=()
            ;;
    esac
}

# -----------------------------------------------------------------------------
# Enable Completion
# -----------------------------------------------------------------------------

# Activate completion for each public Gash function and for the short
# aliases of the help registry (bash looks completion up by the word typed,
# so an alias needs its own registration).
__gash_enable_completion() {
    local fn
    local -a added=() names=()
    declare -F __gash_added_symbols_to >/dev/null && __gash_added_symbols_to added functions public

    if ((${#added[@]})); then
        for fn in "${added[@]}"; do
            case "$fn" in
                needs_help | needs_confirm_prompt | print_error) ;;
                *) names+=("$fn") ;;
            esac
        done
        if declare -p __GASH_HELP_ALIASES &>/dev/null; then
            local a
            for fn in "${!__GASH_HELP_ALIASES[@]}"; do
                for a in ${__GASH_HELP_ALIASES[$fn]//,/ }; do
                    [[ -n "${BASH_ALIASES[$a]+x}" ]] && names+=("$a")
                done
            done
        fi
        # One call for every name.
        ((${#names[@]})) && complete -o default -F __gash_complete "${names[@]}"
    else
        # Fallback registration for common functions
        local fn_list="git_add_tag git_delete_tag git_list_tags disk_usage files_largest dirs_largest dirs_find_large dirs_list_empty tree_stats history_grep gash_doctor gash archive_extract file_backup"
        for fn in $fn_list; do
            complete -o default -F __gash_complete "$fn"
        done
    fi
}

__gash_enable_completion
unset -f __gash_enable_completion

if [[ -n "${__gash_completion_t0-}" ]]; then
    __gash_time_record "bash_completion" "$__gash_completion_t0"
    unset __gash_completion_t0
fi
