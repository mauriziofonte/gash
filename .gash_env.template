# ~/.gash_env - Gash Environment Configuration
# Copy this file to ~/.gash_env and edit with your values
# IMPORTANT: Set permissions with: chmod 600 ~/.gash_env
#
# Quick setup:
#   cp ~/.gash/.gash_env.template ~/.gash_env
#   chmod 600 ~/.gash_env
#   nano ~/.gash_env
#
# Or use: gash_env_init

# ============================================
# SSH Keys
# ============================================
# Format: SSH:keypath=passphrase
# The key file must exist, otherwise the entry is skipped.
#
# Examples:
# SSH:~/.ssh/id_ed25519=my-passphrase
# SSH:~/.ssh/work_rsa=work-passphrase

# ============================================
# Database Connections (URL format)
# ============================================
# Format: DB:name=driver://user:password@host:port/database
#
# Supported drivers: mysql, mariadb, pgsql
#
# The 'default' connection is used when no -c option is specified.
# Database name in URL is optional (can be specified per-query with -d).
#
# Special characters in password must be URL-encoded:
#   @  →  %40
#   :  →  %3A
#   /  →  %2F
#   #  →  %23
#   %  →  %25
#
# Examples:
# DB:default=mysql://root:password@localhost:3306/myapp
# DB:legacy=mysql://admin:p%40ssw0rd@localhost:3307/old_db
# DB:analytics=pgsql://pguser:secret@localhost:5432/analytics
# DB:remote=mariadb://deploy:s3cr3t@192.168.1.100:3306/production
#
# To test a connection: gash_db_test [connection_name]
# To list connections:  gash_db_list

# ============================================
# AI Providers
# ============================================
# Format: AI:provider=api_token
#
# Supported providers: claude, gemini
#
# Get your API keys:
#   Claude: https://console.anthropic.com/settings/keys
#   Gemini: https://aistudio.google.com/app/apikey
#
# Examples:
# AI:claude=sk-ant-api03-xxxxxxxxxxxx
# AI:gemini=AIzaSyxxxxxxxxxxxxxxxxxx
#
# Usage:
#   ask                  # Interactive chat (uses first provider)
#   ask claude           # Interactive chat with Claude
#   ai_query "question"  # Non-interactive query
#   gash_ai_list         # List configured providers

# ============================================
# Remote Hosts
# ============================================
# Format: HOST:alias=user@host
#
# Named shortcuts for remote_exec/remote_push/remote_pull/remote_sync_push/
# remote_sync_pull. Interactively you can also target any user@host directly
# without registering it here; a registered alias is required when Gash runs
# headless (GASH_HEADLESS=1, e.g. driven by an agent).
#
# Examples:
# HOST:web=root@web.example.com
# HOST:db=deploy@10.0.0.5
#
# To list configured hosts: remote_hosts

# ============================================
# Shell Settings
# ============================================
# Format: GASH_NAME=value   (quotes optional: GASH_NAME="a b")
#
# Only the names below are accepted; anything else is reported with its
# line number and skipped. A variable already set in your environment wins
# over this file, so `GASH_PROMPT=0 bash` works for a one-off shell.
#
# Prompt
# GASH_PROMPT=1            # 0 = keep your own PS1 (history and $? hooks still run)
# GASH_GIT_EXCLUDE=        # colon-separated repository roots without a git
#                          # segment in the prompt (huge repos, dotfile repos)
#
# Startup
# GASH_BANNER=1            # 0 = no banner and quote when a shell opens
# GASH_SHOW_INXI=0         # 1 = short `inxi` system summary at startup
#
# History
# GASH_HISTORY=1           # 0 = leave HISTSIZE/HISTCONTROL/histappend alone
# GASH_HISTORY_SYNC=0      # 1 = share history live between open terminals
#
# Commands
# GASH_SAFETY_ALIASES=1    # 0 = no interactive cp/mv/rm aliases
# GASH_REPLACE_TOOLS=0     # 1 = top->htop, df->pydf, diff->colordiff,
#                          #     less->most, tail->multitail when installed,
#                          #     php/composer -> newest phpX.Y
# GASH_UMASK=              # e.g. 027; empty = keep the system umask
#
# Agents (llm_* functions)
# GASH_DB_TIMEOUT=30       # PostgreSQL statement timeout for llm_db_*, seconds
# GASH_LLM_EXEC=           # unrestricted = llm_exec runs any command line
#                          #     (the dangerous-pattern blocklist still applies)
# GASH_LLM_EXEC_ALLOW=     # extra commands for llm_exec, e.g. "make npm"
# GASH_LLM_SANDBOX=0       # 1 = llm_exec runs inside bwrap: read-only
#                          #     filesystem, no network
#                          # These three are read from this file only, never
#                          # from the environment.
#
# AI (ask, ai_query, ai_sysinfo)
# GASH_AI_CONFIRM=auto     # auto = ask before sending data Gash collected
#                          #     (ai_sysinfo); 1 = ask before every request;
#                          #     0 = never ask. Secrets are redacted either way.
# GASH_AI_MODEL_CLAUDE=    # default claude-haiku-4-5
# GASH_AI_MODEL_GEMINI=    # default gemini-2.0-flash
