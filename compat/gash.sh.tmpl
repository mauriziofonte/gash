# -----------------------------------------------------------------------------
# Requirements
# -----------------------------------------------------------------------------

# Bash 4.4 or newer (associative arrays, namerefs, ${var,,}). Written in
# plain sh syntax so that older shells reach the message instead of a parse
# error.
__gash_require_bash_message() {
    echo "Gash requires Bash 4.4 or newer (this is ${BASH_VERSION:-not Bash})." >&2
    echo "On macOS: brew install bash, then use $(brew --prefix 2>/dev/null || echo /opt/homebrew)/bin/bash." >&2
}
if [ -z "${BASH_VERSINFO-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ] ||
    { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
    __gash_require_bash_message
    unset -f __gash_require_bash_message
    return 1 2>/dev/null || exit 1
fi
unset -f __gash_require_bash_message

# Only interactive shells get Gash, unless headless mode is requested.
if [[ $- != *i* && "${GASH_HEADLESS-}" != "1" ]]; then
    return 0
fi

# The exact pre-Gash state of the variables Gash sets or exports, for
# `gash_unload` (SELF-03, SELF-05): taken first, before GASH_DIR and
# GASH_VERSION are assigned, so the user's own GASH_* settings are told
# apart from Gash's. Each entry is "-NAME" (unset before) or the variable's
# declaration as Bash prints it (${NAME@A}); arrays and read-only variables
# are left out (unload leaves them alone), and PROMPT_COMMAND is recorded
# only when unset (the prompt hook removal keeps any other entry).
# Interactive only, first load only; no fork.
if [[ "${GASH_HEADLESS-}" != "1" && -z "${__GASH_SNAPSHOT_TAKEN-}" ]]; then
    __GASH_SNAPSHOT2=()
    for __gash_var in ${!GASH_@} LESSOPEN LESSCLOSE LS_COLORS LSCOLORS PAGER NVM_DIR debian_chroot EDITOR \
        HISTTIMEFORMAT LESS_TERMCAP_mb LESS_TERMCAP_md LESS_TERMCAP_me LESS_TERMCAP_se LESS_TERMCAP_so \
        LESS_TERMCAP_ue LESS_TERMCAP_us PROMPT_COMMAND; do
        if [[ -z "${!__gash_var+x}" ]]; then
            __GASH_SNAPSHOT2+=("-$__gash_var")
        elif [[ "$__gash_var" != PROMPT_COMMAND && "${!__gash_var@a}" != *[aAr]* ]]; then
            __GASH_SNAPSHOT2+=("${!__gash_var@A}")
        fi
    done
    # The user's aliases: a pack alias of the same name is not defined over
    # them (SHELL-09; `gash init bash` emits the guard).
    declare -gA __GASH_USER_ALIASES=()
    for __gash_var in "${!BASH_ALIASES[@]}"; do
        __GASH_USER_ALIASES["$__gash_var"]=1
    done
    unset __gash_var
fi

# -----------------------------------------------------------------------------
# Location and version
# -----------------------------------------------------------------------------

# GASH_DIR is wherever this file lives, so custom install locations and
# symlinked checkouts work without configuration.
__gash_self="${BASH_SOURCE[0]}"
[[ "$__gash_self" == */* ]] || __gash_self="./$__gash_self"
GASH_DIR="${__gash_self%/*}"
[[ "$GASH_DIR" == /* ]] || GASH_DIR="$PWD/${GASH_DIR#./}"
GASH_DIR="${GASH_DIR%/.}"
unset __gash_self

# GASH_VERSION is public: read by modules, scripts and agents.
# shellcheck disable=SC2034
GASH_VERSION="unknown"
# shellcheck disable=SC2034
if [[ -r "$GASH_DIR/VERSION" ]]; then
    IFS= read -r GASH_VERSION <"$GASH_DIR/VERSION" || true
fi

# Files that failed to load, reported by `gash_doctor`.
__GASH_LOAD_ERRORS=()

# Load timing for `gash_doctor --timing`: with GASH_TIMING=1 at load, each
# step's cost goes to __GASH_LOAD_TIMES as "MICROSECONDS LABEL". Needs
# $EPOCHREALTIME (Bash 5.0+); otherwise, and by default, nothing is timed.
__GASH_LOAD_TIMES=()
__GASH_TIMING=0
if [[ "${GASH_TIMING-}" == "1" && -n "${EPOCHREALTIME-}" ]]; then
    __GASH_TIMING=1
    __GASH_T0="$EPOCHREALTIME"
fi

# Usage: __gash_time_record LABEL START  (START: an $EPOCHREALTIME value)
__gash_time_record() {
    local now="${EPOCHREALTIME//[!0-9]/}" start="${2//[!0-9]/}"
    __GASH_LOAD_TIMES+=("$((10#$now - 10#$start)) $1")
}

# The help registry of 2.x is static data in the binary; this marks it as
# loaded for needs_help, as sourcing lib/core/help.sh did.
__GASH_HELP_LOADED=1

# -----------------------------------------------------------------------------
# Loader
# -----------------------------------------------------------------------------

# Source a shim with aliases off (they would be baked into function bodies)
# and, in headless mode, a quiet stderr.
__gash_source() {
    local file="$1" rc=0 aliases_on=0 t0=""
    ((${__GASH_TIMING:-0})) && t0="$EPOCHREALTIME"
    if [[ ! -r "$file" ]]; then
        __GASH_LOAD_ERRORS+=("${file#"$GASH_DIR"/}: missing")
        return 0
    fi
    shopt -q expand_aliases && aliases_on=1
    shopt -u expand_aliases
    if [[ "${GASH_HEADLESS-}" == "1" && "${GASH_DEBUG-}" != "1" ]]; then
        source "$file" 2>/dev/null || rc=$?
    else
        source "$file" || rc=$?
    fi
    ((aliases_on)) && shopt -s expand_aliases
    if ((rc != 0)); then
        __GASH_LOAD_ERRORS+=("${file#"$GASH_DIR"/}: exit $rc")
    fi
    [[ -n "$t0" ]] && __gash_time_record "${file#"$GASH_DIR"/}" "$t0"
    return 0
}

# The names of functions not starting with _, of the other functions and of
# aliases, three lists separated by \x01 lines, into the variable named $1:
# what tells, later, which ones Gash defined. One subshell for all three,
# none when there is nothing to list.
__gash_symbols_now() {
    if compgen -A function -X '__gash_*' >/dev/null || compgen -a >/dev/null; then
        printf -v "$1" '%s' "$(
            compgen -A function -X '_*' || true
            printf '\001\n'
            compgen -A function -X '!_*' || true
            printf '\001\n'
            compgen -a || true
        )"
    else
        printf -v "$1" '\001\n\001'
    fi
}

# From a list made by __gash_symbols_now, the part that holds functions
# (public: those not starting with _) or aliases, into VAR.
# Usage: __gash_symbols_pick VAR LIST functions|aliases [public]
__gash_symbols_pick() {
    # Bytes, not characters (\x01 never occurs inside a UTF-8 character),
    # and offsets instead of ${list#*X}, which is quadratic in bash.
    local LC_ALL=C
    local list="$2" public internal aliases
    public="${list%%$'\001'*}"
    list="${list:${#public}+1}"
    internal="${list%%$'\001'*}"
    aliases="${list:${#internal}+1}"
    case "$3|${4-}" in
        aliases*) printf -v "$1" '%s' "$aliases" ;;
        *"|public") printf -v "$1" '%s' "$public" ;;
        *) printf -v "$1" '%s\n%s' "$public" "$internal" ;;
    esac
}

# Names Gash defined while loading, into the array VAR: present right after
# it loaded (__GASH_POST_SYMBOLS), absent from the snapshot taken before
# (__GASH_PRE_SYMBOLS). "public" leaves out names starting with _.
# Usage: __gash_added_symbols_to VAR functions|aliases [public]
__gash_added_symbols_to() {
    local -n __gas_out="$1"
    # mapfile, not word splitting under `local -` and set -f: Bash 4.4 and
    # 5.0 crash at exit after `local -` ran in an interactive shell.
    local __gas_name __gas_pre __gas_post LC_ALL=C
    local -a __gas_lines=() __gas_kept=()
    __gash_symbols_pick __gas_pre "${__GASH_PRE_SYMBOLS-}" "${2-}" "${3-}"
    __gash_symbols_pick __gas_post "${__GASH_POST_SYMBOLS-}" "${2-}" "${3-}"
    mapfile -t __gas_lines <<<"$__gas_post"
    for __gas_name in ${__gas_lines[@]+"${__gas_lines[@]}"}; do
        [[ -n "$__gas_name" ]] && __gas_kept+=("$__gas_name")
    done
    __gas_out=(${__gas_kept[@]+"${__gas_kept[@]}"})
    # Usually little or nothing existed before: one lookup per name.
    [[ -n "${__gas_pre//$'\n'/}" && ${#__gas_out[@]} -gt 0 ]] || return 0
    local -A __gas_before=()
    mapfile -t __gas_lines <<<"$__gas_pre"
    for __gas_name in ${__gas_lines[@]+"${__gas_lines[@]}"}; do
        [[ -n "$__gas_name" ]] && __gas_before["$__gas_name"]=1
    done
    __gas_kept=()
    for __gas_name in "${__gas_out[@]}"; do
        [[ -n "${__gas_before["$__gas_name"]+x}" ]] || __gas_kept+=("$__gas_name")
    done
    __gas_out=(${__gas_kept[@]+"${__gas_kept[@]}"})
    return 0
}

# Snapshot the pre-Gash state for `gash_unload` now, before Gash defines a
# single function, alias or changes a variable, so the whole Gash surface
# counts as "added" and is removed on unload (2.x took it here too, in its
# interactive section). Interactive only; not on a re-source (the first
# load's pre-Gash state is kept).
((__GASH_TIMING)) && __GASH_T1="$EPOCHREALTIME"
if [[ "${GASH_HEADLESS-}" != "1" && -z "${__GASH_SNAPSHOT_TAKEN-}" ]]; then
    __GASH_SNAPSHOT_TAKEN=1
    __GASH_SNAPSHOT=()
    for __gash_var in PS1 PS2 HISTCONTROL HISTTIMEFORMAT HISTSIZE HISTFILESIZE EDITOR PATH; do
        if [[ -n "${!__gash_var+x}" ]]; then
            __GASH_SNAPSHOT+=("$__gash_var=${!__gash_var}")
        else
            __GASH_SNAPSHOT+=("$__gash_var")
        fi
    done
    shopt -q histappend && __GASH_SNAPSHOT+=("shopt:histappend=1") || __GASH_SNAPSHOT+=("shopt:histappend=0")
    shopt -q checkwinsize && __GASH_SNAPSHOT+=("shopt:checkwinsize=1") || __GASH_SNAPSHOT+=("shopt:checkwinsize=0")
    __gash_symbols_now __GASH_PRE_SYMBOLS
    unset __gash_var
fi
((__GASH_TIMING)) && __gash_time_record "gash.sh: snapshot" "$__GASH_T1"

# The bootstrap first (binary resolution, __gash_call), then the four core
# shims, in the 2.x order.
__gash_source "$GASH_DIR/lib/compat/bootstrap.sh"
__gash_source "$GASH_DIR/lib/core/output.sh"
__gash_source "$GASH_DIR/lib/core/utils.sh"
__gash_source "$GASH_DIR/lib/core/validation.sh"
__gash_source "$GASH_DIR/lib/core/config.sh"

# -----------------------------------------------------------------------------
# Functions of the modules (they run in the gash binary)
# -----------------------------------------------------------------------------

# Each module's functions are timed under the name of its 2.x file.
{{% range .Modules %}}
# {{% .Name %}}
((__GASH_TIMING)) && __GASH_T1="$EPOCHREALTIME"
{{%- range .Stubs %}}
{{% stub . %}}
{{%- end %}}
((__GASH_TIMING)) && __gash_time_record "lib/modules/{{% .Name %}}.sh" "$__GASH_T1"
{{% end %}}
# -----------------------------------------------------------------------------
# Module short aliases (defined in headless mode too: agent contract)
# -----------------------------------------------------------------------------
{{% range .ModuleAliases %}}
{{%- if .Condition %}}
if {{% .Condition %}}; then
    alias {{% .Definition %}}
fi
{{%- else %}}
alias {{% .Definition %}}
{{%- end %}}
{{%- end %}}

# -----------------------------------------------------------------------------
# Headless mode
# -----------------------------------------------------------------------------

# Settings from ~/.gash_env that change what functions do; the ones that
# shape the interactive shell (prompt, history, umask, aliases) mean
# nothing here. 2.x applied this subset in its headless branch, so a
# sourcing shell sees them as variables (and passes them to the binary).
# With GASH_DEBUG=1 the file is loaded now and its warnings are shown;
# without, the four values are read in-shell with no binary start while
# sourcing, and the first stub parses the file for its warnings later,
# quietly (LEDGER CORE-18).
if [[ "${GASH_HEADLESS-}" == "1" ]]; then
    if [[ "${GASH_DEBUG-}" == "1" ]]; then
        declare -F __gash_load_env >/dev/null && __gash_load_env
        declare -F __gash_apply_settings >/dev/null &&
            __gash_apply_settings GASH_DB_TIMEOUT GASH_AI_CONFIRM GASH_AI_MODEL_CLAUDE GASH_AI_MODEL_GEMINI
    else
        __GASH_ENV_QUIET=1
        declare -F __gash_apply_env_settings >/dev/null &&
            __gash_apply_env_settings GASH_DB_TIMEOUT GASH_AI_CONFIRM GASH_AI_MODEL_CLAUDE GASH_AI_MODEL_GEMINI
    fi
    return 0
fi

# -----------------------------------------------------------------------------
# Interactive mode
# -----------------------------------------------------------------------------

# The interactive layer (prompt, history, terminal, toolchains, alias packs,
# banner, SSH unlock) comes from the binary, evaluated here at top level.
# Without a binary: one stderr line, and the stubs answer binary_not_found.
((__GASH_TIMING)) && __GASH_T1="$EPOCHREALTIME"
if __gash_bin_resolve || __gash_fetch loud; then
    if declare -F __gash_stdout_tty >/dev/null && __gash_stdout_tty; then __gash_tty_out=1; else __gash_tty_out=0; fi
    if __gash_init="$(__gash_export_state __init && GASH__TTY_OUT=$__gash_tty_out "$__GASH_BIN" init bash)"; then
        __gash_aliases_on=0
        shopt -q expand_aliases && __gash_aliases_on=1
        shopt -u expand_aliases
        eval "$__gash_init" || __GASH_LOAD_ERRORS+=("gash init bash: exit $?")
        ((__gash_aliases_on)) && shopt -s expand_aliases
        unset __gash_aliases_on
    else
        __GASH_LOAD_ERRORS+=("gash init bash: exit $?")
    fi
    unset __gash_init __gash_tty_out
fi
((__GASH_TIMING)) && __gash_time_record "gash init bash" "$__GASH_T1"

# Record what exists after loading; `gash_unload` removes what is here but
# was not in the snapshot taken before.
if [[ -z "${__GASH_POST_SYMBOLS-}" ]]; then
    ((__GASH_TIMING)) && __GASH_T1="$EPOCHREALTIME"
    __gash_symbols_now __GASH_POST_SYMBOLS
    ((__GASH_TIMING)) && __gash_time_record "gash.sh: symbol list" "$__GASH_T1"
fi

# User customizations, last so they can override anything above.
# ~/.bash_aliases is sourced only when none of the files that are sourcing
# this one (~/.bashrc, ~/.gashrc...) sources it itself, as many distribution
# ~/.bashrc files do: it then runs once (3.0: SHELL-05 fixed; 2.x ran it
# twice). Pack aliases never replace the user's (SHELL-09), so its aliases
# still win when it ran before Gash.
((__GASH_TIMING)) && __GASH_T1="$EPOCHREALTIME"
__gash_aliases_sourced=0
__gash_re='(^|[[:space:];])(\.|source)[[:space:]]+["'"'"']?(~|\$HOME|\$\{HOME\})/\.bash_aliases(["'"'"'[:space:];]|$)'
for ((__gash_i = 1; __gash_i < ${#BASH_SOURCE[@]}; __gash_i++)); do
    [[ -f "${BASH_SOURCE[__gash_i]}" && -r "${BASH_SOURCE[__gash_i]}" ]] || continue
    mapfile -t __gash_lines <"${BASH_SOURCE[__gash_i]}" 2>/dev/null || continue
    for __gash_line in "${__gash_lines[@]}"; do
        [[ "$__gash_line" =~ ^[[:space:]]*# ]] && continue
        if [[ "$__gash_line" =~ $__gash_re ]]; then
            __gash_aliases_sourced=1
            break 2
        fi
    done
done
unset __gash_i __gash_lines __gash_line __gash_re
((__gash_aliases_sourced)) || { [[ -f "$HOME/.bash_aliases" ]] && source "$HOME/.bash_aliases"; }
unset __gash_aliases_sourced
[[ -f "$HOME/.bash_local" ]] && source "$HOME/.bash_local"
((__GASH_TIMING)) && __gash_time_record "user files: ~/.bash_aliases, ~/.bash_local" "$__GASH_T1"

((__GASH_TIMING)) && __gash_time_record "gash.sh (total)" "$__GASH_T0"

# Keep the file's status 0: a `set -e` caller sourcing ~/.gashrc must not
# die because the last optional file was missing.
true
