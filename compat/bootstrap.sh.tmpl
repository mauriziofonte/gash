#!/usr/bin/env bash
# Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# Generated by `gash __compat generate` from go-impl/compat/bootstrap.sh.tmpl:
# do not edit.
#
# Gash 3.x compat bootstrap, sourced by gash.sh and by every shim file:
#
#   - binary resolution with string operations only (no forks):
#     GASH_BIN when set and executable, else
#     ${XDG_DATA_HOME:-$HOME/.local/share}/gash/versions/<VERSION>/gash;
#   - the first-run fetch of that binary (curl or wget, SHA-256 checked),
#     never at source time in headless mode;
#   - __gash_call, the wrapper of every delegated function: it passes the
#     caller's shell state the 2.x function read and execs the binary;
#   - the missing-binary report (one envelope line for agents, an Error:
#     and a Hint: line for humans), status 1 at call time.
#
# Sourcing it prints nothing and never returns non-zero.

# This checkout: lib/compat/bootstrap.sh -> the directory two levels up.
__GASH_BOOT_DIR="${BASH_SOURCE[0]}"
[[ "$__GASH_BOOT_DIR" == */* ]] || __GASH_BOOT_DIR="./$__GASH_BOOT_DIR"
__GASH_BOOT_DIR="${__GASH_BOOT_DIR%/*}"
case "$__GASH_BOOT_DIR" in
    */lib/compat) __GASH_BOOT_ROOT="${__GASH_BOOT_DIR%/lib/compat}" ;;
    lib/compat) __GASH_BOOT_ROOT="." ;;
    */compat) __GASH_BOOT_ROOT="${__GASH_BOOT_DIR%/compat}/.." ;;
    compat) __GASH_BOOT_ROOT=".." ;;
    .) __GASH_BOOT_ROOT="../.." ;;
    *) __GASH_BOOT_ROOT="$__GASH_BOOT_DIR/../.." ;;
esac
[[ -n "$__GASH_BOOT_ROOT" ]] || __GASH_BOOT_ROOT="/"
[[ "$__GASH_BOOT_ROOT" == /* ]] || __GASH_BOOT_ROOT="$PWD/${__GASH_BOOT_ROOT#./}"
__GASH_BOOT_ROOT="${__GASH_BOOT_ROOT%/.}"
unset __GASH_BOOT_DIR

# A long function of the generated files is a one-line stand-in, so that a
# load does not parse what the shell may never call
# (internal/compatgen/lazy.go):
#
#   NAME() { __gash_cold NAME HASH && "${FUNCNAME[0]}" "$@"; }
#
# The first call defines it from lib/compat/cold/NAME.sh, under the
# stand-in's own name (a copy of the stand-in made under another name
# becomes a copy of the function, the original is left as it is), with
# aliases off as at load, then runs it. A file whose HASH differs (the tree
# was upgraded under this shell) is refused, and so is one that does not
# parse (the stand-in stays, status 1).
__gash_cold() {
    local __gc_def="" __gc_aliases=0 __gc_rc=0 __gc_name="${FUNCNAME[1]-$1}"
    IFS= read -r -d '' __gc_def <"$__GASH_BOOT_ROOT/lib/compat/cold/$1.sh" 2>/dev/null || :
    if [[ "$__gc_def" != *" $2"$'\n'"$1() {"* ]]; then
        printf 'Error: %s: the Gash tree changed since this shell loaded it. Run: source ~/.gashrc\n' "$__gc_name" >&2
        return 1
    fi
    __gc_def="${__gc_def#*" $2"$'\n'}"
    shopt -q expand_aliases && __gc_aliases=1
    shopt -u expand_aliases
    eval "$__gc_name${__gc_def#"$1"}" || __gc_rc=1
    ((__gc_aliases)) && shopt -s expand_aliases
    return "$__gc_rc"
}

# The version this checkout runs: its VERSION file.
__GASH_BOOT_VERSION=""
if [[ -r "$__GASH_BOOT_ROOT/VERSION" ]]; then
    IFS= read -r __GASH_BOOT_VERSION <"$__GASH_BOOT_ROOT/VERSION" || true
fi

# os/arch of the release assets, from $OSTYPE and $HOSTTYPE.
case "${OSTYPE-}" in
    linux*) __GASH_BOOT_OS=linux ;;
    darwin*) __GASH_BOOT_OS=darwin ;;
    *) __GASH_BOOT_OS="" ;;
esac
case "${HOSTTYPE-}" in
    x86_64 | amd64) __GASH_BOOT_ARCH=amd64 ;;
    aarch64 | arm64) __GASH_BOOT_ARCH=arm64 ;;
    *) __GASH_BOOT_ARCH="" ;;
esac

# The shell variables each delegated function passes to the binary, on top
# of the common ones, and the settings among them (GASH__SET lists those
# that are set). From the registry.
__GASH_CALL_COMMON="{{% join .Common " " %}}"
declare -gA __GASH_CALL_VARS=(
{{%- range .CallVars %}}
    [{{% .Name %}}]="{{% join .Vars " " %}}"
{{%- end %}}
)
declare -gA __GASH_CALL_SETTINGS=(
{{%- range .CallSettings %}}
    [{{% .Name %}}]="{{% join .Vars " " %}}"
{{%- end %}}
)

# PATH as the messages name it: a leading HOME, taken literally and
# followed by "/" or the end of PATH, shown as "~"; a trailing "/" of HOME
# is ignored and an empty HOME shows PATH as it is (LEDGER CORE-14; 2.x
# used ${PATH/#$HOME/\~}, which took HOME as a glob pattern).
# Usage: __gash_shown VAR PATH
__gash_shown() {
    local __gsh_p="${2-}" __gsh_h="${HOME-}"
    while [[ "$__gsh_h" == */ ]]; do __gsh_h="${__gsh_h%/}"; done
    if [[ -n "$__gsh_h" && ("$__gsh_p" == "$__gsh_h" || "$__gsh_p" == "$__gsh_h"/*) ]]; then
        __gsh_p="~${__gsh_p#"$__gsh_h"}"
    fi
    printf -v "$1" '%s' "$__gsh_p"
}

# Integer operand of a compat helper (LEDGER CORE-02): VALUE when it is an
# optionally signed run of digits, else 0, the value Bash gives a word that
# names an unset variable. Never evaluated as an expression.
# Usage: __gash_int VAR VALUE
__gash_int() {
    local __gi_v="${2-}"
    __gi_v="${__gi_v#-}"
    if [[ -n "$__gi_v" && "$__gi_v" != *[!0-9]* ]]; then
        printf -v "$1" '%s' "${2-}"
    else
        printf -v "$1" '%s' 0
    fi
}

# The caller's color decision for a compat operation whose streams the
# shim redirects: 1 when __gash_use_color (the caller's own definition, if
# it has one) says colors, else 0. The binary takes it from GASH__COLOR.
# Usage: __gash_color_now VAR
__gash_color_now() {
    printf -v "$1" '%s' 0
    if declare -F __gash_use_color >/dev/null && __gash_use_color; then
        printf -v "$1" '%s' 1
    fi
    return 0
}

# Sets __GASH_BIN to the binary of this checkout; status 1 when it is not
# installed.
__gash_bin_resolve() {
    local __gbr_p
    if [[ -n "${GASH_BIN-}" && -x "$GASH_BIN" && ! -d "$GASH_BIN" ]]; then
        __GASH_BIN="$GASH_BIN"
        return 0
    fi
    __gbr_p="${XDG_DATA_HOME:-$HOME/.local/share}/gash/versions/$__GASH_BOOT_VERSION/gash"
    if [[ -n "$__GASH_BOOT_VERSION" && -x "$__gbr_p" && ! -d "$__gbr_p" ]]; then
        __GASH_BIN="$__gbr_p"
        return 0
    fi
    __GASH_BIN=""
    return 1
}

# The binary, fetched on first use when it is missing. Silent: a failure
# surfaces as the report of the call.
__gash_compat_ready() {
    [[ -n "${__GASH_BIN-}" && -x "$__GASH_BIN" ]] && return 0
    __gash_bin_resolve && return 0
    __gash_fetch quiet >/dev/null 2>&1 || return 1
    __gash_bin_resolve
}

# Why the last fetch failed, for the one interactive line, and the
# prerequisite it lacked (curl, tar, gzip, sha256sum), if that was why.
__GASH_FETCH_REASON=""
__GASH_FETCH_MISSING=""

# Download the binary of this checkout's version (upgrade.md 4).
# Usage: __gash_fetch [quiet|loud]   (loud: one stderr line, success or not)
__gash_fetch() {
    local mode="${1-quiet}" v="$__GASH_BOOT_VERSION" os="$__GASH_BOOT_OS" arch="$__GASH_BOOT_ARCH"
    local base dir lock tmp asset url line want got pin="" hpin="" sumok=0 rc=0 now at
    __GASH_FETCH_REASON=""
    __GASH_FETCH_MISSING=""
    if [[ -z "$v" || "$v" == unknown ]]; then
        __GASH_FETCH_REASON="no VERSION file"
    elif [[ -z "$os" || -z "$arch" ]]; then
        __GASH_FETCH_REASON="no release for ${OSTYPE-?}/${HOSTTYPE-?}"
    elif ! type -P curl >/dev/null 2>&1 && ! type -P wget >/dev/null 2>&1; then
        __GASH_FETCH_MISSING=curl
        __GASH_FETCH_REASON="neither curl nor wget is installed"
    elif ! type -P tar >/dev/null 2>&1; then
        __GASH_FETCH_MISSING=tar
        __GASH_FETCH_REASON="tar is not installed"
    elif [[ "$os" != darwin ]] && ! type -P gzip >/dev/null 2>&1; then
        # GNU tar runs gzip for -z; the bsdtar of macOS does not.
        __GASH_FETCH_MISSING=gzip
        __GASH_FETCH_REASON="gzip is not installed"
    elif ! type -P sha256sum >/dev/null 2>&1 && ! type -P shasum >/dev/null 2>&1; then
        __GASH_FETCH_MISSING=sha256sum
        __GASH_FETCH_REASON="neither sha256sum nor shasum is installed"
    fi
    if [[ -n "$__GASH_FETCH_REASON" ]]; then
        [[ "$mode" == loud ]] && __gash_fetch_line
        return 1
    fi

    base="${XDG_DATA_HOME:-$HOME/.local/share}/gash/versions"
    dir="$base/$v"
    lock="$dir/.lock"
    asset="gash_${v}_${os}_${arch}.tar.gz"
    url="${GASH_RELEASE_URL:-https://github.com/mauriziofonte/gash/releases/download/v$v}"
    url="${url%/}"
    if ! mkdir -p "$dir" 2>/dev/null; then
        __GASH_FETCH_REASON="cannot create $dir"
        [[ "$mode" == loud ]] && __gash_fetch_line
        return 1
    fi
    # One fetch at a time. The lock holds the time it was taken (lock/at,
    # epoch seconds): it is stale after 10 minutes, or when it holds no time
    # 5 seconds on (a fetch that died before writing it, or a 3.3 lock).
    local waited=0
    while ! mkdir "$lock" 2>/dev/null; do
        printf -v now '%(%s)T' -1
        at=""
        [[ -r "$lock/at" ]] && read -r at <"$lock/at" 2>/dev/null
        case "$at" in '' | *[!0-9]*) at="" ;; esac
        if { [[ -n "$at" ]] && ((now - at > 600)); } || { [[ -z "$at" ]] && ((waited >= 5)); }; then
            command rm -rf "$lock" 2>/dev/null && continue
        fi
        if ((waited >= 120)); then
            __GASH_FETCH_REASON="another download holds $lock"
            [[ "$mode" == loud ]] && __gash_fetch_line
            return 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
    printf '%(%s)T\n' -1 >"$lock/at" 2>/dev/null || true
    if __gash_bin_resolve; then
        command rm -rf "$lock" 2>/dev/null || true
        return 0
    fi
    tmp="$dir/.tmp.$$"
    command rm -rf "$tmp" 2>/dev/null || true
    mkdir -p "$tmp" 2>/dev/null || rc=1

    # The pinned SHA-256 of the binaries in this tree (release/SHA256SUMS,
    # lines "HASH  OS_ARCH/gash" and "HASH  OS_ARCH/gash-hosts-helper"),
    # else the release's checksums.txt for the archive; GASH_REQUIRE_SIGNED=1
    # accepts only a pinned binary. The helper is installed only when it is
    # verified: by its pin, else by checksums.txt (never with
    # GASH_REQUIRE_SIGNED=1 and no pin).
    if [[ -r "$__GASH_BOOT_ROOT/release/SHA256SUMS" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%$'\r'}"
            [[ "$line" == *"  ${os}_${arch}/gash" ]] && pin="${line%% *}"
            [[ "$line" == *"  ${os}_${arch}/gash-hosts-helper" ]] && hpin="${line%% *}"
        done <"$__GASH_BOOT_ROOT/release/SHA256SUMS"
    fi
    if ((rc == 0)) && [[ -z "$pin" && "${GASH_REQUIRE_SIGNED-}" == 1 ]]; then
        __GASH_FETCH_REASON="this tree pins no binary for $os/$arch (GASH_REQUIRE_SIGNED=1)"
        rc=1
    fi
    if ((rc == 0)) && ! __gash_fetch_get "$url/$asset" "$tmp/$asset"; then
        __GASH_FETCH_REASON="download failed: $url/$asset"
        rc=1
    fi
    if ((rc == 0)) && [[ -z "$pin" || (-z "$hpin" && "${GASH_REQUIRE_SIGNED-}" != 1) ]]; then
        if ! __gash_fetch_get "$url/checksums.txt" "$tmp/checksums.txt"; then
            # Without a pin the binary cannot be verified; with one, only
            # the helper is left out.
            if [[ -z "$pin" ]]; then
                __GASH_FETCH_REASON="download failed: $url/checksums.txt"
                rc=1
            fi
        else
            want=""
            while IFS= read -r line || [[ -n "$line" ]]; do
                [[ "$line" == *"  $asset" || "$line" == *" *$asset" ]] && want="${line%% *}"
            done <"$tmp/checksums.txt"
            got="$(__gash_fetch_sum "$tmp/$asset")"
            if [[ -z "$want" || "$got" != "$want" ]]; then
                __GASH_FETCH_REASON="checksum mismatch for $asset"
                rc=1
            else
                sumok=1
            fi
        fi
    fi
    if ((rc == 0)) && ! tar -xzf "$tmp/$asset" -C "$tmp" gash 2>/dev/null; then
        __GASH_FETCH_REASON="cannot extract $asset"
        rc=1
    fi
    if ((rc == 0)) && [[ -n "$pin" ]]; then
        got="$(__gash_fetch_sum "$tmp/gash")"
        if [[ "$got" != "$pin" ]]; then
            __GASH_FETCH_REASON="the binary does not match release/SHA256SUMS"
            rc=1
        fi
    fi
    if ((rc == 0)); then
        tar -xzf "$tmp/$asset" -C "$tmp" gash-hosts-helper 2>/dev/null || true
        if [[ -f "$tmp/gash-hosts-helper" && -n "$hpin" ]]; then
            got="$(__gash_fetch_sum "$tmp/gash-hosts-helper")"
            if [[ "$got" != "$hpin" ]]; then
                __GASH_FETCH_REASON="gash-hosts-helper does not match release/SHA256SUMS"
                rc=1
            fi
        elif ((sumok == 0)); then
            command rm -f "$tmp/gash-hosts-helper" 2>/dev/null || true
        fi
    fi
    if ((rc == 0)); then
        chmod 0755 "$tmp/gash" 2>/dev/null || rc=1
        [[ -f "$tmp/gash-hosts-helper" ]] && chmod 0755 "$tmp/gash-hosts-helper" 2>/dev/null
        [[ -f "$tmp/gash-hosts-helper" ]] && mv -f "$tmp/gash-hosts-helper" "$dir/gash-hosts-helper" 2>/dev/null
        if ((rc == 0)) && ! mv -f "$tmp/gash" "$dir/gash" 2>/dev/null; then
            __GASH_FETCH_REASON="cannot install into $dir"
            rc=1
        fi
    fi
    command rm -rf "$tmp" 2>/dev/null || true
    command rm -rf "$lock" 2>/dev/null || true
    ((rc == 0)) && __gash_bin_resolve || rc=1
    [[ "$mode" == loud ]] && __gash_fetch_line
    return "$rc"
}

# Usage: __gash_fetch_get URL FILE
__gash_fetch_get() {
    if type -P curl >/dev/null 2>&1; then
        curl -fsSL --max-time 120 -o "$2" "$1" 2>/dev/null
    else
        wget -q -T 120 -O "$2" "$1" 2>/dev/null
    fi
}

# Usage: __gash_fetch_sum FILE   (prints the lowercase hex SHA-256)
__gash_fetch_sum() {
    local out
    if type -P sha256sum >/dev/null 2>&1; then
        out="$(sha256sum "$1" 2>/dev/null)" || return 1
    else
        out="$(shasum -a 256 "$1" 2>/dev/null)" || return 1
    fi
    printf '%s' "${out%% *}"
}

{{% .PrereqBash %}}
# The core emitters, loaded from this checkout when the caller sourced a
# shim without them (they are the only writers to stderr).
__gash_boot_emitters() {
    if ! declare -F __gash_error >/dev/null && [[ -r "$__GASH_BOOT_ROOT/lib/core/output.sh" ]]; then
        # shellcheck source=/dev/null
        source "$__GASH_BOOT_ROOT/lib/core/output.sh"
    fi
    if ! declare -F __gash_json_error >/dev/null && [[ -r "$__GASH_BOOT_ROOT/lib/core/utils.sh" ]]; then
        # shellcheck source=/dev/null
        source "$__GASH_BOOT_ROOT/lib/core/utils.sh"
    fi
    declare -F __gash_error >/dev/null && declare -F __gash_json_error >/dev/null
}

# The one stderr line of an interactive fetch. The reason is kept across
# the emitters' load: lib/core/utils.sh sources this file again, which
# resets it (a failed fetch then read as a success).
__gash_fetch_line() {
    local __gfl_reason="$__GASH_FETCH_REASON" __gfl_missing="$__GASH_FETCH_MISSING"
    __gash_boot_emitters || return 0
    __GASH_FETCH_REASON="$__gfl_reason"
    __GASH_FETCH_MISSING="$__gfl_missing"
    if [[ -z "$__GASH_FETCH_REASON" ]]; then
        __gash_success "Installed gash $__GASH_BOOT_VERSION for $__GASH_BOOT_OS/$__GASH_BOOT_ARCH"
    else
        __gash_warning "gash $__GASH_BOOT_VERSION is not installed and could not be downloaded ($__GASH_FETCH_REASON). $(__gash_fetch_advice)"
    fi
    return 0
}

# What to do after a failed fetch: the install command of the missing
# prerequisite, else the installer's repair.
__gash_fetch_advice() {
    local cmd
    if [[ -n "$__GASH_FETCH_MISSING" ]]; then
        cmd="$(__gash_install_hint "$__GASH_FETCH_MISSING")"
        if [[ -n "$cmd" ]]; then
            printf 'Install %s: %s' "$__GASH_FETCH_MISSING" "$cmd"
        else
            printf 'Install %s with the package manager of this system' "$__GASH_FETCH_MISSING"
        fi
        return 0
    fi
    printf 'Run: bash %s/install.sh --repair' "${__GASH_BOOT_ROOT/#$HOME/\~}"
}

# The report of a call without a binary: the binary_not_found envelope for
# agents (headless mode, llm_* functions), an Error: and a Hint: line for
# humans. Status 1.
# Usage: __gash_missing NAME
__gash_missing() {
    local details hint cmd="" json reason="$__GASH_FETCH_REASON" missing="$__GASH_FETCH_MISSING"
    details="gash ${__GASH_BOOT_VERSION:-unknown} for ${__GASH_BOOT_OS:-${OSTYPE-unknown}}/${__GASH_BOOT_ARCH:-${HOSTTYPE-unknown}} is not installed and could not be downloaded"
    [[ -n "$reason" ]] && details+=" ($reason)"
    hint="$(__gash_fetch_advice)"
    [[ -n "$missing" ]] && cmd="$(__gash_install_hint "$missing")"
    __gash_boot_emitters || return 1
    __GASH_FETCH_REASON="$reason"
    __GASH_FETCH_MISSING="$missing"
    if [[ "${GASH_HEADLESS-}" == 1 || "${1-}" == llm_* || "${1-}" == agent_* ]]; then
        if [[ -z "$missing" ]]; then
            __gash_json_error binary_not_found "$details" STOP "$hint"
            return 1
        fi
        # A missing prerequisite: the members every such error carries.
        json="{\"error\":\"binary_not_found\",\"details\":\"$(__gash_json_escape "$details")\",\"action\":\"STOP\",\"recoverable\":true"
        json+=",\"hint\":\"$(__gash_json_escape "$hint")\",\"missing\":\"$(__gash_json_escape "$missing")\""
        [[ -n "$cmd" ]] && json+=",\"install\":\"$(__gash_json_escape "$cmd")\""
        printf '%s}\n' "$json" >&2
    else
        __gash_error "$details"
        __gash_hint "$hint"
    fi
    return 1
}

# Export, in the subshell that execs the binary, the shell state NAME's 2.x
# code read: the common variables, NAME's own, and its settings (with
# GASH__SET naming those that are set). GASH__ADDED names the variables
# exported here only, which the binary leaves out of the environment of
# the commands it runs, as 2.x did. The file-only settings never reach the
# binary's environment.
# Usage: __gash_export_state NAME
__gash_export_state() {
    local __ges_v __ges_set="" __ges_add="" __ges_k="${1:-_}" IFS=$' \t\n'
    for __ges_v in $__GASH_CALL_COMMON ${__GASH_CALL_VARS[$__ges_k]-}; do
        [[ -n "${!__ges_v+x}" ]] || continue
        [[ "${!__ges_v@a}" == *x* ]] || __ges_add+="${__ges_add:+ }$__ges_v"
        export "${__ges_v?}"
    done
    for __ges_v in ${__GASH_CALL_SETTINGS[$__ges_k]-}; do
        [[ -n "${!__ges_v+x}" ]] || continue
        [[ "${!__ges_v@a}" == *x* ]] || __ges_add+="${__ges_add:+ }$__ges_v"
        export "${__ges_v?}"
        __ges_set+="${__ges_set:+ }$__ges_v"
    done
    export GASH__SET="$__ges_set" GASH__ADDED="$__ges_add"
    if [[ -n "${__GASH_HELP_LOADED-}" ]]; then
        export GASH__HELP=1
    else
        export GASH__HELP=0
    fi
    export -n GASH_LLM_EXEC GASH_LLM_EXEC_ALLOW GASH_LLM_SANDBOX GASH_REMOTE_NO_BINARY 2>/dev/null || true
}

# The wrapper of every delegated function: the per-shell server runs the
# call when it can, else the binary is exec'd in a subshell.
# Usage: __gash_call NAME [ARG...]
__gash_call() {
    local __gc_name="${1-}"
    shift
    __gash_compat_ready || {
        __gash_missing "$__gc_name"
        return 1
    }
    if [[ "${GASH_SERVER-}" != 0 && -n "${__GASH_SRV_FN[$__gc_name]-}" ]] && __gash_srv_ready; then
        __gash_srv_call "$__gc_name" "$@" && return 0
        local __gc_rc=$?
        ((__GASH_SRV_DECLINED)) || return "$__gc_rc"
    fi
    (
        __gash_export_state "$__gc_name"
        # The gash card is the binary's root: its words go as they are.
        [[ "$__gc_name" == gash ]] && exec "$__GASH_BIN" "$@"
        exec "$__GASH_BIN" "$__gc_name" "$@"
    )
}

# A hidden operation of the binary for the shims (gash __compat OP ...),
# with the common state. Silent when there is no binary: status 127, and
# the caller falls back.
# Usage: __gash_compat OP [ARG...]
__gash_compat() {
    __gash_compat_ready || return 127
    (
        __gash_export_state __compat
        exec "$__GASH_BIN" __compat "$@"
    )
}

# -----------------------------------------------------------------------------
# The per-shell server
# -----------------------------------------------------------------------------

# `gash __serve` runs as a coprocess of this shell and takes the calls the
# shell itself makes (not its subshells: their calls exec the binary), so a
# call costs a file write, a signal and a line read back instead of a fork
# and an exec. The server rebuilds what the exec'd binary would get: the
# environment the shell gives a program it runs (export -p, plus the
# variables the stub exports for the call), the shell's working directory,
# umask and standard streams (taken from the shell's PID), and it declines
# (the call then execs) what it cannot reproduce. Linux only; GASH_SERVER=0
# turns it off.
#
#   __GASH_SRV, __GASH_SRV_PID  the coprocess (set and unset by Bash)
#   __GASH_SRV_OWNER            the shell that started it
#   __GASH_SRV_DIR              its private directory (the request, the INT
#                               trap, a stamp)
#   __GASH_SRV_BIN              the binary it runs
#   __GASH_SRV_FN               the functions it runs

# Stop the server of this shell, if any.
__gash_srv_stop() {
    if [[ -n "${__GASH_SRV_PID-}" && "${__GASH_SRV_OWNER-}" == "$BASHPID" ]]; then
        kill "$__GASH_SRV_PID" 2>/dev/null || true
    fi
    unset __GASH_SRV_OWNER __GASH_SRV_DIR __GASH_SRV_BIN
    return 0
}

# A load stops the server of an earlier one (its binary may differ).
[[ -n "${__GASH_SRV_OWNER-}" ]] && __gash_srv_stop
declare -gA __GASH_SRV_FN=(
{{%- range .Served %}}
    [{{% . %}}]=1
{{%- end %}}
)
__GASH_SRV_STARTS=0
__GASH_SRV_SEQ=0
__GASH_SRV_DECLINED=0
__GASH_SRV_CHECKED=""

# Whether the server can take a call now: it runs, for this shell, the
# current binary; started when it does not (three starts per shell).
__gash_srv_ready() {
    [[ "$BASHPID" == "$$" && "${OSTYPE-}" == linux* ]] || return 1
    if [[ -n "${__GASH_SRV_OWNER-}" ]]; then
        # The binary's mtime is checked once a second at most (at every call
        # on Bash 4.4, which has no EPOCHSECONDS).
        if [[ -n "${__GASH_SRV_PID-}" && "$__GASH_SRV_BIN" == "$__GASH_BIN" ]] &&
            { [[ -n "${EPOCHSECONDS-}" && "$EPOCHSECONDS" == "$__GASH_SRV_CHECKED" ]] || ! [[ "$__GASH_BIN" -nt "$__GASH_SRV_DIR/stamp" ]]; }; then
            __GASH_SRV_CHECKED=${EPOCHSECONDS-}
            return 0
        fi
        __gash_srv_stop
    fi
    ((__GASH_SRV_STARTS < 3)) || return 1
    ((++__GASH_SRV_STARTS))
    local __gs_m=0 __gs_i=0 __gs_o=1 __gs_e=2
    local -a __gs_hello=()
    # The shell's standard streams go to the server as 3, 4 and 5 (for a
    # kernel that does not let it take a call's streams from the shell; no
    # redirection on these exec lines, which Bash would keep). Outside job
    # control the coprocess shares the shell's process group,
    # so Ctrl-C reaches the call it runs; disowned, no job lists it.
    if [[ -e /dev/fd/0 && -e /dev/fd/1 && -e /dev/fd/2 ]]; then
        exec {__gs_i}<&0 {__gs_o}>&1 {__gs_e}>&2
    else
        __gs_i=-
    fi
    [[ $- == *m* ]] && __gs_m=1 && set +m
    if [[ "$__gs_i" == - ]]; then
        { coproc __GASH_SRV { exec "$__GASH_BIN" __serve 2>/dev/null; }; } 2>/dev/null
    else
        { coproc __GASH_SRV { exec "$__GASH_BIN" __serve 3<&"$__gs_i" 4>&"$__gs_o" 5>&"$__gs_e" 2>/dev/null; }; } 2>/dev/null
        exec {__gs_i}<&- {__gs_o}>&- {__gs_e}>&-
    fi
    ((__gs_m)) && set -m
    [[ -n "${__GASH_SRV_PID-}" ]] || return 1
    disown "$__GASH_SRV_PID" 2>/dev/null || true
    if ! IFS=' ' read -r -t 5 -a __gs_hello -u "${__GASH_SRV[0]}" 2>/dev/null ||
        [[ "${__gs_hello[0]-}" != gash-serve || "${__gs_hello[1]-}" != 1 || ! -d "${__gs_hello[2]-}" ]]; then
        kill "$__GASH_SRV_PID" 2>/dev/null || true
        return 1
    fi
    __GASH_SRV_OWNER=$BASHPID
    __GASH_SRV_DIR=${__gs_hello[2]}
    __GASH_SRV_BIN=$__GASH_BIN
    return 0
}

# Run NAME in the server: its status, or __GASH_SRV_DECLINED=1 when the
# server declined the call (nothing ran) or is gone. The request is a file
# in the server's directory: the call, the names of the variables
# __gash_export_state would export, and what umask, declare -p and export
# -p print (the server rebuilds the environment from them: no fork).
# Closing it tells the server; while it runs the call, the shell's
# standard streams are the call's own: no command here redirects them
# (read takes none).
# Usage: __gash_srv_call NAME [ARG...]
__gash_srv_call() {
    local __gs_line="" __gs_v
    __GASH_SRV_DECLINED=1
    [[ -n "${__GASH_SRV_PID-}" && -n "${__GASH_SRV[0]-}" ]] && trap -p INT >"$__GASH_SRV_DIR/trap" 2>/dev/null || {
        __gash_srv_stop
        return 1
    }
    # Ctrl-C is the server's while it runs the call: the shell waits for
    # the status, as it waits for the exec'd binary. The INT trap is put
    # back after.
    trap '' INT
    # Closing the request wakes the server (after the redirection is
    # undone: the streams it takes are the shell's own).
    if {
        printf '%s\0' R "$((++__GASH_SRV_SEQ))" "$BASHPID" "$#" "$__GASH_CALL_COMMON" \
            "${__GASH_CALL_VARS[$1]-}" "${__GASH_CALL_SETTINGS[$1]-}" "$@"
        umask
        __gash_srv_decls "$1"
        printf '\001\n'
        export -p
    } >"$__GASH_SRV_DIR/req" 2>/dev/null; then
        while IFS= read -r -u "${__GASH_SRV[0]}" __gs_line; do
            [[ "${__gs_line%% *}" == "$__GASH_SRV_SEQ" || "${__gs_line%% *}" == "*" ]] && break
            __gs_line=""
        done
    fi
    if [[ -s "$__GASH_SRV_DIR/trap" ]]; then
        source "$__GASH_SRV_DIR/trap"
    else
        trap - INT
    fi
    __gs_v=${__gs_line#* }
    case "$__gs_v" in
        "" | *[!0-9]*)
            # Declined ("F"), or the server is gone: the call execs.
            [[ "$__gs_v" == F ]] || __gash_srv_stop
            return 1
            ;;
    esac
    __GASH_SRV_DECLINED=0
    return "$__gs_v"
}

# The declarations of the variables NAME's stub exports, as the call sees
# them (word splitting with the default IFS here only).
__gash_srv_decls() {
    local IFS=$' \t\n'
    # shellcheck disable=SC2086
    declare -p $__GASH_CALL_COMMON ${__GASH_CALL_VARS[$1]-} ${__GASH_CALL_SETTINGS[$1]-} __GASH_HELP_LOADED
    # Bash 4.4's exec gives the program one SHLVL less: the server does
    # the same from the shell's.
    if ((BASH_VERSINFO[0] < 5)); then
        local __GASH_SRV_SHLVL="${SHLVL-}"
        declare -p __GASH_SRV_SHLVL
    fi
    return 0
}

__gash_bin_resolve || true
