#!/usr/bin/env bash
# Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# Generated by `gash __compat generate` from compat/bash_completion.tmpl:
# do not edit.

# Bash completion for Gash (3.5): one function asks the binary
# (`gash __complete WORDS... PARTIAL`), which knows the command tree, the
# options of every command and the values they take (hosts and databases
# of ~/.gash_env, git tags, containers, units, processes, ports).

# Ensure that Gash functions are available by checking for one core Gash function.
if ! declare -F git_add_tag >/dev/null 2>&1; then
    return
fi

((${__GASH_TIMING:-0})) && __gash_completion_t0="$EPOCHREALTIME"

# The canonical words of each name that completes like a command: the
# former flat names, the llm_*/agent_* names and the shortcuts.
declare -gA __GASH_COMPLETE_WORDS=(
{{%- range .CompleteWords %}}
    [{{% .Name %}}]='{{% .Words %}}'
{{%- end %}}
)

# -----------------------------------------------------------------------------
# Completion Function
# -----------------------------------------------------------------------------

# __gash_complete is the completion of gash and of every name above. The
# words Bash split at "=" and ":" (COMP_WORDBREAKS) are joined back, so
# the binary sees --format=json and node:24 whole; the part Bash does not
# replace is cut from the candidates again. Two or more candidates are
# listed with their descriptions; one is inserted alone.
__gash_complete() {
    local first="${COMP_WORDS[0]}" pre=""
    if [[ "$first" != gash ]]; then
        pre="${__GASH_COMPLETE_WORDS[$first]-}"
        [[ -n "$pre" ]] || return 0
    fi
    local bin="${__GASH_BIN-}"
    if [[ -z "$bin" || ! -x "$bin" ]]; then
        __gash_bin_resolve 2>/dev/null || return 0
        bin="${__GASH_BIN-}"
    fi
    local -a words=() pw=()
    [[ -n "$pre" ]] && read -r -a pw <<<"$pre"
    local i w joined=0
    for ((i = 1; i <= COMP_CWORD; i++)); do
        w="${COMP_WORDS[i]-}"
        if ((${#words[@]} > 0)) && { [[ "$w" == "=" || "$w" == ":" ]] || ((joined)); }; then
            words[${#words[@]} - 1]+="$w"
            joined=0
            [[ "$w" == "=" || "$w" == ":" ]] && joined=1
        else
            words+=("$w")
            joined=0
        fi
    done
    local cur="${words[${#words[@]} - 1]-}"
    unset 'words[${#words[@]} - 1]'
    local out
    out="$("$bin" __complete "${pw[@]}" "${words[@]}" "$cur" 2>/dev/null)" || return 0
    local line directive=0 offset=-1
    local -a values=()
    while IFS= read -r line; do
        case "$line" in
            :*) directive="${line#:}" ;;
            '!offset '*) offset="${line#!offset }" ;;
            *) values+=("$line") ;;
        esac
    done <<<"$out"
    if ((offset >= 0)); then
        # A command line of its own (gash run -- CMD): complete it as that
        # command, with the completion Bash has for it.
        local at=$((offset - ${#pw[@]} + 1))
        if ((at >= COMP_CWORD)); then
            mapfile -t COMPREPLY < <(compgen -c -- "${COMP_WORDS[COMP_CWORD]}")
        elif declare -F _command_offset >/dev/null 2>&1; then
            _command_offset "$at"
        else
            compopt -o default 2>/dev/null
            COMPREPLY=()
        fi
        return 0
    fi
    ((directive & 2)) && compopt -o nospace 2>/dev/null
    ((directive & 32)) && compopt -o nosort 2>/dev/null
    if ((directive & 16)); then
        compopt +o default 2>/dev/null
        mapfile -t COMPREPLY < <(compgen -d -- "$cur")
        return 0
    fi
    if ((${#values[@]} == 0)); then
        # No candidate: files unless the binary said none.
        ((directive & 4)) && compopt +o default 2>/dev/null
        COMPREPLY=()
        return 0
    fi
    compopt +o default 2>/dev/null
    # Bash replaces the text after the last "=" or ":" of the word only.
    local keep=""
    [[ "$cur" == *[=:]* ]] && keep="${cur%"${cur##*[=:]}"}"
    local tab=$'\t' v d longest=0
    for v in "${values[@]}"; do
        v="${v%%"$tab"*}"
        ((${#v} > longest)) && longest=${#v}
    done
    COMPREPLY=()
    if ((${#values[@]} == 1)); then
        v="${values[0]%%"$tab"*}"
        COMPREPLY=("${v#"$keep"}")
        return 0
    fi
    local cols="${COLUMNS:-80}" room
    for v in "${values[@]}"; do
        d=""
        [[ "$v" == *"$tab"* ]] && d="${v#*"$tab"}"
        v="${v%%"$tab"*}"
        v="${v#"$keep"}"
        room=$((cols - longest - 6))
        if [[ -n "$d" ]] && ((room > 8)); then
            ((${#d} > room)) && d="${d:0:room-1}…"
            printf -v v '%-*s  (%s)' "$((longest - ${#keep}))" "$v" "$d"
        fi
        COMPREPLY+=("$v")
    done
}

# -----------------------------------------------------------------------------
# Enable Completion
# -----------------------------------------------------------------------------

# Activate completion for gash, the names above that this shell defines
# (a shortcut only when it is an alias here) and path_add (directories).
__gash_enable_completion() {
    local n
    local -a names=(gash)
    for n in "${!__GASH_COMPLETE_WORDS[@]}"; do
        if declare -F "$n" >/dev/null 2>&1 || [[ -n "${BASH_ALIASES[$n]+x}" ]]; then
            names+=("$n")
        fi
    done
    complete -o default -F __gash_complete "${names[@]}"
    complete -d path_add
    names+=(path_add)
    # The names, for gash_unload to remove these specs (SELF-03).
    __GASH_COMPLETE_NAMES=("${names[@]}")
}

__gash_enable_completion
unset -f __gash_enable_completion

if [[ -n "${__gash_completion_t0-}" ]]; then
    __gash_time_record "bash_completion" "$__gash_completion_t0"
    unset __gash_completion_t0
fi
