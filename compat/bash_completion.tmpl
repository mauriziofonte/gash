# Bash completion for Gash functions

# Ensure that Gash functions are available by checking for one core Gash function.
if ! declare -F git_add_tag >/dev/null 2>&1; then
    return
fi

((${__GASH_TIMING:-0})) && __gash_completion_t0="$EPOCHREALTIME"

# -----------------------------------------------------------------------------
# Completion Function
# -----------------------------------------------------------------------------

# Completion handler for Gash functions.
# Dispatches to per-function completion based on COMP_WORDS[0].
__gash_complete() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local cmd="${COMP_WORDS[0]}"

    # A Gash alias (gsync, chri, flf...) completes like its function.
    local expansion
    if expansion="$(alias "$cmd" 2>/dev/null)"; then
        expansion="${expansion#*=\'}"
        cmd="${expansion%%[\' ]*}"
    fi

    case "$cmd" in
{{%- range .Completions %}}
{{% if .Comment %}}        # {{% .Comment %}}
{{% end %}}        {{% join .Names " | " %}})
{{% indent 12 .Body %}}
            ;;
{{% end %}}
        # The reference card topics, and the 3.x commands of the binary
        gash)
            if ((COMP_CWORD == 1)); then
                mapfile -t COMPREPLY < <(compgen -W "{{% join .Topics " " %}}" -- "$cur")
            else
                case "${COMP_WORDS[1]-}" in
                    init | update | version | hte)
                        local __gash_bin=""
                        if declare -F __gash_compat_ready >/dev/null && __gash_compat_ready; then
                            __gash_bin="$__GASH_BIN"
                        fi
                        if [[ -n "$__gash_bin" ]]; then
                            mapfile -t COMPREPLY < <("$__gash_bin" __complete "${COMP_WORDS[@]:1:COMP_CWORD}" 2>/dev/null | while IFS= read -r line; do
                                [[ "$line" == :* ]] && continue
                                printf '%s\n' "${line%%$'\t'*}"
                            done)
                        else
                            COMPREPLY=()
                        fi
                        ;;
                    *) COMPREPLY=() ;;
                esac
            fi
            ;;

        gash_help)
            if [[ "$cur" == -* ]]; then
                mapfile -t COMPREPLY < <(compgen -W "--list --search --short --bash --no-color" -- "$cur")
            elif [[ "${COMP_WORDS[1]-}" == "--search" ]] && ((COMP_CWORD == 2)); then
                # After --search, user types keyword freely
                COMPREPLY=()
            elif ((COMP_CWORD == 1)); then
                # Function names with registered help, and their aliases
                mapfile -t COMPREPLY < <(compgen -W "{{% join .HelpNames " " %}} --list --search --short --bash --no-color" -- "$cur")
            else
                COMPREPLY=()
            fi
            ;;

        # Everything else: empty COMPREPLY lets -o default provide file completion
        *)
            COMPREPLY=()
            ;;
    esac
}

# -----------------------------------------------------------------------------
# Enable Completion
# -----------------------------------------------------------------------------

# Activate completion for each public Gash function, and for the short
# aliases of the help registry that this shell defines (bash looks
# completion up by the word typed, so an alias needs its own registration).
__gash_enable_completion() {
    local a
    local -a names=(
{{%- range .CompleteFunctions %}}
        {{% . %}}
{{%- end %}}
    )
    for a in {{% join .CompleteAliases " " %}}; do
        [[ -n "${BASH_ALIASES[$a]+x}" ]] && names+=("$a")
    done
    complete -o default -F __gash_complete "${names[@]}"
    # The names, for gash_unload to remove these specs (SELF-03).
    __GASH_COMPLETE_NAMES=("${names[@]}")
}

__gash_enable_completion
unset -f __gash_enable_completion

if [[ -n "${__gash_completion_t0-}" ]]; then
    __gash_time_record "bash_completion" "$__gash_completion_t0"
    unset __gash_completion_t0
fi
