# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:179
# covers: output_style_render_spec.sh:180
#
# mkdir_cd rendering (R2-R6): it is a shell-side function (it must change
# the caller's directory), so create prints the new pwd and missing-arg
# prints the usage error.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :179 create - makes a/b and cds into it
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; mkdir_cd a/b && pwd'
stdout '/a/b$'

# --- :180 missing-arg
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; mkdir_cd'
stderr 'Error: Missing directory\. Usage: mkdir_cd <directory>'

# --- R6: plain mode error, no ESC
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; mkdir_cd'
stderr '^Error: Missing directory'
! stderr '\x1b'
