# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:291
# covers: output_style_render_spec.sh:292
# covers: output_style_render_spec.sh:293
# covers: output_style_render_spec.sh:294
# covers: output_style_render_spec.sh:295
# covers: output_style_render_spec.sh:296
#
# remote_hosts and remote_exec rendering (R2-R6). ssh is a PATH stub (no
# network). In headless mode remote_* accept only aliases registered in
# ~/.gash_env (HOST:alias=user@host), so the host is registered as "web".
# Covers: the host list, the empty hint, a successful exec (stub output),
# the unreachable (exit 255) error, an unknown alias, and the extra-args
# refusal.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :291 remote_hosts:list
exec bash -c 'printf "HOST:web=deploy@web.example.com\nHOST:db=admin@10.0.0.5\n" >.gash_env && chmod 600 .gash_env; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; remote_hosts'
stderr '• Configured remote hosts:'
stdout '^  web +deploy@web\.example\.com$'
stdout '^  db +admin@10\.0\.0\.5$'

# --- :292 remote_hosts:empty - a clean HOME so no hosts are configured
exec bash -c 'export HOME="$WORK/e"; mkdir -p "$HOME"; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; remote_hosts'
stderr '• No remote hosts configured in ~/\.gash_env'
stderr '• Add: HOST:alias=user@host'

# --- :293 remote_exec:ran - the ssh stub prints the remote output
exec bash -c 'printf "HOST:web=deploy@web.example.com\n" >.gash_env && chmod 600 .gash_env; mkdir -p bin && printf "#!/bin/sh\necho hello from the remote host\n" >bin/ssh && chmod +x bin/ssh && export PATH="$HOME/bin:$PATH" GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; remote_exec web uptime'
stdout '^hello from the remote host$'

# --- :294 remote_exec:unreachable - ssh exits 255
! exec bash -c 'printf "HOST:web=deploy@web.example.com\n" >.gash_env && chmod 600 .gash_env; mkdir -p bin && printf "#!/bin/sh\nexit 255\n" >bin/ssh && chmod +x bin/ssh && export PATH="$HOME/bin:$PATH" GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; remote_exec web uptime'
stderr 'Error: Failed to connect to deploy@web\.example\.com'

# --- :295 remote_exec:unknown_alias
! exec bash -c 'export HOME="$WORK/u"; mkdir -p "$HOME"; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; remote_exec nohost uptime'
stderr 'Error: Unknown host alias .nohost.'

# --- :296 remote_exec:extra_args - a command must be one quoted string
! exec bash -c 'printf "HOST:web=deploy@web.example.com\n" >.gash_env && chmod 600 .gash_env; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; remote_exec web ls -la'
stderr 'Pass the remote command as a SINGLE quoted string'

# --- R6: plain mode error, no ESC
! exec bash -c 'export HOME="$WORK/u2"; mkdir -p "$HOME"; export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; remote_exec nohost uptime'
stderr '^Error: Unknown host alias'
! stderr '\x1b'
