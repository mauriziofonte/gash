# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: output_style_render_spec.sh:243
# covers: output_style_render_spec.sh:244
# covers: output_style_render_spec.sh:245
# covers: output_style_render_spec.sh:246
# covers: output_style_render_spec.sh:247
# covers: output_style_render_spec.sh:248
# covers: output_style_render_spec.sh:249
# covers: output_style_render_spec.sh:250
#
# docker_compose_check rendering (R2-R6). The Go port queries the registry
# over net/http (SYS-36), so the 2.x curl mock is bypassed: httpsfake (the
# harness builds it on PATH, testing.md 2.4) is the local HTTPS CONNECT proxy
# that answers the manifest/token requests, reached via HTTPS_PROXY with its
# CA trusted through SSL_CERT_FILE. The MOCK_CURL_REGISTRY_* knobs the case
# exports are read by the fake from the gash process environment. Covers the
# update table, the per-registry error report, the timeout path, --no-color,
# --json, and the three offline failures (no file, no image services, a bad
# option). Each online case runs in its own subdirectory with its own proxy.

env GASH_HEADLESS=1
env HOME=$WORK
env LC_ALL=C.UTF-8

# --- :243 updates - mixed mutable/pinned images, newest available
exec bash -c 'mkdir -p c243; cd c243; printf "services:\n  web:\n    image: nginx:latest\n  db:\n    image: postgres:15.2.1\n  app:\n    image: ghcr.io/some-org/a-really-long-application-image-name:main\n  pinned:\n    image: redis@sha256:abc\n" >docker-compose.yml; httpsfake -ca ca -addr addr & pid=$!; for i in $(seq 1 100); do [ -s addr ] && break; sleep 0.05; done; read -r a <addr; export HTTPS_PROXY=http://$a SSL_CERT_FILE="$PWD/ca" GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; docker_compose_check; rc=$?; kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; exit $rc'
stdout 'Checking .*/docker-compose\.yml'
stdout '(?m)^web\s+nginx:latest\s+NOT_PULLED'
stdout '(?m)^pinned\s+redis@sha256:abc\s+PINNED'
stdout 'Summary: 3 update.s. 1 pinned'

# --- :244 errors - the registry rate-limits every lookup
exec bash -c 'mkdir -p c244; cd c244; printf "services:\n  web:\n    image: nginx:latest\n  app:\n    image: ghcr.io/org/app:main\n" >docker-compose.yml; httpsfake -ca ca -addr addr & pid=$!; for i in $(seq 1 100); do [ -s addr ] && break; sleep 0.05; done; read -r a <addr; export HTTPS_PROXY=http://$a SSL_CERT_FILE="$PWD/ca" MOCK_CURL_REGISTRY_RATE_LIMITED=1 GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; docker_compose_check; rc=$?; kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; exit $rc'
stdout '(?m)^web\s+nginx:latest\s+ERROR'
stdout 'Summary: 2 error.s.'
stdout 'Errors:'

# --- :245 timeout - the registry hangs; the per-image deadline fires (~20s)
exec bash -c 'mkdir -p c245; cd c245; printf "services:\n  web:\n    image: nginx:latest\n" >docker-compose.yml; httpsfake -ca ca -addr addr & pid=$!; for i in $(seq 1 100); do [ -s addr ] && break; sleep 0.05; done; read -r a <addr; export HTTPS_PROXY=http://$a SSL_CERT_FILE="$PWD/ca" MOCK_CURL_REGISTRY_TIMEOUT=1 GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; docker_compose_check; rc=$?; kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; exit $rc'
stdout 'Connection timed out'

# --- :246 no-color - the update table with no ESC bytes
exec bash -c 'mkdir -p c246; cd c246; printf "services:\n  web:\n    image: nginx:latest\n" >docker-compose.yml; httpsfake -ca ca -addr addr & pid=$!; for i in $(seq 1 100); do [ -s addr ] && break; sleep 0.05; done; read -r a <addr; export HTTPS_PROXY=http://$a SSL_CERT_FILE="$PWD/ca" GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; docker_compose_check --no-color; rc=$?; kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; exit $rc'
stdout '(?m)^web\s+nginx:latest\s+NOT_PULLED'
! stdout '\x1b'

# --- :247 json - machine layout with the remote digest
exec bash -c 'mkdir -p c247; cd c247; printf "services:\n  web:\n    image: nginx:latest\n" >docker-compose.yml; httpsfake -ca ca -addr addr & pid=$!; for i in $(seq 1 100); do [ -s addr ] && break; sleep 0.05; done; read -r a <addr; export HTTPS_PROXY=http://$a SSL_CERT_FILE="$PWD/ca" GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; docker_compose_check --json; rc=$?; kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; exit $rc'
stdout '"image":"nginx:latest"'
stdout '"status":"NOT_PULLED"'
! stdout '\x1b'

# --- :248 no-file (offline)
! exec bash -c 'mkdir -p c248; cd c248; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; docker_compose_check'
stderr 'Error: No docker-compose\.yml found'

# --- :249 no-services (offline)
! exec bash -c 'mkdir -p c249; cd c249; printf "services:\n  web:\n    build: .\n" >compose.yml; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; docker_compose_check'
stderr 'Error: No services with images found'

# --- :250 bad-option (offline)
! exec bash -c 'mkdir -p c250; cd c250; export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=100; source "$GASH_SH"; docker_compose_check --bogus'
stderr 'Error: Unknown option: --bogus'

# --- R6: plain mode error, no ESC
! exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=0 COLUMNS=100; source "$GASH_SH"; docker_compose_check --bogus'
stderr '^Error: Unknown option: --bogus'
! stderr '\x1b'
