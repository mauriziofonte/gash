# Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>
#
# covers: fs_render_spec.sh:8
# covers: fs_render_spec.sh:31
# covers: fs_render_spec.sh:49
# covers: fs_render_spec.sh:61
#
# Terminal layout of the filesystem scanners. In testscript stdout is a
# pipe, so a plain call gets the "SIZE  PATH  MTIME" table and tree_stats
# its plain report (fs_render_spec.sh:49). The rich layouts are forced with
# a TTY and color (GASH__TTY_OUT / GASH__COLOR) and matched against their
# titles, rank rows, share bars and footers; the non-deterministic scan
# time is matched by pattern. --no-color keeps the rich layout (FS-42) but
# drops the ANSI escapes, so the rows match as plain text.
#   fs_render_spec.sh:8  - files_largest rich: rank, share bars, footer.
#   fs_render_spec.sh:31 - dirs_largest / dirs_find_large share the layout.
#   fs_render_spec.sh:61 - tree_stats rich: grouped totals and share bars.

env GASH_HEADLESS=1
env LC_ALL=C

# --- fs_render_spec.sh:49 - piped output keeps the plain SIZE  PATH lines
mkdir pp
exec bash -c 'head -c 2048 /dev/zero > pp/x'
exec bash -c 'source "$GASH_SH"; files_largest pp'
stdout '2\.0 KiB +[^ ].*pp/x  [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$'
! stdout 'Largest files'
exec bash -c 'source "$GASH_SH"; tree_stats pp'
stdout '^Tree statistics for .*pp$'

# --- fs_render_spec.sh:8 - files_largest on a terminal ranks, draws bars, sums up
mkdir -p fl/a/b
exec bash -c 'head -c 4096 /dev/zero > fl/a/b/big.bin; head -c 1024 /dev/zero > fl/small.txt'
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=120; source "$GASH_SH"; files_largest fl --no-color'
stdout '^  Largest files in .*fl$'
stdout '^  #     SIZE  SHARE +MODIFIED +PATH$'
stdout '^  1  4\.0 KiB  #{16}  [0-9-]+ [0-9:]+  a/b/big\.bin$'
stdout '^  2  1\.0 KiB  #{4}\.{12}  [0-9-]+ [0-9:]+  small\.txt$'
stdout '^  2 files - 5\.0 KiB total - [0-9.]+m?s$'
# Nothing over the threshold: one quiet line, no table.
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=120; source "$GASH_SH"; files_largest --min-size 1G fl --no-color'
stdout 'No files matched\.'
! stdout 'SHARE'

# --- fs_render_spec.sh:31 - dirs_largest and dirs_find_large share the layout
mkdir -p dl/big dl/small
exec bash -c 'head -c 65536 /dev/zero > dl/big/f; head -c 1024 /dev/zero > dl/small/f'
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=120; source "$GASH_SH"; dirs_largest dl --no-color'
stdout '^  Largest directories in .*dl$'
stdout '^  #      SIZE  SHARE +PATH$'
stdout '^  1 +[0-9.]+ KiB  #{16}  big$'
stdout '^  2 directories - largest [0-9.]+ KiB - [0-9.]+m?s$'
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=120; source "$GASH_SH"; dirs_find_large --size 32K dl --no-color'
stdout '^  Directories over 32K in .*dl$'
stdout '^  #      SIZE  SHARE +PATH$'
stdout '^  1 +[0-9.]+ KiB  #{16}  big$'

# --- fs_render_spec.sh:61 - tree_stats on a terminal shows grouped totals and share bars
mkdir tr
exec bash -c 'head -c 3000000 /dev/zero > tr/a.bin; printf x > tr/b.txt; printf y > tr/c.txt'
exec bash -c 'export GASH__TTY_OUT=1 GASH__COLOR=1 COLUMNS=120; source "$GASH_SH"; tree_stats tr --no-color'
stdout '^  Files +3 +Total size +2\.8 MiB \(3,000,002 bytes\)$'
stdout '^  bin +2\.8 MiB  #{20}   99\.9%$'
stdout '^  txt +2  #{13}\.{7}   66\.6%$'
stdout 'Scanned in'
