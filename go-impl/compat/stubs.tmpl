{{%/* Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>

Stub overrides. A delegated function gets the one-line stub
`NAME() { __gash_call NAME "$@"; }` unless this file defines a template
named "stub/NAME": its text (the registry Function as data, leading and
trailing newlines trimmed) replaces the stub wherever the function is
defined (gash.sh, the module shims, the core shims). A shell-mutating
function (MATRIX class `shell-mutating`) uses one to keep its parent-shell
part (cd, history, eval of quoted exports) in Bash and call the binary
for the rest. The override of a function whose 2.x body loads the
settings file (registry LoadsEnv) starts with {{% loadenv %}} (LEDGER
CORE-18). Example:

{{% define "stub/NAME" %}}
NAME() {
    {{% if .LoadsEnv %}}{{% loadenv %}}{{% end %}}
    ...
    __gash_call {{% .Name %}} "$@"
}
{{% end %}}
*/%}}

{{%/* The system slice (internal/system). The hand-off protocol of
internal/system/handoff: the binary does what 2.x did before the shell
step and writes 1 on descriptor 3 when that step runs. */%}}

{{% define "sys/history-handoff" %}}
{{% .Name %}}() {
    local __gash_go="" __gash_rc=0
    {
        __gash_go="$(GASH__HANDOFF=3 __gash_call {{% .Name %}} "$@" 3>&1 1>&4 4>&-)" || __gash_rc=$?
    } 4>&1
    [[ "$__gash_go" == 1 ]] || return "$__gash_rc"
    history -a 2>/dev/null || true
    GASH__RESUME=1 __gash_call {{% .Name %}} "$@"
}
{{% end %}}

{{% define "stub/hgrep" %}}{{% template "sys/history-handoff" . %}}{{% end %}}
{{% define "stub/wsl_restart" %}}{{% template "sys/history-handoff" . %}}{{% end %}}
{{% define "stub/wsl_shutdown" %}}{{% template "sys/history-handoff" . %}}{{% end %}}

{{% define "stub/history_grep" %}}
history_grep() {
    case "${1-}" in
        -h | --help | "")
            __gash_call {{% .Name %}} "$@"
            return
            ;;
    esac
    history | __gash_call {{% .Name %}} "$@"
}
{{% end %}}

{{% define "stub/mkdir_cd" %}}
mkdir_cd() {
    case "${1-}" in
        -h | --help | "")
            __gash_call {{% .Name %}} "$@"
            return
            ;;
    esac
    local dir="${1-}"
    mkdir -p "$dir" && cd "$dir" || return 1
}
{{% end %}}

{{% define "stub/sudo_last" %}}
sudo_last() {
    case "${1-}" in
        -h | --help)
            __gash_call {{% .Name %}} "$@"
            return
            ;;
    esac
    if [[ -n "${1-}" ]]; then
        sudo "$@"
        return
    fi
    local last_cmd __gash_go="" __gash_rc=0
    last_cmd=$(fc -ln -1)
    last_cmd="${last_cmd#"${last_cmd%%[![:space:]]*}"}"
    {
        __gash_go="$(printf '%s' "$last_cmd" | GASH__HANDOFF=3 __gash_call {{% .Name %}} 3>&1 1>&4 4>&-)" || __gash_rc=$?
    } 4>&1
    [[ "$__gash_go" == 1 ]] || return "$__gash_rc"
    sudo bash -c "$last_cmd"
}
{{% end %}}

{{%/* The ssh slice (internal/ssh). The binary hands back quoted export
lines of SSH_AUTH_SOCK, SSH_AGENT_PID and GASH_SSH_AUTOUNLOCK_RAN, only
those names, values quoted with mvdan.cc/sh/v3/syntax (LEDGER SYS-39). */%}}

{{% define "stub/gash_ssh_auto_unlock" %}}
gash_ssh_auto_unlock() {
    case "${1-}" in
        -h | --help)
            __gash_call {{% .Name %}} "$@"
            return
            ;;
    esac
    [[ -z "${GASH_SSH_AUTOUNLOCK_RAN:-}" ]] || return 0
    {{% if .LoadsEnv %}}{{% loadenv %}}{{% end %}}
    local __gash_go="" __gash_rc=0
    {
        __gash_go="$(GASH__HANDOFF=3 __gash_call {{% .Name %}} "$@" 3>&1 1>&4 4>&-)" || __gash_rc=$?
    } 4>&1
    [[ -z "$__gash_go" ]] || eval "$__gash_go"
    return "$__gash_rc"
}
{{% end %}}

{{% define "stub/gash_help" %}}
gash_help() {
    # --bash TOPIC is Bash's builtin help, which only the shell has.
    local __gash_a
    local -a __gash_rest=()
    for __gash_a in "$@"; do
        [[ "$__gash_a" == --no-color ]] || __gash_rest+=("$__gash_a")
    done
    if [[ "${__gash_rest[0]-}" == --bash ]]; then
        builtin help "${__gash_rest[@]:1}"
        return
    fi
    __gash_call gash_help "$@"
}
{{% end %}}

{{% define "stub/gash" %}}
gash() {
    {{% if .LoadsEnv %}}{{% loadenv %}}{{% end %}}
    # The card shows the value this shell gives an alias of the card, as
    # 2.x read BASH_ALIASES: one NAME<TAB>VALUE line per defined alias,
    # backslash and newline escaped (LEDGER SELF-12).
    local __gash_n __gash_v __gash_bs='\' __gash_nl=$'\n' __gash_card=""
    for __gash_n in {{% cardAliasNames %}}; do
        [[ -n "${BASH_ALIASES[$__gash_n]+x}" ]] || continue
        __gash_v=${BASH_ALIASES[$__gash_n]//"$__gash_bs"/"$__gash_bs$__gash_bs"}
        __gash_card+=$__gash_n$'\t'${__gash_v//"$__gash_nl"/"${__gash_bs}n"}$__gash_nl
    done
    GASH__CARD_ALIASES="$__gash_card" __gash_call gash "$@"
}
{{% end %}}
