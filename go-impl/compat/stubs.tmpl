{{%/* Gash 3.0. Author: Maurizio Fonte <fonte.maurizio@gmail.com>

Stub overrides. A delegated function gets the one-line stub
`NAME() { __gash_call NAME "$@"; }` unless this file defines a template
named "stub/NAME": its text (the registry Function as data, leading and
trailing newlines trimmed) replaces the stub wherever the function is
defined (gash.sh, the module shims, the core shims). A shell-mutating
function (MATRIX class `shell-mutating`) uses one to keep its parent-shell
part (cd, history, eval of quoted exports) in Bash and call the binary
for the rest. The override of a function whose 2.x body loads the
settings file (registry LoadsEnv) starts with {{% loadenv %}} (LEDGER
CORE-18). Example:

{{% define "stub/NAME" %}}
NAME() {
    {{% if .LoadsEnv %}}{{% loadenv %}}{{% end %}}
    ...
    __gash_call {{% .Name %}} "$@"
}
{{% end %}}
*/%}}

{{% define "stub/gash_help" %}}
gash_help() {
    # --bash TOPIC is Bash's builtin help, which only the shell has.
    local __gash_a
    local -a __gash_rest=()
    for __gash_a in "$@"; do
        [[ "$__gash_a" == --no-color ]] || __gash_rest+=("$__gash_a")
    done
    if [[ "${__gash_rest[0]-}" == --bash ]]; then
        builtin help "${__gash_rest[@]:1}"
        return
    fi
    __gash_call gash_help "$@"
}
{{% end %}}

{{% define "stub/gash" %}}
gash() {
    {{% if .LoadsEnv %}}{{% loadenv %}}{{% end %}}
    # The card shows the value this shell gives an alias of the card, as
    # 2.x read BASH_ALIASES: one NAME<TAB>VALUE line per defined alias,
    # backslash and newline escaped (LEDGER SELF-12).
    local __gash_n __gash_v __gash_bs='\' __gash_nl=$'\n' __gash_card=""
    for __gash_n in {{% cardAliasNames %}}; do
        [[ -n "${BASH_ALIASES[$__gash_n]+x}" ]] || continue
        __gash_v=${BASH_ALIASES[$__gash_n]//"$__gash_bs"/"$__gash_bs$__gash_bs"}
        __gash_card+=$__gash_n$'\t'${__gash_v//"$__gash_nl"/"${__gash_bs}n"}$__gash_nl
    done
    GASH__CARD_ALIASES="$__gash_card" __gash_call gash "$@"
}
{{% end %}}

{{% define "stub/gash_doctor" %}}
gash_doctor() {
{{%- if .LoadsEnv %}}
    {{% loadenv %}}
{{%- end %}}
    # The doctor reports what this shell holds: the files that failed to
    # load (__GASH_LOAD_ERRORS, one per line) and the known settings set
    # here (NAME<TAB>VALUE lines), backslash and newline escaped.
    local __gash_n __gash_v __gash_bs='\' __gash_nl=$'\n' __gash_errs="" __gash_set=""
    for __gash_v in ${__GASH_LOAD_ERRORS[@]+"${__GASH_LOAD_ERRORS[@]}"}; do
        __gash_v=${__gash_v//"$__gash_bs"/"$__gash_bs$__gash_bs"}
        __gash_errs+=${__gash_v//"$__gash_nl"/"${__gash_bs}n"}$__gash_nl
    done
    for __gash_n in ${__GASH_SETTINGS_KNOWN-}; do
        [[ -n "${!__gash_n+x}" ]] || continue
        __gash_v=${!__gash_n}
        __gash_v=${__gash_v//"$__gash_bs"/"$__gash_bs$__gash_bs"}
        __gash_set+=$__gash_n$'\t'${__gash_v//"$__gash_nl"/"${__gash_bs}n"}$__gash_nl
    done
    GASH__LOAD_ERRORS="$__gash_errs" GASH__SETTINGS="$__gash_set" __gash_call gash_doctor "$@"
}
{{% end %}}
