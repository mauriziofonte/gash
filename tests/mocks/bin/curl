#!/usr/bin/env bash

# Mock curl for testing AI module and Docker registry API.
# Simulates Claude/Gemini API responses and Docker registry endpoints.
#
# Routes. MOCK_CURL_ROUTES=FILE (an absolute path) gives the answers a test
# wants, ahead of the canned ones below; in Go mode the HTTPS fake
# (go-impl/internal/tools/httpsfake) serves the same file. One route per
# line; the first route that matches the request answers it:
#
#   METHOD URL-PATTERN STATUS [BODY]
#     Header-Name: value
#   METHOD URL-PATTERN unreachable
#
# METHOD is GET, HEAD, POST, ... or * for any; a GET route answers HEAD
# too. URL-PATTERN is a Bash glob over the whole URL (* ? [...]; * matches
# / as well). STATUS is a three-digit HTTP status. BODY is the rest of the
# line, byte for byte, with no newline added; @PATH sends the bytes of the
# file PATH (relative to FILE's directory). The indented lines right under
# a route are its response headers; Content-Length is the body's unless a
# header sets it (a HEAD answer sends it without the body). "unreachable"
# is a host that does not resolve: here curl exits 6 ("Could not resolve
# host"); the fake refuses the CONNECT when the route covers every URL of
# the host (the binary then reports curl's exit 56, "CONNECT tunnel
# failed, response 502", as behind a real proxy) and otherwise drops the
# connection after the request (exit 52, "Empty reply from server").
# Blank lines and lines starting with # are skipped; a line that does not
# parse stops the mock (exit 2) and gets a 500 from the fake. A request no
# route matches gets the canned answers. Routes do not redirect.
#
# A routed answer follows curl: with -f a status of 400 or more is exit 22
# and no output (-I still prints the headers, and no -o file is created);
# the "curl: (N) MESSAGE" line goes to stderr unless -s is given without
# -S; -I prints the status line and the headers; -o FILE takes the output;
# -D FILE gets the headers; -w expands %{http_code} (000 when unreachable).
# Example: GET /f answers "hello"; any other request of example.test
# fails with 404, after a HEAD that reports 5 bytes; down.test does not
# resolve.
#
#   GET https://example.test/f 200 hello
#   HEAD https://example.test/* 200
#     Content-Length: 5
#   * https://example.test/* 404
#   * https://down.test/* unreachable

# Track calls for verification (optional)
if [[ -n "${MOCK_CURL_LOG:-}" ]]; then
	echo "curl $*" >>"$MOCK_CURL_LOG"
fi

# Parse arguments - look for URL and body in all arguments
url=""
http_code_output=""
output_file=""
header_file=""
extra_headers=""
request_body=""
is_head_request=0

# Store all args for scanning
all_args=("$@")

# Scan for specific args
i=0
while [[ $i -lt ${#all_args[@]} ]]; do
	arg="${all_args[$i]}"
	case "$arg" in
	-w)
		((i++))
		http_code_output="${all_args[$i]:-}"
		;;
	-o)
		((i++))
		output_file="${all_args[$i]:-}"
		;;
	-D | --dump-header)
		((i++))
		header_file="${all_args[$i]:-}"
		;;
	-d | --data | --data-binary)
		((i++))
		request_body="${all_args[$i]:-}"
		# @FILE: the body is read from that file (@- = stdin)
		if [[ "$request_body" == @- ]]; then
			request_body="$(cat)"
		elif [[ "$request_body" == @* ]]; then
			request_body="$(cat "${request_body#@}")"
		fi
		;;
	-I)
		is_head_request=1
		;;
	http*)
		url="$arg"
		;;
	esac
	((i++))
done

# Log the body too: real requests pass it as @FILE, never in argv.
if [[ -n "${MOCK_CURL_LOG:-}" && -n "$request_body" ]]; then
	printf 'body: %s\n' "$request_body" >>"$MOCK_CURL_LOG"
fi

# --- Routes (MOCK_CURL_ROUTES, documented at the top) ---

# route_parse ARGS...: the options of curl that a routed answer follows.
route_parse() {
	r_method="" r_head=0 r_fail=0 r_silent=0 r_show=0 r_data=0
	r_out="" r_url="" r_write="" r_dump=""
	local a opt rest val
	while (($#)); do
		a=$1
		shift
		case "$a" in
		--)
			(($#)) && r_url=$1
			break
			;;
		--fail) r_fail=1 ;;
		--silent) r_silent=1 ;;
		--show-error) r_show=1 ;;
		--head) r_head=1 ;;
		--output | --request | --write-out | --dump-header | --data | --data-binary | \
			--data-raw | --data-urlencode | --json | --config | --header | --max-time | \
			--connect-timeout | --user-agent | --retry | --user | --proxy | --cacert | --form)
			val=${1-}
			shift
			case "$a" in
			--output) r_out=$val ;;
			--request) r_method=$val ;;
			--write-out) r_write=$val ;;
			--dump-header) r_dump=$val ;;
			--data*) r_data=1 ;;
			--json) r_data=1 ;;
			esac
			;;
		--*) ;;
		-?*)
			rest=${a#-}
			while [[ -n "$rest" ]]; do
				opt=${rest:0:1}
				rest=${rest:1}
				case "$opt" in
				f) r_fail=1 ;;
				s) r_silent=1 ;;
				S) r_show=1 ;;
				I) r_head=1 ;;
				o | X | w | D | d | H | m | A | u | x | K | F | e | b | c | r | T | E | Y | y | z | C | Q)
					if [[ -n "$rest" ]]; then
						val=$rest
						rest=""
					else
						val=${1-}
						shift
					fi
					case "$opt" in
					o) r_out=$val ;;
					X) r_method=$val ;;
					w) r_write=$val ;;
					D) r_dump=$val ;;
					d) r_data=1 ;;
					esac
					;;
				esac
			done
			;;
		*) r_url=$a ;;
		esac
	done
	if [[ -z "$r_method" ]]; then
		if ((r_head)); then
			r_method=HEAD
		elif ((r_data)); then
			r_method=POST
		else
			r_method=GET
		fi
	fi
}

route_bad() {
	echo "mock curl: MOCK_CURL_ROUTES line $1: $2" >&2
	exit 2
}

# route_lookup METHOD URL: the first route of MOCK_CURL_ROUTES for the
# request (route_status, route_body, route_headers); 1 when none matches.
# Every line is checked, before and after the match.
route_lookup() {
	local line n=0 found=0 cur=0 m p s b
	local re='^([^[:blank:]]+)[[:blank:]]+([^[:blank:]]+)[[:blank:]]+([^[:blank:]]+)([[:blank:]]+(.*))?$'
	route_status="" route_body="" route_headers=() route_line=0
	[[ -r "$MOCK_CURL_ROUTES" ]] || return 1
	while IFS= read -r line || [[ -n "$line" ]]; do
		n=$((n + 1))
		line=${line%$'\r'}
		if [[ "$line" == [[:blank:]]* ]]; then
			((cur)) || continue
			line=${line#"${line%%[![:blank:]]*}"}
			[[ -n "$line" ]] || continue
			[[ "$line" == *:* ]] || route_bad "$n" "a header is Name: value"
			if ((cur == route_line)); then
				b=${line#*:}
				route_headers+=("${line%%:*}: ${b#"${b%%[![:blank:]]*}"}")
			fi
			continue
		fi
		cur=0
		[[ -z "$line" || "$line" == \#* ]] && continue
		[[ "$line" =~ $re ]] || route_bad "$n" "expected METHOD URL-PATTERN STATUS [BODY]"
		m=${BASH_REMATCH[1]} p=${BASH_REMATCH[2]} s=${BASH_REMATCH[3]} b=${BASH_REMATCH[5]}
		[[ "$s" == unreachable || "$s" =~ ^[1-9][0-9][0-9]$ ]] ||
			route_bad "$n" "STATUS is a three-digit code or unreachable"
		cur=$n
		((found)) && continue
		[[ "$m" == "*" || "$m" == "$1" || ("$m" == GET && "$1" == HEAD) ]] || continue
		# shellcheck disable=SC2053 # the pattern is a glob
		[[ "$2" == $p ]] || continue
		found=1 route_line=$n route_status=$s route_body=$b
	done <"$MOCK_CURL_ROUTES"
	((found))
}

route_reason() {
	case "$1" in
	200) echo " OK" ;;
	201) echo " Created" ;;
	204) echo " No Content" ;;
	206) echo " Partial Content" ;;
	301) echo " Moved Permanently" ;;
	302) echo " Found" ;;
	304) echo " Not Modified" ;;
	307) echo " Temporary Redirect" ;;
	308) echo " Permanent Redirect" ;;
	400) echo " Bad Request" ;;
	401) echo " Unauthorized" ;;
	403) echo " Forbidden" ;;
	404) echo " Not Found" ;;
	405) echo " Method Not Allowed" ;;
	408) echo " Request Timeout" ;;
	409) echo " Conflict" ;;
	410) echo " Gone" ;;
	429) echo " Too Many Requests" ;;
	500) echo " Internal Server Error" ;;
	501) echo " Not Implemented" ;;
	502) echo " Bad Gateway" ;;
	503) echo " Service Unavailable" ;;
	504) echo " Gateway Timeout" ;;
	esac
}

route_emit() {
	if [[ -n "$r_out" && "$r_out" != - ]]; then
		cat >"$r_out"
	else
		cat
	fi
}

route_write_out() {
	[[ -n "$r_write" ]] || return 0
	local w=${r_write//'%{http_code}'/$1}
	printf '%s' "${w//'\n'/$'\n'}"
}

route_error() {
	if ((! r_silent || r_show)); then
		echo "curl: ($1) $2" >&2
	fi
}

# route_serve: the routed answer, with curl's exit status.
route_serve() {
	local code=$route_status host file="" len hdr h name has_len=0
	host=${r_url#*://}
	host=${host%%[/?#]*}
	host=${host##*@}
	host=${host%%:*}
	if [[ "$code" == unreachable ]]; then
		route_write_out 000
		route_error 6 "Could not resolve host: $host"
		return 6
	fi
	if [[ "$route_body" == @* ]]; then
		file=${route_body#@}
		[[ "$file" == /* ]] || file="$(dirname "$MOCK_CURL_ROUTES")/$file"
		[[ -r "$file" ]] || route_bad "$route_line" "cannot read $file"
		len=$(wc -c <"$file")
	else
		len=$(printf '%s' "$route_body" | wc -c)
	fi
	len=${len//[[:space:]]/}
	hdr="HTTP/1.1 $code$(route_reason "$code")"$'\r\n'
	for h in "${route_headers[@]}"; do
		hdr+="$h"$'\r\n'
		name=${h%%:*}
		[[ "${name,,}" == content-length ]] && has_len=1
	done
	((has_len)) || hdr+="Content-Length: $len"$'\r\n'
	hdr+=$'\r\n'
	[[ -n "$r_dump" ]] && printf '%s' "$hdr" >"$r_dump"
	local failed=0
	((r_fail && code >= 400)) && failed=1
	if ((r_head)); then
		printf '%s' "$hdr" | route_emit
	elif ((! failed)); then
		if [[ -n "$file" ]]; then
			route_emit <"$file"
		else
			printf '%s' "$route_body" | route_emit
		fi
	fi
	route_write_out "$code"
	if ((failed)); then
		route_error 22 "The requested URL returned error: $code"
		return 22
	fi
	return 0
}

if [[ -n "${MOCK_CURL_ROUTES:-}" ]]; then
	[[ "$MOCK_CURL_ROUTES" == /* ]] || {
		echo "mock curl: MOCK_CURL_ROUTES must be an absolute path" >&2
		exit 2
	}
	route_parse "$@"
	if route_lookup "$r_method" "$r_url"; then
		route_serve
		exit $?
	fi
fi

# Determine response type based on query content in body
# Priority: troubleshoot > command > explanation > code > fallback
# Note: We extract only the user query (after Context JSON) to avoid matching system prompt text
detect_response_type() {
	local body="$1"

	local lower_body
	lower_body=$(echo "$body" | tr '[:upper:]' '[:lower:]')

	# Check for drilldown request (body contains "section:" and "initial findings")
	if [[ "$lower_body" == *"section:"* ]] && [[ "$lower_body" == *"initial findings"* ]]; then
		echo "drilldown"
		return
	fi

	# Check for freetext question (body contains "initial server analysis" and "user question")
	if [[ "$lower_body" == *"initial server analysis"* ]] && [[ "$lower_body" == *"user question"* ]]; then
		echo "drilldown"
		return
	fi

	# Check for sysinfo analysis request (body contains "analyze this system enumeration")
	if [[ "$lower_body" == *"analyze this system enumeration"* ]]; then
		echo "sysinfo"
		return
	fi

	# Extract user query: it comes after "}\\n\\n" (end of context JSON + double newline)
	# The pattern in the JSON is: "content": "Context: {...}\n\nUSER_QUERY"
	local user_query
	user_query=$(echo "$body" | sed -n 's/.*}\\n\\n\([^"]*\)".*/\1/p' | head -1)
	local lower_query
	lower_query=$(echo "$user_query" | tr '[:upper:]' '[:lower:]')

	# Only "[PIPE INPUT" triggers troubleshoot
	if [[ "$lower_query" == *"[pipe input"* ]]; then
		echo "troubleshoot"
	elif [[ "$lower_query" == *"how to"* ]] || [[ "$lower_query" == *"come faccio"* ]] || [[ "$lower_query" == *"how do i"* ]]; then
		echo "command"
	elif [[ "$lower_query" == *"what is"* ]] || [[ "$lower_query" == *"cos'è"* ]] || [[ "$lower_query" == *"explain"* ]] || [[ "$lower_query" == *"spiega"* ]]; then
		echo "explanation"
	elif [[ "$lower_query" == *"write a script"* ]] || [[ "$lower_query" == *"scrivi uno script"* ]] || [[ "$lower_query" == *"write code"* ]]; then
		echo "code"
	else
		echo "fallback"
	fi
}

# Generate inner JSON based on response type
generate_inner_json() {
	local resp_type="$1"
	case "$resp_type" in
	troubleshoot)
		echo '{"type":"troubleshoot","issue":"PHP Fatal error - undefined variable","suggestion":"Check variable initialization before use","text":"Analysis complete"}'
		;;
	command)
		echo '{"type":"command","command":"ls -lhS","text":"Lists files sorted by size in descending order."}'
		;;
	explanation)
		echo '{"type":"explanation","text":"This is a conceptual explanation of the topic."}'
		;;
	code)
		echo '{"type":"code","text":"Creates a backup script.","code":"#!/bin/bash\\ntar -czf backup.tar.gz ~/","lang":"bash"}'
		;;
	sysinfo)
		echo '{"hostname":"testhost","platform":"Debian 12 | 6.1.0-amd64 | bare-metal","sections":[{"title":"Services Detected","findings":[{"severity":"ok","text":"Apache2 running with 3 vhosts"},{"severity":"info","text":"PHP 8.1 FPM with 2 pools"}]},{"title":"Security Posture","findings":[{"severity":"warning","text":"No firewall detected"},{"severity":"info","text":"SSH key-only auth enabled"}]},{"title":"Recommendations","findings":[{"severity":"warning","text":"Install ufw or firewalld for perimeter protection"}]}]}'
		;;
	drilldown)
		echo '{"title":"Services Detected","summary":"Detailed analysis of detected services on this server.","components":[{"name":"Apache2","status":"running","config_highlights":["3 vhosts in sites-enabled","MPM: event","Listen: *:80, *:443"],"issues":[{"severity":"ok","text":"ProxyPassMatch configured for PHP-FPM"}]},{"name":"PHP-FPM 8.1","status":"running","config_highlights":["pool www: pm=dynamic, max_children=5","memory_limit=256M"],"issues":[{"severity":"warning","text":"max_children=5 is low for production"}]},{"name":"Viper-backup","status":"running","config_highlights":["Custom systemd service","ExecStart=/opt/viper/backup.sh","WorkingDirectory=/opt/viper"],"issues":[{"severity":"info","text":"Backup orchestration service running as root"}]}]}'
		;;
	fallback | *)
		echo '{"type":"fallback","text":"I am a bash/linux terminal assistant. How can I help?"}'
		;;
	esac
}

# Determine response based on URL
response=""
http_code="200"

# Check for simulated errors (global, applies to any URL)
if [[ -n "${MOCK_CURL_ERROR:-}" ]]; then
	http_code="${MOCK_CURL_ERROR_CODE:-500}"
	response='{"error":{"message":"Simulated error"}}'
elif [[ -n "${MOCK_CURL_TIMEOUT:-}" ]]; then
	# Simulate timeout - exit with curl timeout code
	exit 28

# --- Docker Registry Endpoints ---
elif [[ "$url" == *"auth.docker.io/token"* ]]; then
	# Docker Hub auth token endpoint
	if [[ "${MOCK_CURL_REGISTRY_AUTH_FAIL:-}" == "1" ]]; then
		http_code="500"
		response='{"error":"internal_error"}'
	elif [[ "${MOCK_CURL_REGISTRY_UNAUTHORIZED:-}" == "1" ]]; then
		http_code="401"
		response='{"errors":[{"code":"UNAUTHORIZED","message":"authentication required"}]}'
	else
		response='{"token":"mock-dockerhub-token-abc123","access_token":"mock-dockerhub-token-abc123"}'
		http_code="200"
	fi

elif [[ "$url" == *"ghcr.io/token"* ]]; then
	# GHCR auth token endpoint
	if [[ "${MOCK_CURL_REGISTRY_AUTH_FAIL:-}" == "1" ]]; then
		http_code="500"
		response='{"error":"internal_error"}'
	else
		response='{"token":"mock-ghcr-token-xyz789"}'
		http_code="200"
	fi

elif [[ "$url" == *"/v2/"*"/manifests/"* ]]; then
	# Registry manifest endpoint (Docker Hub, GHCR, or generic)
	if [[ "${MOCK_CURL_REGISTRY_TIMEOUT:-}" == "1" ]]; then
		exit 28
	elif [[ "${MOCK_CURL_REGISTRY_RATE_LIMITED:-}" == "1" ]]; then
		http_code="429"
		response='{"errors":[{"code":"TOOMANYREQUESTS","message":"rate limit exceeded"}]}'
	elif [[ "${MOCK_CURL_REGISTRY_NOT_FOUND:-}" == "1" ]]; then
		http_code="404"
		response='{"errors":[{"code":"MANIFEST_UNKNOWN","message":"manifest unknown"}]}'
	elif [[ "${MOCK_CURL_REGISTRY_UNAUTHORIZED:-}" == "1" ]]; then
		http_code="401"
		response='{"errors":[{"code":"UNAUTHORIZED","message":"authentication required"}]}'
	else
		# Success: return mock digest in headers (for HEAD requests) or body
		http_code="200"
		if [[ $is_head_request -eq 1 ]]; then
			response=$'HTTP/2 200\r\ncontent-type: application/vnd.docker.distribution.manifest.v2+json\r\ndocker-content-digest: sha256:newdigest456abc123def456abc123def456abc123def456abc123def456newdig\r\n'
		else
			response='{"schemaVersion":2,"mediaType":"application/vnd.docker.distribution.manifest.v2+json"}'
		fi
	fi

# --- AI API Endpoints ---
elif [[ "$url" == *"api.anthropic.com"* ]]; then
	# Claude API response with structured JSON output
	resp_type=$(detect_response_type "$request_body")
	inner_json=$(generate_inner_json "$resp_type")
	# Escape inner JSON for embedding
	escaped_inner=$(echo "$inner_json" | sed 's/"/\\"/g')
	response='{"content":[{"type":"text","text":"'"$escaped_inner"'"}],"model":"claude-haiku-4-5","stop_reason":"end_turn"}'
elif [[ "$url" == *"generativelanguage.googleapis.com"* ]]; then
	# Gemini API response with structured JSON output
	resp_type=$(detect_response_type "$request_body")
	inner_json=$(generate_inner_json "$resp_type")
	# Escape inner JSON for embedding
	escaped_inner=$(echo "$inner_json" | sed 's/"/\\"/g')
	response='{"candidates":[{"content":{"parts":[{"text":"'"$escaped_inner"'"}]}}]}'
else
	# Unknown URL - still return something for debugging
	http_code="404"
	response='{"error":"Unknown endpoint","url":"'"$url"'"}'
fi

# AI knobs: MOCK_CURL_AI_RESPONSE replaces the API reply verbatim;
# MOCK_CURL_AI_BUSY_ONCE=CODE fails the first call (per MOCK_CURL_STATE
# file) with that code and "retry-after: 1".
if [[ "$url" == *"api.anthropic.com"* || "$url" == *"generativelanguage.googleapis.com"* ]]; then
	[[ -n "${MOCK_CURL_AI_RESPONSE:-}" ]] && response="$MOCK_CURL_AI_RESPONSE"
	if [[ -n "${MOCK_CURL_AI_BUSY_ONCE:-}" && ! -e "${MOCK_CURL_STATE:?MOCK_CURL_STATE required}" ]]; then
		: >"$MOCK_CURL_STATE"
		http_code="$MOCK_CURL_AI_BUSY_ONCE"
		response='{"type":"error","error":{"type":"overloaded_error","message":"Overloaded"}}'
		extra_headers=$'retry-after: 1\r\n'
	fi
fi

if [[ -n "$header_file" ]]; then
	printf 'HTTP/2 %s\r\ncontent-type: application/json\r\n%s\r\n' "$http_code" "$extra_headers" >"$header_file"
fi

# Write response to output file if specified
if [[ -n "$output_file" ]]; then
	echo "$response" >"$output_file"
fi

# Output HTTP code if requested
if [[ "$http_code_output" == "%{http_code}" ]]; then
	echo "$http_code"
fi

# If no output file and no http_code_output, print response to stdout
if [[ -z "$output_file" && -z "$http_code_output" ]]; then
	echo "$response"
fi

exit 0
