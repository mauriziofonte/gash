#!/usr/bin/env bash

# Minimal ssh-keygen mock: `ssh-keygen -lf FILE` prints a fingerprint
# derived from the file name (SHA256:fp-NAME, without a .pub suffix).

if [[ "${1-}" == "-lf" && -n "${2-}" ]]; then
	name="${2##*/}"
	name="${name%.pub}"
	echo "256 SHA256:fp-$name user@host (ED25519)"
	exit 0
fi
exit 1
